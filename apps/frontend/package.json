{
  "name": "@ncmedia/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "NCMedia Management Platform — Frontend (Next.js 15, App Router, Multi-Tenant UI)",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test:pagination": "node --experimental-strip-types scripts/verify-pagination.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:issues": "node --experimental-strip-types scripts/verify-issue-grouping.ts",
    "test:selection": "node --experimental-strip-types scripts/verify-selection.ts",
    "test:editor": "node --experimental-strip-types scripts/verify-description-editor.ts",
    "test:images": "node --experimental-strip-types scripts/verify-product-images.ts",
    "test:manual-sku": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/verify-manual-sku.ts",
    "test:template-apply": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/verify-template-apply.ts",
    "test:bulk-sku": "node --experimental-strip-types scripts/verify-bulk-sku.ts",
    "test:edit-product": "node --experimental-strip-types scripts/verify-edit-product.ts",
    "test:rich-text": "node --experimental-strip-types scripts/verify-rich-text-format.ts",
    "test:custom-listing": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/verify-custom-listing.ts",
    "test:sku-sync": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/verify-sku-sync.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.11",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
