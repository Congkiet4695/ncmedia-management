# ============================================================================
# NCMedia Management Platform — Frontend Environment (example)
# Sao chép thành `.env.local` và điền giá trị thật. KHÔNG commit file .env.local.
# Chỉ biến có tiền tố NEXT_PUBLIC_ mới được expose ra client bundle.
# ============================================================================

# Base URL của Backend API (CLAUDE.md Mục 12: /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Tên hiển thị ứng dụng
NEXT_PUBLIC_APP_NAME=NCMedia Management Platform
