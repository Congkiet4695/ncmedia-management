# ============================================================================
# NCMedia Management Platform — Frontend Environment (example)
# Sao chép thành `.env.local` và điền giá trị thật. KHÔNG commit file .env.local.
# Chỉ biến có tiền tố NEXT_PUBLIC_ mới được expose ra client bundle.
# ============================================================================

# Base URL của Backend API (CLAUDE.md Mục 12: /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Tên hiển thị ứng dụng
NEXT_PUBLIC_APP_NAME=NCMedia Management Platform

# Ngân sách thời gian MỘT lần upload (ms). Phải khớp UPLOAD_TIMEOUT_MS của backend và
# proxy_read_timeout của Nginx (deploy/nginx.conf, khối /api/).
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=180000
# Thời gian chờ tối đa của "Sync Products" / "Sync Shops" (ms) — phải > TIKTOK_PRODUCT_SYNC_REQUEST_DEADLINE_MS
# của backend (180s) và < proxy_read_timeout của Nginx (300s).
NEXT_PUBLIC_PRODUCT_SYNC_TIMEOUT_MS=290000
