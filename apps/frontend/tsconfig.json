{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `scripts/verify-pagination.ts` chạy bằng `node --experimental-strip-types` nên nó import
  // kèm đuôi `.ts` — hợp lệ với Node nhưng `tsc` của app từ chối. File này không nằm trong
  // bundle, nên loại khỏi phạm vi typecheck thay vì nới `allowImportingTsExtensions` cho cả dự án.
  "exclude": [
    "node_modules",
    "scripts/verify-pagination.ts",
    "scripts/verify-issue-grouping.ts",
    "scripts/verify-selection.ts"
  ]
}
