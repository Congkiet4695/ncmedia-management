# ============================================================================
# Registry cho project — CỐ Ý ghi đè ~/.npmrc (Nexus group-npm).
#
# Lý do: toàn bộ dependency của app này là PUBLIC npm (đã audit: 0 package
# private, 0 scope nội bộ). Dependency duy nhất không đến từ registry là
# `@tiktok-shop/nodejs-sdk` → `file:vendor/tiktok-shop-sdk`, không đi qua
# registry nào cả.
#
# Không ghi đè ở đây thì `npm install` sẽ nhúng lại URL Nexus vào trường
# `resolved` của package-lock.json, và `npm ci` trong Docker (không có .npmrc,
# không có cache) buộc phải gọi Nexus — hạ tầng mà image build không nên phụ
# thuộc vào.
#
# Muốn quay lại Nexus: xoá file này VÀ chạy lại `npm install` để sinh lock mới.
# ============================================================================
registry=https://registry.npmjs.org/
