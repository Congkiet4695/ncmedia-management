// ============================================================================
// NCMedia Management Platform — Prisma Schema
// Module: Authentication & RBAC Foundation (Sprint 1)
// Source of Truth: docs/auth.md (v2.0), docs/database.md, architecture/ADR.md
//
// Ràng buộc kiến trúc:
//   - UUID Primary Key, không auto-increment            (ADR-005)
//   - Soft delete + cột audit trên bảng nghiệp vụ       (ADR-015, CLAUDE.md Mục 11)
//   - Multi-tenant: bảng nghiệp vụ có organization_id   (ADR-003/004)
//   - Permission là bảng Global (không organization_id) (ADR-003/011, Decision-008)
//   - Một User có đúng 1 Role (users.role_id)           (Decision-007)
//   - email UNIQUE GLOBAL vĩnh viễn, không partial      (Decision-001 + bổ sung PO)
//   - Refresh Token: DB là Source of Truth, Redis chỉ Cache; hash HMAC-SHA256 (ADR-006 rev 2026-07-14)
//
// Lưu ý: KHÔNG sinh migration ở bước này. Regex slug (^[a-z0-9-]+$) và các CHECK
// constraint sẽ được thêm ở bước migration (Prisma schema không biểu diễn regex).
// Thay đổi vòng này: xem DATABASE_CHANGELOG.md.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext] // so sánh email không phân biệt hoa/thường
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Trạng thái User (bổ sung PO #4)
enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  /// Chủ Organization vừa đăng ký, Organization còn chờ Super Admin duyệt.
  ///
  /// 🔴 Tách khỏi INACTIVE: INACTIVE là "đã từng dùng rồi bị tắt", PENDING là "chưa bao giờ
  /// được phép vào". Gộp hai thứ lại thì màn quản trị không phân biệt được tài khoản mới
  /// đăng ký với tài khoản bị vô hiệu hoá.
  PENDING

  @@map("user_status")
}

/// Trạng thái Organization (bổ sung PO #5; PENDING/REJECTED thuộc luồng duyệt đăng ký).
///
/// 🔴 CHỈ `ACTIVE` được phép đăng nhập. Mọi trạng thái khác đều chặn ở `LoginService`.
enum OrganizationStatus {
  /// Vừa đăng ký, đang chờ Super Admin xét duyệt. KHÔNG login được.
  PENDING
  ACTIVE
  TRIAL
  SUSPENDED
  /// Super Admin đã từ chối — lý do nằm ở `rejected_reason`. KHÔNG login được.
  REJECTED
  DELETED

  @@map("organization_status")
}

/// Trạng thái nhân sự của Employee (sheet "Nhân viên"). Tách khỏi UserStatus (auth) —
/// RESIGNED là trạng thái nghiệp vụ; login vẫn theo User.status (đồng bộ ở tầng service).
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  SUSPENDED

  @@map("employee_status")
}

/// Trạng thái vòng đời Account bán hàng trên sàn (docs/account.md D-02).
enum AccountStatus {
  NEW
  LIVE
  DIE_TRANG
  DIE
  RETURNED

  @@map("account_status")
}

/// Trạng thái đơn hàng — nhãn hiển thị lấy từ sheet "Đơn hàng" (docs/business/NcMedia.xlsx, order.jpg).
/// WAITING=waiting · URGENT=Ưu tiên làm gấp · TRACK_AVAILABLE=Có track · PED=ped · REDO=Đã Làm Lại
/// TRACK_PENDING=Chờ track · TAX=thuế · TRACK_IMPORTED=đã nhập track · REFUND=refund · CANCELLED=cancel
enum OrderStatus {
  WAITING
  URGENT
  TRACK_AVAILABLE
  PED
  REDO
  TRACK_PENDING
  TAX
  TRACK_IMPORTED
  REFUND
  CANCELLED
  // Fulfillment workflow (bổ sung — additive, không phá enum cũ)
  IN_PROGRESS
  HAS_TRACKING
  SHIPPED
  COMPLETED

  @@map("order_status")
}

// ---------------------------------------------------------------------------
// POD TikTok Shop — enum (docs/pod-tiktok/03-database-design-erd.md)
// ---------------------------------------------------------------------------

/// Trạng thái kết nối (authorization) tới TikTok Shop Seller.
/// PENDING: vừa tạo, chưa lấy được shop · ACTIVE: hoạt động
/// REAUTH_REQUIRED: refresh token hết hạn/sắp hết → seller phải uỷ quyền lại
/// DEAUTHORIZED: seller thu hồi quyền (webhook SELLER_DEAUTHORIZATION — Sprint sau)
/// DISCONNECTED: Admin chủ động ngắt · ERROR: refresh lỗi liên tiếp
enum PodTiktokAccountStatus {
  PENDING
  ACTIVE
  REAUTH_REQUIRED
  DEAUTHORIZED
  DISCONNECTED
  ERROR

  @@map("pod_tiktok_account_status")
}

/// Vòng đời của một `state` trong luồng uỷ quyền OAuth TikTok.
/// PENDING: vừa sinh, chờ callback · USED: đã tiêu thụ (một lần duy nhất)
/// EXPIRED: quá hạn trước khi callback về · FAILED: đã tiêu thụ nhưng luồng lỗi
enum PodTiktokOAuthStateStatus {
  PENDING
  USED
  EXPIRED
  FAILED

  @@map("pod_tiktok_oauth_state_status")
}

/// Hành động trên token — phục vụ audit bảo mật. KHÔNG lưu giá trị token.
enum PodTiktokTokenAction {
  ISSUE
  REFRESH
  REAUTHORIZE
  REVOKE_LOCAL

  @@map("pod_tiktok_token_action")
}

/// Vị trí in design trên sản phẩm POD.
///
/// Khai báo SẴN đủ 5 vị trí ngay từ đầu để mở rộng về sau KHÔNG cần migration:
/// muốn dùng thêm LEFT/RIGHT/SLEEVE chỉ việc bật ở cấu hình/UI.
enum PodDesignPlacement {
  FRONT
  BACK
  LEFT
  RIGHT
  SLEEVE
  LABEL

  @@map("pod_design_placement")
}

/// Nguồn kích hoạt một lượt đồng bộ đơn.
enum PodSyncTrigger {
  CRON
  MANUAL
  BACKFILL

  @@map("pod_sync_trigger")
}

/// Trạng thái chi trả (payout) — GIỮ NGUYÊN giá trị TikTok trả về.
/// Nguồn: Get Payments / Get Statements (`status` / `payment_status`).
/// 🔴 TikTok CHỈ trả 3 giá trị này — KHÔNG có `CANCELLED`. Không tự chế thêm giá trị.
enum PodPayoutStatus {
  /// Đang xử lý, tiền chưa về tài khoản ngân hàng.
  PROCESSING
  /// Đã chuyển tiền cho seller.
  PAID
  /// Chuyển tiền thất bại.
  FAILED

  @@map("pod_payout_status")
}

/// Loại dòng giao dịch trong một statement (Get Transactions by Statement).
/// ORDER      — giao dịch của một đơn đã settle (có `order_id`).
/// ADJUSTMENT — điều chỉnh (có `adjustment_id`, có thể kèm `adjustment_order_id`).
/// RESERVE    — tiền giữ lại/giải phóng (có `reserve_id` + `associated_order_id`).
/// OTHER      — giá trị lạ TikTok bổ sung sau này (không làm vỡ sync — xem R3.6).
enum PodStatementTxType {
  ORDER
  ADJUSTMENT
  RESERVE
  OTHER

  @@map("pod_statement_tx_type")
}

/// Pha đồng bộ — quyết định quét theo trục thời gian nào.
/// BACKFILL: kéo LỊCH SỬ theo `create_time` (bất biến ⇒ phân trang là snapshot ổn định).
/// INCREMENTAL: đồng bộ định kỳ theo `update_time` (bắt được thay đổi của đơn cũ).
enum PodSyncPhase {
  BACKFILL
  INCREMENTAL

  @@map("pod_sync_phase")
}

/// Kết quả một lượt đồng bộ.
/// PARTIAL: chạy được nhưng chưa hết (chạm giới hạn trang/deadline) → watermark KHÔNG tiến.
/// SKIPPED: bỏ qua do lock hoặc account đang tạm ngưng (circuit breaker).
enum PodSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED

  @@map("pod_sync_status")
}

/// Loại Note của Order (OrderNote — 1 Order có nhiều Note).
enum OrderNoteType {
  SELLER
  WAREHOUSE

  @@map("order_note_type")
}

/// Trạng thái fulfillment theo TỪNG OrderItem.
enum OrderItemStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_item_status")
}

// ---------------------------------------------------------------------------
// Organization — Tenant root
// ---------------------------------------------------------------------------

model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String             @db.VarChar(255)
  /// slug phải khớp regex ^[a-z0-9-]+$ (enforce ở validation + CHECK constraint khi migrate)
  slug   String             @unique @db.VarChar(120)
  status OrganizationStatus @default(ACTIVE)

  /// 🔴 Organization HỆ THỐNG chứa tài khoản Super Admin — KHÔNG phải một tenant nghiệp vụ.
  ///
  /// Đây là cách Super Admin (actor xuyên tenant) sống được mà không phá ADR-008 "một User
  /// thuộc đúng một Organization": Super Admin vẫn là một User bình thường, chỉ thuộc về
  /// Organization này. Nhờ vậy toàn bộ Authentication/JWT/RBAC dùng lại nguyên vẹn, không
  /// sinh ra luồng đăng nhập thứ hai.
  ///
  /// Organization platform bị loại khỏi mọi danh sách tenant (màn duyệt đăng ký, thống kê)
  /// và KHÔNG bao giờ đi qua luồng duyệt.
  isPlatform Boolean @default(false) @map("is_platform")

  // --- Luồng duyệt đăng ký (Super Admin Review) ---
  /// User (Super Admin) đã duyệt. Không đặt khoá ngoại: Super Admin nằm ở Organization khác,
  /// và một bản ghi lịch sử không được phép chặn việc xoá tài khoản người duyệt.
  approvedBy     String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedBy     String?   @map("rejected_by") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at") @db.Timestamptz(6)
  /// Lý do từ chối — BẮT BUỘC khi Reject, và là nội dung email gửi cho người đăng ký.
  rejectedReason String?   @map("rejected_reason") @db.VarChar(1000)

  // Audit (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Quan hệ
  users                      User[]
  roles                      Role[]
  employees                  Employee[]
  accounts                   Account[]
  orders                     Order[]
  podTiktokAccounts          PodTiktokAccount[]
  storageFiles               StorageFile[]
  fulfillmentAccounts        FulfillmentAccount[]
  fulfillmentProductMappings FulfillmentProductMapping[]
  fulfillmentOrders          FulfillmentOrder[]
  approvalLogs               OrganizationApprovalLog[]

  /// Màn Super Admin lọc theo trạng thái + sắp theo thời điểm đăng ký.
  @@index([status, createdAt])
  @@map("organizations")
}

// ---------------------------------------------------------------------------
// OrganizationApprovalLog — nhật ký duyệt/từ chối đăng ký Organization.
//
// 🔴 Bảng PHẠM VI NỀN TẢNG, không phải bảng nghiệp vụ của tenant: `organization_id` ở đây là
// ĐỐI TƯỢNG được duyệt, không phải khoá phân tách tenant. Vì thế nó không vi phạm ADR-004 —
// chỉ Super Admin đọc bảng này, và không repository tenant nào chạm tới.
//
// Ghi APPEND-ONLY: không sửa, không xoá. Một quyết định duyệt/từ chối là sự kiện đã xảy ra;
// cột `old_status` giữ nguyên trạng thái trước đó nên đọc lại được toàn bộ đường đi.
// ---------------------------------------------------------------------------

model OrganizationApprovalLog {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Super Admin thực hiện. Giữ kèm email + tên tại thời điểm thao tác: người duyệt có thể
  /// đổi tên hoặc rời hệ thống, còn nhật ký thì phải đọc được mãi mãi.
  operatorId       String @map("operator_id") @db.Uuid
  operatorEmail    String @map("operator_email") @db.VarChar(255)
  operatorFullName String @map("operator_full_name") @db.VarChar(255)

  action    OrganizationApprovalAction
  oldStatus OrganizationStatus         @map("old_status")
  newStatus OrganizationStatus         @map("new_status")
  /// Bắt buộc với REJECT, để trống với APPROVE.
  reason    String?                    @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([operatorId, createdAt])
  @@map("organization_approval_logs")
}

/// Hành động của Super Admin trên một Organization đang chờ duyệt.
enum OrganizationApprovalAction {
  APPROVE
  REJECT

  @@map("organization_approval_action")
}

// ---------------------------------------------------------------------------
// User — Tài khoản đăng nhập (tách khỏi Employee — ADR-007)
// ---------------------------------------------------------------------------

model User {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Một User có đúng 1 Role (Decision-007)
  roleId         String @map("role_id") @db.Uuid

  /// UNIQUE GLOBAL vĩnh viễn — không partial index, không tái dùng sau soft delete (Decision-001)
  email        String  @unique @db.Citext
  passwordHash String  @map("password_hash") @db.VarChar(255)
  fullName     String  @map("full_name") @db.VarChar(255)
  /// Số điện thoại liên hệ, nhập tuỳ chọn lúc đăng ký Organization.
  /// Super Admin dùng để xác minh trước khi duyệt; KHÔNG dùng cho đăng nhập.
  phone        String? @db.VarChar(20)

  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)

  // Audit (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Quan hệ
  organization                Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role                        Role               @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens               RefreshToken[]
  // User ↔ Employee: quan hệ 1-1 (ADR-007). Account đăng nhập tách khỏi hồ sơ nghiệp vụ.
  employee                    Employee?
  // Account (ShopAccount) do User này quản lý với vai trò Seller (docs/account.md D-05).
  sellerAccounts              Account[]          @relation("AccountSeller")
  // Order mà User này (role FULFILLMENT/ADMIN) đã "Nhận xử lý" (claim).
  fulfilledOrders             Order[]            @relation("OrderFulfiller")
  // Kết nối TikTok Shop do User này thực hiện uỷ quyền (POD module).
  podTiktokAccountsAuthorized PodTiktokAccount[] @relation("PodTiktokAuthorizer")
  // File do User này upload (Storage Module dùng chung toàn hệ thống).
  storageFilesUploaded        StorageFile[]      @relation("StorageUploader")

  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Employee — Hồ sơ nghiệp vụ của nhân viên (ADR-007)
// Tách khỏi User: User giữ auth (email/password/status/role); Employee giữ business info.
// fullName/email/status/role KHÔNG lặp lại ở đây — lấy từ User (nguồn duy nhất).
// ---------------------------------------------------------------------------

model Employee {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// 1-1 với User (mỗi Employee gắn đúng 1 tài khoản đăng nhập).
  userId         String @unique @map("user_id") @db.Uuid

  /// Trạng thái nhân sự (sheet). Mặc định ACTIVE. Đồng bộ User.status cho login ở service.
  status EmployeeStatus @default(ACTIVE)

  /// Tài khoản Lark nội bộ (nullable).
  larkAccount String?   @map("lark_account") @db.VarChar(255)
  /// Ngày bắt đầu làm việc (nullable).
  startDate   DateTime? @map("start_date") @db.Date
  /// Ngày nghỉ việc (nullable).
  resignedAt  DateTime? @map("resigned_at") @db.Date

  /// CCCD (nullable, UNIQUE — cho phép nhiều NULL). Xem migration.
  cccd         String?   @unique @db.VarChar(20)
  /// URL ảnh CCCD (nullable).
  cccdImageUrl String?   @map("cccd_image_url") @db.VarChar(1024)
  /// Số điện thoại (nullable).
  phone        String?   @db.VarChar(20)
  /// Ngày sinh (nullable).
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  /// Địa chỉ (nullable).
  address      String?   @db.VarChar(500)
  /// Phòng làm việc (nullable).
  department   String?   @db.VarChar(255)

  /// Tài khoản ngân hàng (nullable).
  bankAccount String? @map("bank_account") @db.VarChar(100)
  /// URL QR ngân hàng (nullable).
  bankQrUrl   String? @map("bank_qr_url") @db.VarChar(1024)

  /// Lương (VND). Mặc định 0, không âm (CHECK ở migration). Decimal để chính xác tiền tệ.
  salary     Decimal @default(0) @db.Decimal(15, 2)
  /// KPI số Đơn hàng (mục tiêu/tháng). Mặc định 0. Dùng cho Báo cáo hiệu suất Seller (forecast).
  orderKpi   Int     @default(0) @map("order_kpi")
  /// KPI Doanh thu (USD, mục tiêu/tháng). Mặc định 0. Decimal cho chính xác tiền tệ.
  revenueKpi Decimal @default(0) @map("revenue_kpi") @db.Decimal(15, 2)
  /// URL avatar (nullable).
  avatar     String? @db.VarChar(1024)

  // Audit (ADR-015) + soft delete
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Quan hệ
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Các kết nối TikTok Shop do nhân viên này phụ trách với vai trò Seller.
  /// Một Employee quản lý được NHIỀU TikTok Account (1-n).
  podTiktokAccounts PodTiktokAccount[] @relation("PodTiktokSeller")

  @@index([organizationId])
  @@index([status])
  @@index([department])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// RefreshToken — Phiên refresh (rotation, reuse detection, audit security)
// Chỉ lưu HASH của token, không bao giờ lưu plain text.
// ---------------------------------------------------------------------------

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Hash HMAC-SHA256 của refresh token. KHÔNG lưu plain text.
  /// HMAC-SHA256 hex = 64 ký tự; VarChar(255) dư sức chứa và tương thích khi đổi thuật toán.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Thời điểm thu hồi (logout / rotation / reuse-detection). NULL = còn hiệu lực.
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Trỏ tới token thay thế khi rotation (phục vụ reuse detection & truy vết chuỗi).
  replacedById String?   @map("replaced_by_id") @db.Uuid

  /// Metadata bảo mật (audit) — có thể không xác định được.
  ipAddress String? @map("ip_address") @db.VarChar(45) // hỗ trợ IPv6
  /// Lưu raw User-Agent, giới hạn 512 ký tự (hợp lý). Việc parse (browser/OS/device)
  /// để xử lý ở tầng ứng dụng/sprint sau — không tách cột ở đây.
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Quan hệ
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replacedBy RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replaces   RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([expiresAt])
  @@index([replacedById])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Role — Dynamic role theo Organization (ADR-009)
// ---------------------------------------------------------------------------

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  code           String  @db.VarChar(50)
  /// Tên hiển thị (bổ sung PO #6)
  displayName    String  @map("display_name") @db.VarChar(100)
  /// Mô tả Role (bổ sung PO #3)
  description    String? @db.VarChar(255)
  /// Role hệ thống (admin/employee/fulfillment) — không được xóa
  isSystem       Boolean @default(false) @map("is_system")

  // Audit (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Quan hệ
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  // UNIQUE (organization_id, code) đã tạo index có tiền tố organization_id → không cần @@index riêng.
  @@unique([organizationId, code])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// Permission — Global catalog (không organization_id — Decision-008, ADR-003/011)
// ---------------------------------------------------------------------------

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  /// Dạng resource.action, VD: "role.read" (ADR-010)
  code        String  @unique @db.VarChar(100)
  /// Nhóm module (bổ sung PO #4): AUTH, EMPLOYEE, ORDER, REPORT, SHOP, PLATFORM...
  /// Lưu tường minh, KHÔNG parse từ resource.
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  // Catalog hệ thống — chỉ giữ timestamp, không soft delete / không organization_id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Quan hệ
  rolePermissions RolePermission[]

  @@index([module])
  @@index([resource])
  @@map("permissions")
}

// ---------------------------------------------------------------------------
// RolePermission — Gán Permission cho Role
// Permission CHỈ gán cho Role, không bao giờ gán trực tiếp User (BR-15, bổ sung PO #2)
// organization_id ĐÃ BỎ: Role đã thuộc Organization → tránh dư thừa tenant (bổ sung PO #5)
// ---------------------------------------------------------------------------

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Audit (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Quan hệ
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // UNIQUE (role_id, permission_id) đã tạo index có tiền tố role_id → chỉ cần index riêng cho permission_id.
  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Platform — Danh mục nền tảng bán hàng (Global — ADR-011). KHÔNG organization_id.
// ---------------------------------------------------------------------------

model Platform {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  podListingSessions PodListingSession[]

  @@map("platforms")
}

// ---------------------------------------------------------------------------
// Account — Tài khoản bán hàng trên sàn (ShopAccount — ADR-011, tenant-scoped).
// docs/account.md. Metric (đơn/doanh thu/balance) DERIVED từ Order — hoãn (D-08).
// ---------------------------------------------------------------------------

model Account {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  name         String  @db.VarChar(255)
  platformId   String? @map("platform_id") @db.Uuid
  loginTool    String? @map("login_tool") @db.VarChar(100)
  /// Seller quản lý (User có role phù hợp — D-05).
  sellerUserId String? @map("seller_user_id") @db.Uuid

  status AccountStatus @default(NEW)

  // Vòng đời
  issuedAt        DateTime? @map("issued_at") @db.Date
  activatedAt     DateTime? @map("activated_at") @db.Date
  diedBlankAt     DateTime? @map("died_blank_at") @db.Date
  diedAt          DateTime? @map("died_at") @db.Date
  moneyReturnedAt DateTime? @map("money_returned_at") @db.Date
  dieReason       String?   @map("die_reason") @db.Text

  /// Số dư đang bị sàn giữ (Hold) — USD. Mặc định 0, không âm (CHECK ở migration).
  holdAmount Decimal @default(0) @map("hold_amount") @db.Decimal(15, 2)
  /// Số dư thực nhận (Net) — USD. Mặc định 0, không âm (CHECK ở migration).
  netAmount  Decimal @default(0) @map("net_amount") @db.Decimal(15, 2)
  /// Số tiền đã thanh toán/đã rút (Paid) — USD. Mặc định 0, không âm (CHECK ở migration).
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(15, 2)

  // Không nhạy cảm
  proxy   String? @db.VarChar(255)
  docsUrl String? @map("docs_url") @db.VarChar(1024)
  note    String? @db.Text
  note2   String? @db.Text

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  platform     Platform?    @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seller       User?        @relation("AccountSeller", fields: [sellerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  credential           AccountCredential?
  credentialAccessLogs AccountCredentialAccessLog[]
  orders               Order[]

  @@index([organizationId])
  @@index([platformId])
  @@index([sellerUserId])
  @@index([status])
  @@map("accounts")
}

// ---------------------------------------------------------------------------
// AccountCredential — Thông tin đăng nhập/định danh (1-1). Secret MÃ HOÁ at-rest
// (AES-256-GCM — D-01). KHÔNG lưu plaintext. Tách bảng để cô lập bảo mật (D-07).
// ---------------------------------------------------------------------------

model AccountCredential {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid

  // PII (mã hoá)
  inf      String? @db.Text
  ssn      String? @db.Text
  phoneReg String? @map("phone_reg") @db.Text
  gmail    String? @db.Text

  // Secret (mã hoá AES-GCM)
  gmailPassword     String? @map("gmail_password") @db.Text
  recoveryMail      String? @map("recovery_mail") @db.Text
  recoveryMail2fa   String? @map("recovery_mail_2fa") @db.Text
  platformPassword  String? @map("platform_password") @db.Text
  platform2faSecret String? @map("platform_2fa_secret") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("account_credentials")
}

// ---------------------------------------------------------------------------
// AccountCredentialAccessLog — Audit mỗi lần reveal secret (BR-A12).
// ---------------------------------------------------------------------------

model AccountCredentialAccessLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  accessedBy     String  @map("accessed_by") @db.Uuid
  ipAddress      String? @map("ip_address") @db.VarChar(45)
  userAgent      String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId])
  @@index([organizationId])
  @@map("account_credential_access_logs")
}

// ---------------------------------------------------------------------------
// Order — Đơn hàng (nhập thủ công — ADR-012). Tenant-scoped, soft delete (ADR-015).
// Order → Account → Seller (User quản lý). KHÔNG lưu manager_id trong Order:
// quyền row-level suy ra qua account.sellerUserId (docs "account.manager_id").
// Order 1 — N OrderItem. Profit/metric KHÔNG lưu (ADR-014).
// ---------------------------------------------------------------------------

model Order {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  orderNumber String  @map("order_number") @db.VarChar(120)
  /// Nền tảng (code) — denormalize từ account.platform để khoá unique (org, platform, order_number).
  platform    String? @db.VarChar(50)

  shippingAddress String? @map("shipping_address") @db.Text
  /// Đơn vị tiền tệ (Import/Export Excel). VD: USD, VND.
  currency        String? @db.VarChar(10)

  status    OrderStatus @default(WAITING)
  orderedAt DateTime?   @map("ordered_at") @db.Timestamptz(6)

  // Fulfillment workflow — Fulfillment "Nhận xử lý" (claim) 1 đơn; khoá cho Fulfillment khác.
  fulfilledById String?   @map("fulfilled_by_id") @db.Uuid
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account         Account              @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fulfilledBy     User?                @relation("OrderFulfiller", fields: [fulfilledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items           OrderItem[]
  notes           OrderNote[]
  statusHistories OrderStatusHistory[]
  logs            OrderLog[]

  // Unique theo (organization_id, platform, order_number) — BR: order_number không trùng trong 1 nền tảng.
  @@unique([organizationId, platform, orderNumber])
  @@index([organizationId])
  @@index([accountId])
  @@index([status])
  @@index([orderedAt])
  @@index([fulfilledById])
  // Report: tối ưu range-scan theo thời gian trong 1 tổ chức (Dashboard/Reports).
  @@index([organizationId, orderedAt])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// OrderItem — Sản phẩm trong đơn (Order 1 — N OrderItem). Không tenant/soft-delete
// (thuộc vòng đời Order — Cascade khi Order bị xóa cứng; soft delete ở Order).
// ---------------------------------------------------------------------------

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  productName String  @map("product_name") @db.VarChar(1024)
  productLink String? @map("product_link") @db.VarChar(2048)
  color       String? @db.VarChar(255)
  size        String? @db.VarChar(255)
  quantity    Int     @default(1)
  /// Giá đơn vị (VND/USD tuỳ nền tảng) — Decimal cho chính xác. Profit tính runtime (ADR-014).
  unitPrice   Decimal @default(0) @map("unit_price") @db.Decimal(15, 2)
  image       String? @db.VarChar(2048)
  remark      String? @db.Text

  /// Tracking theo TỪNG Item (chuyển từ Order sang Item).
  trackingNumber    String?         @map("tracking_number") @db.VarChar(255)
  /// Trạng thái fulfillment theo từng Item.
  fulfillmentStatus OrderItemStatus @default(PENDING) @map("fulfillment_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// OrderStatusHistory — Timeline chuyển trạng thái đơn (mỗi lần đổi status ghi 1 dòng).
// ---------------------------------------------------------------------------

model OrderStatusHistory {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @map("order_id") @db.Uuid
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  changedBy String       @map("changed_by") @db.Uuid
  note      String?      @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@map("order_status_histories")
}

// ---------------------------------------------------------------------------
// OrderLog — Nhật ký thay đổi đơn (create/update/delete/tracking/status/address/item).
// ---------------------------------------------------------------------------

model OrderLog {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  action      String  @db.VarChar(50)
  field       String? @db.VarChar(100)
  oldValue    String? @map("old_value") @db.Text
  newValue    String? @map("new_value") @db.Text
  performedBy String  @map("performed_by") @db.Uuid
  /// IP của actor khi thao tác (audit — Requirement 9). Hỗ trợ IPv6.
  ipAddress   String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@map("order_logs")
}

// ---------------------------------------------------------------------------
// OrderNote — Ghi chú của Order (Order 1 — N OrderNote). Thay cho seller_note/
// warehouse_note lưu trực tiếp trên Order. type = SELLER | WAREHOUSE. Soft delete.
// ---------------------------------------------------------------------------

model OrderNote {
  id      String        @id @default(uuid()) @db.Uuid
  orderId String        @map("order_id") @db.Uuid
  type    OrderNoteType
  content String        @db.Text

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@index([type])
  @@map("order_notes")
}

// ===========================================================================
// MODULE POD — TIKTOK SHOP (Sprint 1: Link Account)
// Nguồn: docs/pod-tiktok/** · Tài liệu chính thức TikTok Shop Partner Center.
//
// Thiết kế theo response THỰC TẾ của TikTok:
//   - Get Access Token   GET https://auth.tiktok-shops.com/api/v2/token/get
//     → access_token, access_token_expire_in, refresh_token, refresh_token_expire_in,
//       open_id, seller_name, seller_base_region, user_type, granted_scopes
//   - Get Authorized Shops  GET /authorization/202309/shops
//     → shops[]: id, name, region, seller_type, cipher, code
//
// ĐỘC LẬP hoàn toàn với model `Account` (ShopAccount) hiện có — không sửa bảng cũ.
// Trường phục vụ Sprint sau (Sync Orders/Products, Webhook, Shipment) đã dự trù sẵn.
// ===========================================================================

// ---------------------------------------------------------------------------
// PodTiktokAccount — MỘT lần seller uỷ quyền (authorization) cho app.
// 1 Account (token) → N Shop (TikTok trả về mảng `shops[]`, có thể nhiều shop).
// Token LƯU DẠNG MÃ HOÁ AES-256-GCM (EncryptionService) — không bao giờ plaintext.
// ---------------------------------------------------------------------------

model PodTiktokAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Tên do người dùng đặt để nhận diện kết nối (bắt buộc — theo yêu cầu Sprint 1).
  accountName String @map("account_name") @db.VarChar(255)

  // --- Dữ liệu định danh trả về từ Get Access Token ---
  /// `open_id` — ID người dùng đã uỷ quyền (TikTok). Unique trong 1 Organization.
  openId           String  @map("open_id") @db.VarChar(128)
  /// `seller_name` — tên seller do TikTok trả về.
  sellerName       String? @map("seller_name") @db.VarChar(255)
  /// `seller_base_region` — vùng của seller (vd US).
  sellerBaseRegion String? @map("seller_base_region") @db.VarChar(10)
  /// `user_type` — 0=Seller, 1=Creator, 2/3=Partner, 4/5=Global Selling seller.
  /// Chỉ chấp nhận 0/4/5 (seller) — CHECK constraint ở migration.
  userType         Int     @map("user_type")

  // --- Token (MÃ HOÁ AES-256-GCM at-rest) ---
  /// `access_token` đã mã hoá. KHÔNG expose qua API.
  accessTokenEnc        String   @map("access_token_enc") @db.Text
  /// `access_token_expire_in` (Unix) → timestamptz. Mặc định TikTok cấp 7 ngày.
  accessTokenExpiresAt  DateTime @map("access_token_expires_at") @db.Timestamptz(6)
  /// `refresh_token` đã mã hoá.
  refreshTokenEnc       String   @map("refresh_token_enc") @db.Text
  /// `refresh_token_expire_in` (Unix) → timestamptz. = thời hạn seller cấp quyền.
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at") @db.Timestamptz(6)
  /// `granted_scopes` — scope thực tế được cấp (cảnh báo sớm trước khi API lỗi 105005).
  grantedScopes         Json?    @map("granted_scopes")

  status PodTiktokAccountStatus @default(PENDING)

  // --- Vận hành / phục vụ Sprint sau (Refresh Token, Sync, Webhook) ---
  /// Lần refresh token gần nhất (Sprint 2 — Token Lifecycle).
  lastRefreshedAt     DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  /// Số lần refresh thất bại liên tiếp — circuit breaker.
  refreshFailureCount Int       @default(0) @map("refresh_failure_count")
  /// Lần đồng bộ đơn gần nhất (Sprint 3 — Sync Orders).
  lastSyncedAt        DateTime? @map("last_synced_at") @db.Timestamptz(6)
  /// Mã lỗi TikTok gần nhất (vd 105002, 36004004).
  lastErrorCode       String?   @map("last_error_code") @db.VarChar(20)
  lastErrorMessage    String?   @map("last_error_message") @db.VarChar(500)
  /// `request_id` của TikTok — bắt buộc khi mở ticket hỗ trợ.
  lastErrorRequestId  String?   @map("last_error_request_id") @db.VarChar(64)

  /// User đã thực hiện uỷ quyền (audit).
  authorizedBy String? @map("authorized_by") @db.Uuid
  /// Nhân viên (Employee) phụ trách kết nối này với vai trò Seller. NULL = chưa phân công.
  ///
  /// 🔴 Trỏ tới `Employee`, KHÔNG phải `User`: seller là một vai trò NGHIỆP VỤ nên phải gắn
  /// với hồ sơ nhân sự (ADR-007 — User lo đăng nhập, Employee lo thông tin nghiệp vụ).
  /// Chỉ Employee đang ACTIVE và có Role `EMPLOYEE` mới được gán (Admin/Fulfillment không phải seller).
  ///
  /// Đây là NGUỒN DUY NHẤT xác định seller của mọi dữ liệu POD: Order/Payout/Dashboard đều
  /// join ngược qua account, KHÔNG bản sao xuống Order — đổi người phụ trách là toàn hệ thống
  /// đổi theo, không có dữ liệu lệch.
  sellerId     String? @map("seller_id") @db.Uuid

  /// Nhà cung cấp fulfillment dùng cho MỌI đơn của kết nối này. NULL = chưa cấu hình
  /// ⇒ không gửi sản xuất được (báo lỗi rõ ràng thay vì im lặng dùng nhầm tài khoản).
  /// Một TikTok Account chỉ dùng MỘT provider; đổi provider áp dụng cho đơn gửi từ đó về sau.
  fulfillmentAccountId String? @map("fulfillment_account_id") @db.Uuid

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  authorizer         User?               @relation("PodTiktokAuthorizer", fields: [authorizedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  seller             Employee?           @relation("PodTiktokSeller", fields: [sellerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fulfillmentAccount FulfillmentAccount? @relation("PodTiktokFulfillmentAccount", fields: [fulfillmentAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  shops                 PodTiktokShop[]
  tokenAudits           PodTiktokTokenAudit[]
  oauthStates           PodTiktokOAuthState[]
  products              PodProduct[]
  productSyncHistories  PodProductSyncHistory[]
  listingPayloads       PodListingPayload[]
  orders                PodOrder[]
  syncLogs              PodSyncLog[]
  payments              PodTiktokPayment[]
  statements            PodTiktokStatement[]
  statementTransactions PodTiktokStatementTransaction[]

  // Không link trùng cùng một seller (open_id) trong CÙNG Organization.
  // Uỷ quyền lại (reauthorize) → UPDATE bản ghi cũ, không tạo mới.
  @@unique([organizationId, openId])
  @@index([organizationId])
  @@index([status])
  @@index([accessTokenExpiresAt])
  @@index([refreshTokenExpiresAt])
  @@index([sellerId])
  // Đã tồn tại trong DB từ migration `fulfillment_provider_management` nhưng thiếu khai báo ở
  // schema ⇒ mọi lần `migrate dev` sau đó đều sinh lệnh DROP nhầm. Khai báo lại để hết lệch.
  @@index([fulfillmentAccountId])
  @@map("pod_tiktok_accounts")
}

// ---------------------------------------------------------------------------
// PodTiktokShop — một TikTok Shop cụ thể thuộc kết nối (Get Authorized Shops).
// `cipher` (shop_cipher) là định danh BẮT BUỘC cho mọi API Shop-tag (Order,
// Product, Fulfillment) ⇒ coi như credential, mã hoá at-rest.
// ---------------------------------------------------------------------------

model PodTiktokShop {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Kết nối (authorization) sở hữu shop này.
  accountId      String @map("account_id") @db.Uuid

  /// `shops[].id` — TikTok Shop ID.
  tiktokShopId  String  @map("tiktok_shop_id") @db.VarChar(64)
  /// `shops[].cipher` — shop_cipher (MÃ HOÁ). Bắt buộc cho Shop-tag API.
  shopCipherEnc String  @map("shop_cipher_enc") @db.Text
  /// `shops[].code` — mã shop hiển thị ở Seller Center.
  shopCode      String? @map("shop_code") @db.VarChar(64)
  /// `shops[].name` — tên shop.
  name          String  @db.VarChar(255)
  /// `shops[].region` — thị trường (US, GB, ...).
  region        String  @db.VarChar(10)
  /// `shops[].seller_type` — LOCAL | CROSS_BORDER.
  sellerType    String  @map("seller_type") @db.VarChar(20)

  // --- Dự trù Sprint sau ---
  /// Bật/tắt đồng bộ theo từng shop (Sprint 3 — Sync Orders).
  /// 🔴 **Warehouse Mapping của shop** — kho mặc định dùng khi Publish sản phẩm lên shop này.
  ///
  /// Kho là dữ liệu CỦA SHOP, không phải của sản phẩm: cùng một Draft Product đăng lên ba
  /// shop là ba kho khác nhau. Draft vì thế không gắn kho; kho chỉ được quyết ở bước Publish,
  /// và đây là chỗ người vận hành khai báo lựa chọn của từng shop.
  defaultWarehouseId String? @map("default_warehouse_id") @db.Uuid

  syncEnabled         Boolean   @default(true) @map("sync_enabled")
  /// Watermark `update_time` (Unix seconds) đã đồng bộ xong (Sprint 3).
  lastOrderSyncCursor BigInt?   @map("last_order_sync_cursor")
  /// Lần đồng bộ đơn gần nhất của shop (Sprint 3).
  lastOrderSyncAt     DateTime? @map("last_order_sync_at") @db.Timestamptz(6)
  /// Thời điểm đăng ký webhook cho shop (Sprint 4 — Webhook).
  webhookRegisteredAt DateTime? @map("webhook_registered_at") @db.Timestamptz(6)

  /// Số lượt sync thất bại LIÊN TIẾP — circuit breaker theo shop (Sprint 2).
  syncFailureCount        Int       @default(0) @map("sync_failure_count")
  /// Tạm ngưng sync tới thời điểm này (backoff khi lỗi liên tiếp). NULL = không ngưng.
  syncPausedUntil         DateTime? @map("sync_paused_until") @db.Timestamptz(6)
  /// Đã kéo xong lịch sử đơn lần đầu hay chưa (phân biệt lần sync đầu vs định kỳ).
  /// FALSE ⇒ shop chạy pha BACKFILL (quét theo `create_time`); TRUE ⇒ chạy pha
  /// INCREMENTAL (quét theo `update_time`). Xem docs/pod-tiktok/05-flows-sequence.md.
  backfillDone            Boolean   @default(false) @map("backfill_done")
  // --- Đồng bộ SẢN PHẨM (Sprint Product) — tách hoàn toàn khỏi watermark của Order ---
  /// Bật/tắt đồng bộ sản phẩm riêng cho shop này.
  productSyncEnabled      Boolean   @default(true) @map("product_sync_enabled")
  /// Watermark `update_time` (Unix seconds) đã đồng bộ xong của SẢN PHẨM.
  /// NULL = chưa từng đồng bộ ⇒ lượt đầu chạy FULL.
  productSyncCursor       BigInt?   @map("product_sync_cursor")
  productSyncedAt         DateTime? @map("product_synced_at") @db.Timestamptz(6)
  /// Số lượt đồng bộ sản phẩm thất bại LIÊN TIẾP — circuit breaker theo shop.
  productSyncFailureCount Int       @default(0) @map("product_sync_failure_count")

  /// Watermark `create_time` (Unix seconds) của pha BACKFILL — cho phép kéo lịch sử
  /// nhiều lượt mà không phải quét lại từ đầu. NULL = chưa kéo lát nào.
  /// KHÔNG dùng chung với `lastOrderSyncCursor`: hai cột theo hai trục thời gian khác nhau
  /// (`create_time` bất biến ⇒ phân trang ổn định; `update_time` thay đổi được).
  backfillCursor BigInt? @map("backfill_cursor")

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account               PodTiktokAccount                @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  defaultWarehouse      PodTiktokWarehouse?             @relation("PodShopDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orders                PodOrder[]
  syncLogs              PodSyncLog[]
  products              PodProduct[]
  productCategories     PodProductCategory[]
  productBrands         PodProductBrand[]
  productSyncHistories  PodProductSyncHistory[]
  warehouses            PodTiktokWarehouse[]
  listingPayloads       PodListingPayload[]
  listingJobItems       PodListingJobItem[]
  payments              PodTiktokPayment[]
  statements            PodTiktokStatement[]
  statementTransactions PodTiktokStatementTransaction[]
  listingSessionShops   PodListingSessionShop[]

  // Chống link trùng Shop trong cùng Organization (hàng rào ở tầng DB).
  @@unique([organizationId, tiktokShopId])
  @@index([organizationId])
  @@index([accountId])
  @@index([tiktokShopId])
  @@index([syncEnabled])
  @@map("pod_tiktok_shops")
}

// ---------------------------------------------------------------------------
// PodTiktokTokenAudit — vết thao tác token (bảo mật). KHÔNG lưu giá trị token.
// ---------------------------------------------------------------------------

model PodTiktokTokenAudit {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  action  PodTiktokTokenAction
  success Boolean

  /// Mã lỗi TikTok (nếu thất bại).
  errorCode       String? @map("error_code") @db.VarChar(20)
  /// `request_id` của TikTok — phục vụ mở ticket.
  tiktokRequestId String? @map("tiktok_request_id") @db.VarChar(64)

  /// Hạn token SAU thao tác (metadata, không phải giá trị token).
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)

  /// NULL = do hệ thống (cron) thực hiện.
  performedBy String? @map("performed_by") @db.Uuid
  ipAddress   String? @map("ip_address") @db.VarChar(45)
  userAgent   String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account PodTiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([accountId, createdAt])
  @@index([organizationId])
  @@map("pod_tiktok_token_audits")
}

// ---------------------------------------------------------------------------
// PodTiktokOAuthState — tham số `state` của luồng uỷ quyền TikTok.
//
// 🔴 Vì sao BẮT BUỘC: một app TikTok chỉ khai báo được MỘT Redirect URL cho tất cả
// tenant. Khi TikTok gọi callback, request đó KHÔNG mang danh tính người dùng
// (không cookie, không JWT) ⇒ `state` là thứ DUY NHẤT ánh xạ callback về đúng
// Organization/User đã bấm "Link Account". Đồng thời chống CSRF & replay.
//
// Lưu ở DB (không phải Redis) để có vết kiểm toán: ai bắt đầu uỷ quyền, lúc nào,
// kết thúc ra sao. Bản ghi hết hạn được dọn định kỳ (không phải dữ liệu nghiệp vụ
// lâu dài) nên KHÔNG dùng soft delete — cùng nguyên tắc với các bảng log vận hành.
// ---------------------------------------------------------------------------

model PodTiktokOAuthState {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// User đã bấm "Link TikTok Account" — người sẽ được ghi là `authorized_by`.
  userId         String @map("user_id") @db.Uuid

  /// Tên kết nối do người dùng đặt TRƯỚC khi mở authorization link.
  ///
  /// 🔴 Phải lưu ở đây vì callback của TikTok là request vô danh: lúc đó không còn form,
  /// không còn session nào để hỏi lại tên. Bản ghi `state` là nơi duy nhất mang được
  /// thông tin người dùng đã nhập đi qua chuyến vòng sang TikTok và quay về.
  accountName String @map("account_name") @db.VarChar(255)

  /// Giá trị ngẫu nhiên gửi kèm authorization link (32 byte, base64url).
  /// UNIQUE ⇒ hàng rào cuối cùng chống trùng ở tầng DB.
  state  String                    @db.VarChar(128)
  /// Thị trường đã dùng để dựng link (US | ROW) — phục vụ chẩn đoán.
  region String                    @db.VarChar(10)
  status PodTiktokOAuthStateStatus @default(PENDING)

  /// Hết hạn ⇒ callback bị từ chối. Ngắn hơn nhiều so với hạn 30 phút của auth_code.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Thời điểm state bị tiêu thụ (chuyển sang USED) — chống dùng lại.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  /// Vé một lần để TRANG KẾT QUẢ (công khai) đọc tóm tắt phi nhạy cảm:
  /// tên shop, region, thời điểm liên kết. KHÔNG bao giờ mang token.
  resultToken String? @map("result_token") @db.VarChar(128)
  /// Kết nối được tạo/cập nhật khi luồng thành công.
  accountId   String? @map("account_id") @db.Uuid

  /// Nguyên nhân thất bại (mã lỗi nghiệp vụ, vd POD_TIKTOK_INVALID_AUTH_CODE).
  /// 🔴 KHÔNG bao giờ lưu `auth_code` hay token ở đây.
  errorCode String? @map("error_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account PodTiktokAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([state])
  @@unique([resultToken])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("pod_tiktok_oauth_states")
}

// ===========================================================================
// MODULE POD — TIKTOK ORDERS (Sprint 2: Scheduler + Get Orders + Sync Orders)
//
// Thiết kế theo RESPONSE THỰC TẾ của `POST /order/202309/orders/search`
// (Get Order List — partner.tiktokshop.com/docv2/page/650aa8094a0bb702c06df242).
//
// Cấu trúc TikTok trả về:  Order -> line_items[] -> (item_tax[], sub_item_info[])
//                                -> packages[]
// => ánh xạ thành: pod_orders 1—N pod_order_items · pod_orders 1—N pod_order_packages
//
// ĐỘC LẬP với bảng `orders` (đơn nhập tay) — không dùng chung, không sửa bảng cũ.
// Tiền tệ dùng Decimal(18,4): TikTok trả về dạng STRING, parse có kiểm soát.
// Thời gian lưu CẢ Unix seconds (bigint — để so watermark) LẪN timestamptz (để query).
// ===========================================================================

model PodOrder {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  /// `orders[].id` — TikTok Shop order ID.
  tiktokOrderId String @map("tiktok_order_id") @db.VarChar(64)

  /// `orders[].status` — UNPAID/ON_HOLD/AWAITING_SHIPMENT/PARTIALLY_SHIPPING/
  /// AWAITING_COLLECTION/IN_TRANSIT/DELIVERED/COMPLETED/CANCELLED.
  /// KHÔNG dùng enum Postgres: TikTok bổ sung giá trị mới (vd ON_HOLD) nên enum cứng sẽ vỡ sync.
  status String @db.VarChar(40)

  // --- Người mua ---
  buyerUserId   String? @map("buyer_user_id") @db.VarChar(64)
  /// `buyer_email` — email ẩn danh do TikTok cấp.
  buyerEmail    String? @map("buyer_email") @db.VarChar(255)
  buyerNickname String? @map("buyer_nickname") @db.VarChar(255)
  buyerMessage  String? @map("buyer_message") @db.Text
  sellerNote    String? @map("seller_note") @db.Text

  // --- Huỷ đơn ---
  cancellationInitiator String? @map("cancellation_initiator") @db.VarChar(20)
  cancelReason          String? @map("cancel_reason") @db.VarChar(500)
  isBuyerRequestCancel  Boolean @default(false) @map("is_buyer_request_cancel")

  // --- Fulfillment / vận chuyển ---
  fulfillmentType            String? @map("fulfillment_type") @db.VarChar(40)
  deliveryType               String? @map("delivery_type") @db.VarChar(30)
  /// TIKTOK (4PL) | SELLER (3PL) | TIKTOK_DIGITAL — quyết định địa chỉ có bị che hay không.
  shippingType               String? @map("shipping_type") @db.VarChar(30)
  shippingProvider           String? @map("shipping_provider") @db.VarChar(255)
  shippingProviderId         String? @map("shipping_provider_id") @db.VarChar(64)
  trackingNumber             String? @map("tracking_number") @db.VarChar(255)
  splitOrCombineTag          String? @map("split_or_combine_tag") @db.VarChar(20)
  hasUpdatedRecipientAddress Boolean @default(false) @map("has_updated_recipient_address")
  warehouseId                String? @map("warehouse_id") @db.VarChar(64)
  deliveryOptionId           String? @map("delivery_option_id") @db.VarChar(64)
  deliveryOptionName         String? @map("delivery_option_name") @db.VarChar(255)
  paymentMethodName          String? @map("payment_method_name") @db.VarChar(100)
  needUploadInvoice          String? @map("need_upload_invoice") @db.VarChar(30)
  isCod                      Boolean @default(false) @map("is_cod")

  // --- Loại đơn (US: POD dùng MADE_TO_ORDER) ---
  /// NORMAL | ZERO_LOTTERY | PRE_ORDER | MADE_TO_ORDER | BACK_ORDER | VIRTUAL_ORDER.
  orderType             String? @map("order_type") @db.VarChar(30)
  /// `handling_duration.days` — chỉ có với MADE_TO_ORDER/BACK_ORDER.
  handlingDurationDays  String? @map("handling_duration_days") @db.VarChar(10)
  /// `handling_duration.type` — CALENDAR_DAY | BUSINESS_DAY.
  handlingDurationType  String? @map("handling_duration_type") @db.VarChar(20)
  /// `release_date` — chỉ có với PRE_ORDER. Unix seconds.
  releaseDate           BigInt? @map("release_date")
  /// Luồng On Hold mới/cũ — quyết định app có phải tự giữ đơn 1 giờ hay không.
  isOnHoldOrder         Boolean @default(false) @map("is_on_hold_order")
  isSampleOrder         Boolean @default(false) @map("is_sample_order")
  isReplacementOrder    Boolean @default(false) @map("is_replacement_order")
  replacedOrderId       String? @map("replaced_order_id") @db.VarChar(64)
  isExchangeOrder       Boolean @default(false) @map("is_exchange_order")
  exchangeSourceOrderId String? @map("exchange_source_order_id") @db.VarChar(64)
  isSubscriptionOrder   Boolean @default(false) @map("is_subscription_order")
  commercePlatform      String? @map("commerce_platform") @db.VarChar(30)
  autoCombineGroupId    String? @map("auto_combine_group_id") @db.VarChar(64)
  fastDeliveryProgram   String? @map("fast_delivery_program") @db.VarChar(40)

  // --- payment{} (TikTok trả STRING -> Decimal(18,4)) ---
  currency                    String?  @db.VarChar(10)
  totalAmount                 Decimal? @map("total_amount") @db.Decimal(18, 4)
  subTotal                    Decimal? @map("sub_total") @db.Decimal(18, 4)
  shippingFee                 Decimal? @map("shipping_fee") @db.Decimal(18, 4)
  originalTotalProductPrice   Decimal? @map("original_total_product_price") @db.Decimal(18, 4)
  originalShippingFee         Decimal? @map("original_shipping_fee") @db.Decimal(18, 4)
  sellerDiscount              Decimal? @map("seller_discount") @db.Decimal(18, 4)
  platformDiscount            Decimal? @map("platform_discount") @db.Decimal(18, 4)
  paymentPlatformDiscount     Decimal? @map("payment_platform_discount") @db.Decimal(18, 4)
  paymentDiscountServiceFee   Decimal? @map("payment_discount_service_fee") @db.Decimal(18, 4)
  shippingFeeSellerDiscount   Decimal? @map("shipping_fee_seller_discount") @db.Decimal(18, 4)
  shippingFeePlatformDiscount Decimal? @map("shipping_fee_platform_discount") @db.Decimal(18, 4)
  shippingFeeCofundedDiscount Decimal? @map("shipping_fee_cofunded_discount") @db.Decimal(18, 4)
  tax                         Decimal? @db.Decimal(18, 4)
  productTax                  Decimal? @map("product_tax") @db.Decimal(18, 4)
  shippingFeeTax              Decimal? @map("shipping_fee_tax") @db.Decimal(18, 4)
  retailDeliveryFee           Decimal? @map("retail_delivery_fee") @db.Decimal(18, 4)
  buyerServiceFee             Decimal? @map("buyer_service_fee") @db.Decimal(18, 4)
  handlingFee                 Decimal? @map("handling_fee") @db.Decimal(18, 4)
  shippingInsuranceFee        Decimal? @map("shipping_insurance_fee") @db.Decimal(18, 4)
  itemInsuranceFee            Decimal? @map("item_insurance_fee") @db.Decimal(18, 4)
  itemInsuranceTax            Decimal? @map("item_insurance_tax") @db.Decimal(18, 4)
  smallOrderFee               Decimal? @map("small_order_fee") @db.Decimal(18, 4)

  // --- recipient_address{} — PII, MÃ HOÁ at-rest (AES-256-GCM) ---
  /// Toàn bộ object `recipient_address` đã mã hoá. Chỉ giải mã khi có quyền.
  recipientEnc        String? @map("recipient_enc") @db.Text
  /// Không nhạy cảm — dùng lọc/thống kê theo vùng mà không cần giải mã.
  recipientRegionCode String? @map("recipient_region_code") @db.VarChar(10)
  recipientPostalCode String? @map("recipient_postal_code") @db.VarChar(20)
  /// Payload lần này trả về địa chỉ ĐÃ BỊ CHE (4PL/FBT hoặc quá 30 ngày sau COMPLETED).
  /// Dùng cho quy tắc masking-safe write: KHÔNG ghi đè dữ liệu thật bằng giá trị đã che.
  recipientMasked     Boolean @default(false) @map("recipient_masked")

  // --- Mốc thời gian (Unix seconds từ TikTok) ---
  tiktokCreateTime  BigInt  @map("tiktok_create_time")
  /// Dùng cho watermark đồng bộ và phát hiện thay đổi.
  tiktokUpdateTime  BigInt  @map("tiktok_update_time")
  paidTime          BigInt? @map("paid_time")
  rtsTime           BigInt? @map("rts_time")
  cancelTime        BigInt? @map("cancel_time")
  deliveryTime      BigInt? @map("delivery_time")
  collectionTime    BigInt? @map("collection_time")
  requestCancelTime BigInt? @map("request_cancel_time")

  // SLA
  rtsSlaTime         BigInt? @map("rts_sla_time")
  ttsSlaTime         BigInt? @map("tts_sla_time")
  deliverySlaTime    BigInt? @map("delivery_sla_time")
  cancelOrderSlaTime BigInt? @map("cancel_order_sla_time")
  shippingDueTime    BigInt? @map("shipping_due_time")
  collectionDueTime  BigInt? @map("collection_due_time")
  deliveryDueTime    BigInt? @map("delivery_due_time")

  /// Bản timestamptz của create/update time — phục vụ filter và sort trên UI.
  orderedAt       DateTime @map("ordered_at") @db.Timestamptz(6)
  tiktokUpdatedAt DateTime @map("tiktok_updated_at") @db.Timestamptz(6)

  // --- Metadata đồng bộ ---
  /// sha256 canonical JSON (đã LOẠI recipient_address) — phát hiện thay đổi nội dung.
  payloadHash  String   @map("payload_hash") @db.Char(64)
  /// Response nguyên trạng — phục vụ debug/replay mà không cần gọi lại TikTok.
  rawPayload   Json     @map("raw_payload")
  /// Có ít nhất một line item `is_pod_customized = true`.
  hasPodItem   Boolean  @default(false) @map("has_pod_item")
  /// Nguồn ghi gần nhất: CRON | MANUAL | BACKFILL.
  syncSource   String   @map("sync_source") @db.VarChar(20)
  /// Số lần bản ghi được cập nhật từ TikTok (0 = mới tạo).
  syncVersion  Int      @default(0) @map("sync_version")
  /// Lần cuối nhìn thấy đơn này trong một lượt sync (kể cả khi SKIP).
  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz(6)

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account           PodTiktokAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop              PodTiktokShop      @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items             PodOrderItem[]
  packages          PodOrderPackage[]
  /// Các lần gửi đơn sang xưởng in (mỗi nhà cung cấp tối đa một bản ghi).
  fulfillmentOrders FulfillmentOrder[]

  /// Hàng rào chống trùng đơn ở tầng DB (không chỉ ở tầng code).
  @@unique([organizationId, tiktokOrderId])
  @@index([organizationId])
  @@index([shopId, tiktokUpdateTime])
  @@index([accountId])
  @@index([status])
  @@index([organizationId, orderedAt])
  @@index([hasPodItem])
  @@index([orderType])
  @@map("pod_orders")
}

// ---------------------------------------------------------------------------
// PodOrderItem — `orders[].line_items[]`.
// LƯU Ý: TikTok trả 1 line item = 1 ĐƠN VỊ sản phẩm (mua 5 áo => 5 line item),
// mỗi cái có `id` riêng và có thể có nội dung POD riêng => KHÔNG gộp.
// ---------------------------------------------------------------------------

model PodOrderItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid

  /// `line_items[].id` — order line item ID.
  tiktokLineItemId String @map("tiktok_line_item_id") @db.VarChar(64)

  productId   String? @map("product_id") @db.VarChar(64)
  productName String? @map("product_name") @db.VarChar(1024)
  skuId       String? @map("sku_id") @db.VarChar(64)
  skuName     String? @map("sku_name") @db.VarChar(512)
  sellerSku   String? @map("seller_sku") @db.VarChar(255)
  skuImage    String? @map("sku_image") @db.VarChar(2048)

  salePrice        Decimal? @map("sale_price") @db.Decimal(18, 4)
  originalPrice    Decimal? @map("original_price") @db.Decimal(18, 4)
  platformDiscount Decimal? @map("platform_discount") @db.Decimal(18, 4)
  sellerDiscount   Decimal? @map("seller_discount") @db.Decimal(18, 4)
  currency         String?  @db.VarChar(10)

  /// Trạng thái hiển thị theo item và trạng thái package của item.
  displayStatus String? @map("display_status") @db.VarChar(40)
  packageStatus String? @map("package_status") @db.VarChar(40)

  packageId            String? @map("package_id") @db.VarChar(64)
  trackingNumber       String? @map("tracking_number") @db.VarChar(255)
  shippingProviderId   String? @map("shipping_provider_id") @db.VarChar(64)
  shippingProviderName String? @map("shipping_provider_name") @db.VarChar(255)
  warehouseId          String? @map("warehouse_id") @db.VarChar(64)

  cancelReason String? @map("cancel_reason") @db.VarChar(500)
  cancelUser   String? @map("cancel_user") @db.VarChar(20)
  rtsTime      BigInt? @map("rts_time")

  isGift            Boolean @default(false) @map("is_gift")
  isDangerousGood   Boolean @default(false) @map("is_dangerous_good")
  needsPrescription Boolean @default(false) @map("needs_prescription")

  /// POD — có sẵn ngay ở Get Order List (không cần gọi Get Order Detail).
  isPodCustomized Boolean @default(false) @map("is_pod_customized")
  /// ID dữ liệu tuỳ biến POD — dùng làm `pod_order_data_id` khi gọi Get Pod Detail (Sprint sau).
  podInfoId       String? @map("pod_info_id") @db.VarChar(64)

  /// DEPRECATED bởi TikTok (thay bằng `order_type` ở mức Order) — giữ để tương thích ngược.
  skuType            String? @map("sku_type") @db.VarChar(40)
  productListingType String? @map("product_listing_type") @db.VarChar(40)
  roomId             String? @map("room_id") @db.VarChar(64)

  /// Danh mục sản phẩm — hiển thị ở màn hình Order List.
  /// ⚠️ Get Order List KHÔNG trả về category; trường này sẽ được điền khi triển khai
  /// Sprint Product (Get Product API). Hiện tại luôn NULL và UI hiển thị "—".
  productCategory String? @map("product_category") @db.VarChar(255)

  retailDeliveryFee Decimal? @map("retail_delivery_fee") @db.Decimal(18, 4)
  buyerServiceFee   Decimal? @map("buyer_service_fee") @db.Decimal(18, 4)
  smallOrderFee     Decimal? @map("small_order_fee") @db.Decimal(18, 4)
  pfandFee          Decimal? @map("pfand_fee") @db.Decimal(18, 4)
  giftRetailPrice   Decimal? @map("gift_retail_price") @db.Decimal(18, 4)

  isUnboxingItem  Boolean @default(false) @map("is_unboxing_item")
  unboxingSkuCode String? @map("unboxing_sku_code") @db.VarChar(64)

  /// Mảng lồng nhau giữ nguyên dạng JSON (ít truy vấn, tránh phình bảng).
  itemTax             Json? @map("item_tax")
  subItemInfo         Json? @map("sub_item_info")
  combinedListingSkus Json? @map("combined_listing_skus")
  unboxingCaseList    Json? @map("unboxing_case_list")

  /// sha256 của item — chỉ UPDATE khi nội dung thay đổi.
  payloadHash String @map("payload_hash") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order                 PodOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// ⛔ Lịch sử, chỉ đọc — xem chú thích ở `PodOrderItemDesign`. Đơn hàng ĐỌC design từ
  /// Product Mapping (`FulfillmentProductDesign`), không sở hữu design.
  designs               PodOrderItemDesign[]
  fulfillmentOrderItems FulfillmentOrderItem[]

  /// Chống trùng item trong cùng một đơn.
  @@unique([orderId, tiktokLineItemId])
  @@index([organizationId])
  @@index([orderId])
  @@index([skuId])
  @@index([isPodCustomized])
  @@index([packageId])
  @@map("pod_order_items")
}

// ---------------------------------------------------------------------------
// PodOrderPackage — `orders[].packages[]`.
// Get Order List chỉ trả `{ id }`; các field chi tiết (tracking, label...) sẽ được
// bổ sung ở Sprint Fulfillment qua Get Package Detail.
// ---------------------------------------------------------------------------

model PodOrderPackage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid

  /// `packages[].id` — package ID.
  tiktokPackageId String @map("tiktok_package_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order PodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([orderId, tiktokPackageId])
  @@index([organizationId])
  @@index([orderId])
  @@map("pod_order_packages")
}

// ---------------------------------------------------------------------------
// PodSyncLog — nhật ký từng lượt đồng bộ (theo shop hoặc theo cả lượt cron).
// Bảng log: chỉ created_at, KHÔNG soft delete; có job dọn theo retention.
// ---------------------------------------------------------------------------

model PodSyncLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// NULL = dòng tổng hợp của cả lượt cron (nhiều account).
  accountId      String? @map("account_id") @db.Uuid
  /// NULL = dòng tổng hợp cấp account/cron.
  shopId         String? @map("shop_id") @db.Uuid

  trigger PodSyncTrigger
  status  PodSyncStatus  @default(RUNNING)

  /// Cửa sổ thời gian (Unix seconds) đã quét. Trục thời gian tuỳ pha:
  /// BACKFILL dùng `create_time`, INCREMENTAL dùng `update_time` (xem `phase`).
  windowFrom BigInt?      @map("window_from")
  windowTo   BigInt?      @map("window_to")
  /// Pha đã chạy: BACKFILL (kéo lịch sử) | INCREMENTAL (đồng bộ định kỳ).
  phase      PodSyncPhase @default(INCREMENTAL)

  pagesFetched Int @default(0) @map("pages_fetched")
  /// Số lần gọi TikTok API — theo dõi mức tiêu thụ quota.
  apiCalls     Int @default(0) @map("api_calls")

  totalOrders      Int  @default(0) @map("total_orders")
  /// `data.total_count` do TikTok trả về ở trang đầu — đối chiếu với `totalOrders`
  /// để tự phát hiện đồng bộ thiếu (đây chính là dấu hiệu đã bỏ lỡ ở bug 55/143).
  tiktokTotalCount Int? @map("tiktok_total_count")
  createdCount     Int  @default(0) @map("created_count")
  updatedCount     Int  @default(0) @map("updated_count")
  skippedCount     Int  @default(0) @map("skipped_count")
  failedCount      Int  @default(0) @map("failed_count")

  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")

  errorCode       String? @map("error_code") @db.VarChar(40)
  errorMessage    String? @map("error_message") @db.VarChar(1000)
  /// `request_id` của TikTok — bắt buộc khi mở ticket hỗ trợ.
  tiktokRequestId String? @map("tiktok_request_id") @db.VarChar(64)

  /// NULL = do scheduler chạy; có giá trị = do người dùng bấm Manual Sync.
  triggeredBy String? @map("triggered_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account PodTiktokAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop    PodTiktokShop?    @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, startedAt])
  @@index([shopId, startedAt])
  @@index([accountId, startedAt])
  @@index([status])
  @@map("pod_sync_logs")
}

// ---------------------------------------------------------------------------
// PodOrderItemDesign — ⛔ LƯU TRỮ LỊCH SỬ, CHỈ ĐỌC. KHÔNG CÒN CODE NÀO GHI VÀO BẢNG NÀY.
//
// Đây là mô hình CŨ: design gắn theo từng line item. Nó sai với nghiệp vụ POD — cùng một
// sản phẩm bán 11 lần thì phải upload 11 lần cùng một file in, và chỉ cần sót một lần là
// đơn đó ra xưởng thiếu file. Design là thuộc tính của SẢN PHẨM, không phải của lần bán.
//
// Nguồn sự thật hiện tại: `FulfillmentProductDesign` (khoá theo Product ID + Seller SKU).
// Endpoint `POST /pod/tiktok/order-items/:id/designs` đã bị GỠ BỎ cùng service/repository
// của nó — không còn đường ghi nào vào đây.
//
// Vì sao GIỮ bảng thay vì DROP: dữ liệu nào ghép được đã chuyển sang bảng mới
// (migration `20260826170000_design_by_product_sku`), nhưng dòng nào thuộc sản phẩm CHƯA
// khai ánh xạ thì không có chỗ để chuyển tới — drop bảng là mất vĩnh viễn thông tin
// "đơn này từng in file nào". Yêu cầu nghiệp vụ nói rõ: migration không được mất dữ liệu,
// và snapshot phục vụ audit phải giữ nguyên.
//
// Bảng vẫn được tính trong `StorageRepository.countReferences` để không ai xoá nhầm file
// mà một dòng lịch sử còn trỏ tới.
// ---------------------------------------------------------------------------

model PodOrderItemDesign {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Denormalize từ order item — cho phép lọc/đếm design theo đơn mà không phải join.
  orderId        String @map("order_id") @db.Uuid
  orderItemId    String @map("order_item_id") @db.Uuid

  /// Vị trí in: FRONT | BACK | LEFT | RIGHT | SLEEVE | LABEL.
  placement PodDesignPlacement

  /// File thực tế nằm ở Storage Module (bảng `storage_files`).
  /// Bảng này KHÔNG lặp lại object key / URL / mime / size — mọi thông tin file
  /// là trách nhiệm của Storage Module (một nguồn sự thật duy nhất).
  storageFileId String @map("storage_file_id") @db.Uuid

  /// Số lần design ở vị trí này được thay (1 = upload lần đầu).
  version Int @default(1)

  // Audit + soft delete (ADR-015)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  orderItem   PodOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// Restrict: không cho xoá bản ghi file khi vẫn còn design tham chiếu.
  storageFile StorageFile  @relation(fields: [storageFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Mỗi sản phẩm chỉ có MỘT design đang hiệu lực cho mỗi vị trí in.
  @@unique([orderItemId, placement])
  @@index([organizationId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([placement])
  @@map("pod_order_item_designs")
}

// ---------------------------------------------------------------------------
// FulfillmentProductDesign — file in của một SẢN PHẨM POD.
//
// 🔴 KHOÁ LÀ (organization, Product ID, Seller SKU) — KHÔNG phải Product Mapping.
//
// Đây là thay đổi nghiệp vụ, không phải đổi tên cho đẹp. Trước đây design treo vào
// `mapping_id`, nghĩa là **phải khai Product Mapping xong mới upload được design**. Sai:
// Design và Product Mapping là hai nghiệp vụ ĐỘC LẬP —
//   · Design       trả lời "in cái gì"  → chỉ cần Product ID + Seller SKU
//   · Mapping      trả lời "in ở đâu"   → chỉ cần khi Fulfill
// Người vận hành phải làm được theo bất kỳ thứ tự nào: upload design trước rồi ánh xạ sau,
// hoặc ngược lại. Ràng buộc cũ còn kéo theo hai hệ quả tệ hơn: xoá một Product Mapping là
// CASCADE xoá luôn design của nó, và đổi nhà cung cấp cho một sản phẩm là mất file in.
//
// Hệ quả của việc khoá theo cặp Product ID + Seller SKU (giữ nguyên từ sprint trước):
//   - Upload / Replace ⇒ mọi đơn cùng cặp khoá thấy file mới ngay, không sao chép dữ liệu.
//   - Delete           ⇒ mọi đơn cùng cặp khoá quay về "Design Missing" ngay.
//   - Đơn MỚI đồng bộ về ⇒ tự nhận design đã có.
//   - Đơn ĐÃ GỬI sản xuất không đổi: file đã gửi được chụp ở `fulfillment_order_items.print_files`.
//
// ⚠️ Đánh đổi giữ nguyên: design thuộc về SẢN PHẨM nên không đặt được file riêng cho một đơn
// cá biệt (TikTok POD có `is_pod_customized`/`pod_info_id` cho hàng personalise — chưa dùng).
// Muốn hỗ trợ thì thêm bảng ghi đè theo đơn, KHÔNG quay lại mô hình cũ.
// ---------------------------------------------------------------------------

model FulfillmentProductDesign {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// 🔴 KHOÁ NGHIỆP VỤ — cùng cặp khoá định danh Product Mapping, nhưng ĐỘC LẬP với nó.
  ///
  /// Nullable ở tầng DB có chủ đích (giống `FulfillmentProductMapping`): bản ghi cũ chuyển
  /// từ mô hình theo mapping có thể thiếu khoá nếu mapping nguồn đã bị xoá. Thiếu khoá ⇒
  /// không ghép được đơn nào; CHECK `NOT VALID` chặn mọi bản ghi MỚI thiếu khoá.
  tiktokProductId String? @map("tiktok_product_id") @db.VarChar(64)
  sellerSku       String? @map("seller_sku") @db.VarChar(255)

  /// Vị trí in: FRONT | BACK | LEFT | RIGHT | SLEEVE | LABEL.
  ///
  /// 🔴 Bảng con thay vì hai cột `front_design_file_id` / `back_design_file_id`: enum đã có
  /// 6 vị trí và `placement_map` vốn ánh xạ vị trí bất kỳ sang khoá của nhà cung cấp. Hai cột
  /// cứng sẽ phải đổi schema ngay lần đầu ai đó bật SLEEVE.
  placement PodDesignPlacement

  /// File thật nằm ở Storage Module — bảng này KHÔNG lặp lại key/URL/mime/size.
  storageFileId String @map("storage_file_id") @db.Uuid

  /// Số lần design ở vị trí này bị thay (1 = upload lần đầu).
  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  /// Restrict: không cho xoá bản ghi file khi vẫn còn design tham chiếu.
  storageFile StorageFile @relation("FulfillmentProductDesignFile", fields: [storageFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Mỗi (sản phẩm × vị trí in) chỉ có MỘT design đang hiệu lực.
  /// (Bản đã xoá mềm vẫn nằm lại — xem chỉ mục từng phần ở migration.)
  @@index([organizationId])
  @@index([organizationId, tiktokProductId, sellerSku])
  @@map("fulfillment_product_designs")
}

// ===========================================================================
// CORE MODULE — STORAGE
//
// Bảng trung tâm lưu metadata MỌI file của hệ thống (Employee Avatar, POD Design,
// Shipping Label, Excel Import/Export...). Bytes nằm ở object storage (Cloudflare R2);
// bảng này chỉ giữ metadata + khoá đối tượng để truy xuất/xoá.
//
// Module nghiệp vụ KHÔNG tự lưu đường dẫn file — chỉ tham chiếu `storage_files.id`.
// ===========================================================================

/// Module nghiệp vụ sở hữu file — phục vụ thống kê dung lượng và dọn dẹp theo module.
/// Thêm module mới chỉ cần thêm giá trị enum (một dòng migration).
enum StorageModuleName {
  POD_TIKTOK
  EMPLOYEE
  ORDER
  ACCOUNT
  REPORT
  COMMON

  @@map("storage_module_name")
}

/// Loại thực thể mà file gắn vào. Dùng cặp (reference_type, reference_id) để tra ngược.
/// Khai báo SẴN các loại đã thấy trong lộ trình để mở rộng không cần migration.
enum StorageReferenceType {
  /// ⚠️ CŨ — design gắn theo TỪNG line item của đơn. Giữ lại để file cũ vẫn tra được nguồn;
  /// luồng mới dùng `FULFILLMENT_MAPPING_DESIGN`.
  POD_ORDER_ITEM_DESIGN
  /// Design gắn theo **Product Mapping** — một file dùng cho mọi đơn cùng SKU.
  FULFILLMENT_MAPPING_DESIGN
  /// Ảnh/video thuộc một Image Template của module Listing (Sprint 3).
  POD_LISTING_ASSET
  EMPLOYEE_AVATAR
  EMPLOYEE_CCCD
  ACCOUNT_DOCUMENT
  ORDER_ATTACHMENT
  SHIPPING_LABEL
  EXCEL_IMPORT
  EXCEL_EXPORT
  OTHER

  @@map("storage_reference_type")
}

/// Nhà cung cấp lưu trữ đang giữ file. Lưu theo TỪNG file để có thể chuyển provider
/// dần dần mà file cũ vẫn truy xuất được.
enum StorageProviderName {
  CLOUDFLARE_R2
  LOCAL_DISK
  AWS_S3
  MINIO
  GCS

  @@map("storage_provider_name")
}

model StorageFile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Module sở hữu file.
  module StorageModuleName

  /// Cặp tham chiếu ngược về thực thể nghiệp vụ (vd POD_ORDER_ITEM_DESIGN + orderItemId).
  /// `referenceId` để NULL với file không gắn thực thể cụ thể (vd file export tạm).
  referenceType StorageReferenceType @map("reference_type")
  referenceId   String?              @map("reference_id") @db.Uuid

  /// Thư mục logic trong bucket (không gồm tên file), vd `designs/{org}/{order}/{item}`.
  folder    String @db.VarChar(512)
  /// Khoá đối tượng ĐẦY ĐỦ trong bucket — dùng để đọc/xoá. UNIQUE toàn hệ thống.
  objectKey String @unique @map("object_key") @db.VarChar(1024)

  /// Tên file gốc người dùng chọn (chỉ để hiển thị/tải về).
  originalName String @map("original_name") @db.VarChar(255)
  /// Tên file thực tế trên storage (UUID + phần mở rộng) — KHÔNG dùng tên người dùng.
  storedName   String @map("stored_name") @db.VarChar(255)
  /// Phần mở rộng đã chuẩn hoá, không có dấu chấm (png, jpg, pdf...).
  extension    String @db.VarChar(20)
  mimeType     String @map("mime_type") @db.VarChar(150)
  /// Kích thước (byte).
  fileSize     Int    @map("file_size")

  /// URL công khai (nếu bucket cho phép đọc công khai). NULL khi bucket private.
  publicUrl String? @map("public_url") @db.VarChar(2048)

  /// Provider đang giữ file — cho phép chuyển dần sang provider khác.
  provider StorageProviderName @default(CLOUDFLARE_R2)
  /// Tên bucket tại thời điểm upload (đổi bucket vẫn truy xuất được file cũ).
  bucket   String?             @db.VarChar(255)
  /// Checksum nội dung (sha256 hex) — phát hiện trùng file và kiểm tra toàn vẹn.
  checksum String?             @db.Char(64)

  uploadedBy String   @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @map("uploaded_at") @db.Timestamptz(6)

  // Audit + soft delete (ADR-015). Soft delete để có thể đối soát file đã xoá.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploader     User         @relation("StorageUploader", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// ⚠️ CŨ — design gắn theo line item của đơn. Giữ để dữ liệu lịch sử vẫn tra được.
  podDesigns           PodOrderItemDesign[]
  /// File in gắn theo **Product Mapping** — nguồn design hiện hành.
  productDesigns       FulfillmentProductDesign[]      @relation("FulfillmentProductDesignFile")
  /// Ảnh trong một bộ ảnh mẫu (mockup) của Image Template.
  imageTemplateItems   PodImageTemplateItem[]
  /// File dùng làm ảnh riêng của một tổ hợp SKU trong SKU Template.
  skuTemplateItems     PodSkuTemplateItem[]            @relation("PodSkuTemplateItemImage")
  sessionProductImages PodListingSessionProductImage[] @relation("PodListingSessionProductImageFile")

  @@index([organizationId])
  @@index([organizationId, module])
  @@index([referenceType, referenceId])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("storage_files")
}

// ===========================================================================
// MODULE POD — TIKTOK PAYOUT (Finance API)
//
// Nguồn dữ liệu (docs/pod-tiktok/10-payout-report.md):
//   1. GET /finance/202605/payments                                  → PodTiktokPayment
//   2. GET /finance/202309/statements                                → PodTiktokStatement
//   3. GET /finance/202501/statements/{id}/statement_transactions    → PodTiktokStatementTransaction
//
// 🔴 KHÔNG tự tính payout từ bảng đơn hàng. Toàn bộ số tiền là giá trị TikTok trả về,
// chỉ lưu lại nguyên trạng rồi báo cáo bằng SQL aggregate.
//
// Quan hệ nghiệp vụ:
//   Payment (tiền về ngân hàng) 1 ── n Statement (đối soát theo ngày) 1 ── n Transaction (đơn)
// Một payment có thể gộp NHIỀU statement (khi số tiền quá nhỏ) — theo Finance API overview.
// ===========================================================================

/// PodTiktokPayment — một lần TikTok chi trả về tài khoản ngân hàng của seller.
/// Đây là ĐỊNH NGHĨA "Payout" dùng cho Report Card và cột Total Payout.
model PodTiktokPayment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  /// `payments[].id` — ID chi trả phía TikTok. UNIQUE theo Organization (chống ghi trùng).
  tiktokPaymentId String          @map("tiktok_payment_id") @db.VarChar(64)
  /// `payments[].status` — PROCESSING | PAID | FAILED.
  status          PodPayoutStatus

  /// `amount` — số tiền chi trả CUỐI CÙNG (sau quy đổi ngoại tệ). Đây là số dùng để cộng tổng.
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.VarChar(10)

  /// `settlement_amount` — số tiền đối soát TRƯỚC quy đổi ngoại tệ.
  settlementAmount     Decimal? @map("settlement_amount") @db.Decimal(18, 4)
  /// `payment_amount_before_exchange` — số tiền chi trả trước quy đổi.
  amountBeforeExchange Decimal? @map("amount_before_exchange") @db.Decimal(18, 4)
  /// `exchange_rate` — tỷ giá, 6 chữ số thập phân theo tài liệu.
  exchangeRate         Decimal? @map("exchange_rate") @db.Decimal(18, 6)
  /// `reserve_amount` — chỉ có ở bản 202309; bản 202605 không trả.
  reserveAmount        Decimal? @map("reserve_amount") @db.Decimal(18, 4)

  /// `bank_account` — TikTok đã che, chỉ còn 4 số cuối. Lưu nguyên trạng.
  bankAccountMasked String? @map("bank_account_masked") @db.VarChar(64)

  /// `create_time` — thời điểm khởi tạo chi trả (Unix seconds). Đây là TRỤC LỌC của báo cáo.
  paymentCreateTime BigInt    @map("payment_create_time")
  /// Bản `timestamptz` của `create_time` — để lọc theo khoảng ngày bằng SQL.
  paymentCreatedAt  DateTime  @map("payment_created_at") @db.Timestamptz(6)
  /// `paid_time` — thời điểm chuyển tiền thành công. NULL khi chưa chi (TikTok trả 0).
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)

  /// sha256 canonical của payload — bỏ qua ghi đè khi không có gì đổi (giống luồng Order).
  payloadHash  String   @map("payload_hash") @db.Char(64)
  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account    PodTiktokAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop       PodTiktokShop        @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  statements PodTiktokStatement[]

  @@unique([organizationId, tiktokPaymentId])
  @@index([organizationId, paymentCreatedAt])
  @@index([organizationId, status])
  @@index([accountId, paymentCreatedAt])
  @@index([shopId])
  @@map("pod_tiktok_payments")
}

/// PodTiktokStatement — bảng đối soát theo NGÀY của một shop (TikTok sinh lúc 00:00 UTC).
/// Là cầu nối Payment ↔ Order: mang `payment_id` và chứa các transaction cấp đơn.
model PodTiktokStatement {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  /// `statements[].id`.
  tiktokStatementId String  @map("tiktok_statement_id") @db.VarChar(64)
  /// `statements[].payment_id` — khoá liên kết sang `pod_tiktok_payments`.
  /// Lưu dạng chuỗi (không FK) vì statement có thể về TRƯỚC payment tương ứng.
  tiktokPaymentId   String? @map("tiktok_payment_id") @db.VarChar(64)
  /// FK nội bộ, gán khi payment tương ứng đã có trong DB. NULL = chưa đối soát được.
  paymentId         String? @map("payment_id") @db.Uuid

  /// `payment_status` — trạng thái chi trả của statement này.
  paymentStatus PodPayoutStatus

  /// `statement_time` (Unix seconds) + bản timestamptz để lọc bằng SQL.
  statementTime BigInt    @map("statement_time")
  statementAt   DateTime  @map("statement_at") @db.Timestamptz(6)
  /// `payment_time`.
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)

  currency           String   @db.VarChar(10)
  /// `settlement_amount` — số tiền đối soát của ngày.
  settlementAmount   Decimal  @map("settlement_amount") @db.Decimal(18, 4)
  revenueAmount      Decimal? @map("revenue_amount") @db.Decimal(18, 4)
  feeAmount          Decimal? @map("fee_amount") @db.Decimal(18, 4)
  adjustmentAmount   Decimal? @map("adjustment_amount") @db.Decimal(18, 4)
  netSalesAmount     Decimal? @map("net_sales_amount") @db.Decimal(18, 4)
  shippingCostAmount Decimal? @map("shipping_cost_amount") @db.Decimal(18, 4)

  /// Đã kéo xong transaction cấp đơn của statement này chưa (NULL = chưa).
  /// Statement đã SETTLED thì transaction bất biến ⇒ chỉ kéo MỘT lần.
  transactionsSyncedAt DateTime? @map("transactions_synced_at") @db.Timestamptz(6)
  /// Số đơn (order_id duy nhất, dòng type=ORDER) — denormalize để báo cáo khỏi join sâu.
  orderCount           Int       @default(0) @map("order_count")

  payloadHash  String   @map("payload_hash") @db.Char(64)
  lastSyncedAt DateTime @map("last_synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account      PodTiktokAccount                @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop         PodTiktokShop                   @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  payment      PodTiktokPayment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  transactions PodTiktokStatementTransaction[]

  @@unique([organizationId, tiktokStatementId])
  @@index([organizationId, statementAt])
  @@index([organizationId, tiktokPaymentId])
  @@index([paymentId])
  @@index([accountId, statementAt])
  @@index([shopId])
  @@index([transactionsSyncedAt])
  @@map("pod_tiktok_statements")
}

/// PodTiktokStatementTransaction — một dòng giao dịch trong statement (cấp ĐƠN HÀNG).
/// Đây là nguồn DUY NHẤT cho cột "Order Count" của báo cáo Payout.
model PodTiktokStatementTransaction {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid
  statementId    String @map("statement_id") @db.Uuid

  /// `transactions[].id`.
  tiktokTransactionId String             @map("tiktok_transaction_id") @db.VarChar(64)
  /// `transactions[].type` — ORDER | ADJUSTMENT | RESERVE | OTHER.
  type                PodStatementTxType

  /// ID đơn đã chuẩn hoá: `order_id` ?? `adjustment_order_id` ?? `associated_order_id`.
  /// CHỈ dòng `type = ORDER` được dùng để đếm số đơn (dòng RESERVE trỏ lại chính đơn đó).
  tiktokOrderId   String? @map("tiktok_order_id") @db.VarChar(64)
  adjustmentId    String? @map("adjustment_id") @db.VarChar(64)
  reserveId       String? @map("reserve_id") @db.VarChar(64)
  /// `order_create_time` (Unix seconds).
  orderCreateTime BigInt? @map("order_create_time")

  currency           String   @db.VarChar(10)
  /// `settlement_amount` của dòng.
  settlementAmount   Decimal  @map("settlement_amount") @db.Decimal(18, 4)
  revenueAmount      Decimal? @map("revenue_amount") @db.Decimal(18, 4)
  feeTaxAmount       Decimal? @map("fee_tax_amount") @db.Decimal(18, 4)
  shippingCostAmount Decimal? @map("shipping_cost_amount") @db.Decimal(18, 4)
  adjustmentAmount   Decimal? @map("adjustment_amount") @db.Decimal(18, 4)
  reserveAmount      Decimal? @map("reserve_amount") @db.Decimal(18, 4)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account   PodTiktokAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop      PodTiktokShop      @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  statement PodTiktokStatement @relation(fields: [statementId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([organizationId, tiktokTransactionId])
  @@index([statementId])
  @@index([organizationId, tiktokOrderId])
  @@index([accountId, type])
  @@index([shopId])
  @@map("pod_tiktok_statement_transactions")
}

// ===========================================================================
// MODULE FULFILLMENT — gửi đơn sang xưởng in (POD fulfillment provider)
//
// Nhà cung cấp đầu tiên: MangoTeePrints (docs.mangoteeprints.com, MangoV3 Public API).
// Thiết kế đa nhà cung cấp ngay từ đầu: mọi bảng đều mang `provider`, phần đặc thù
// nhà cung cấp nằm ở `providerPayload`/`rawRequest`/`rawResponse` (JSON) thay vì cột riêng.
// Thêm Printify/Printful sau ⇒ viết thêm một client + mapper, KHÔNG đổi lược đồ.
//
// Chi tiết: docs/fulfillment/README.md
// ===========================================================================

/// Nhà cung cấp fulfillment. Hiện chỉ MANGOTEE được implement.
enum FulfillmentProvider {
  MANGO
  PRINTIFY
  PRINTFUL
  /// Nhà cung cấp tự khai báo (tích hợp riêng). Giữ chỗ để thêm provider không nằm
  /// trong danh sách dựng sẵn mà không phải đổi enum lần nữa.
  CUSTOM

  @@map("fulfillment_provider")
}

/// Trạng thái fulfillment CHUẨN HOÁ của NCMedia (không phải enum của nhà cung cấp).
///
/// 🔴 Trạng thái gốc của nhà cung cấp luôn được lưu NGUYÊN VĂN ở `providerStatus`.
/// Cột này chỉ là ánh xạ để UI/thống kê dùng chung giữa nhiều nhà cung cấp —
/// giá trị lạ của provider sẽ map về `UNKNOWN` chứ không làm vỡ đồng bộ.
enum FulfillmentStatus {
  /// Chưa gửi đi (bản ghi vừa tạo hoặc đã reset để gửi lại).
  DRAFT
  /// Đang gọi API tạo đơn.
  SUBMITTING
  /// Đã gửi thành công, nhà cung cấp tiếp nhận.
  SUBMITTED
  /// Đang sản xuất.
  IN_PRODUCTION
  /// Tạm giữ (chờ thanh toán/xác nhận).
  ON_HOLD
  /// Đã giao cho đơn vị vận chuyển.
  SHIPPED
  /// Hoàn tất (đã giao tới người nhận).
  DELIVERED
  /// Nhà cung cấp từ chối đơn.
  REJECTED
  /// Đã huỷ.
  CANCELLED
  /// Đã hoàn tiền (một phần hoặc toàn bộ).
  REFUNDED
  /// Gửi thất bại phía NCMedia (lỗi validate/mạng/API) — có thể retry.
  FAILED
  /// Trạng thái provider chưa được ánh xạ (đã lưu nguyên văn ở `providerStatus`).
  UNKNOWN

  @@map("fulfillment_status")
}

/// Loại sự kiện ghi vào nhật ký fulfillment (append-only).
enum FulfillmentEventType {
  CREATE_REQUEST
  CREATE_SUCCESS
  CREATE_FAILED
  STATUS_CHANGED
  SHIPMENT_UPDATED
  SYNC
  CANCEL_REQUEST
  CANCEL_SUCCESS
  CANCEL_FAILED
  RETRY
  WEBHOOK_RECEIVED
  VALIDATION_FAILED

  @@map("fulfillment_event_type")
}

/// Nguồn kích hoạt một hành động fulfillment.
enum FulfillmentTrigger {
  MANUAL
  CRON
  WEBHOOK
  RETRY

  @@map("fulfillment_trigger")
}

// ---------------------------------------------------------------------------
// FulfillmentAccount — cấu hình kết nối tới một nhà cung cấp (theo Organization).
// ---------------------------------------------------------------------------
model FulfillmentAccount {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  provider       FulfillmentProvider

  /// Tên gợi nhớ do người dùng đặt.
  name      String  @db.VarChar(255)
  /// Chỉ MỘT tài khoản mặc định cho mỗi (organization, provider) — xem partial unique index.
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  /// API key đã MÃ HOÁ AES-256-GCM (Mango dùng header `X-API-Key`). KHÔNG expose qua API.
  ///
  /// NULL = dùng key mặc định của hệ thống từ biến môi trường `MANGO_API_KEY`.
  /// Chỉ khai báo ở đây khi cần nhiều tài khoản Mango khác nhau; khi có, key này được ưu tiên.
  apiKeyEnc  String? @map("api_key_enc") @db.Text
  /// 4 ký tự cuối của API key — để người dùng nhận diện mà không lộ khoá.
  apiKeyHint String? @map("api_key_hint") @db.VarChar(8)

  /// Ghi đè base URL (môi trường thử nghiệm). NULL = dùng cấu hình mặc định của hệ thống.
  baseUrlOverride String? @map("base_url_override") @db.VarChar(500)

  /// `production_line_id` mặc định khi tạo đơn (Mango: GET /production-lines).
  defaultProductionLine String? @map("default_production_line") @db.VarChar(64)
  /// `shipping_method` mặc định (Mango enum: standard | priority | express | ...).
  defaultShippingMethod String  @default("standard") @map("default_shipping_method") @db.VarChar(40)
  /// `facility` mặc định (chỉ production line TIKTOK). NULL = để Mango tự chọn (AUTO).
  defaultFacility       String? @map("default_facility") @db.VarChar(40)

  /// Secret dùng để xác thực webhook gọi về (Mango KHÔNG ký payload — xem docs/fulfillment).
  webhookSecretEnc  String? @map("webhook_secret_enc") @db.Text
  /// ID webhook phía nhà cung cấp (Mango: POST /webhooks trả `id`).
  providerWebhookId String? @map("provider_webhook_id") @db.VarChar(64)

  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastErrorAt  DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastErrorMsg String?   @map("last_error_msg") @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders          FulfillmentOrder[]
  productMappings FulfillmentProductMapping[]
  tiktokAccounts  PodTiktokAccount[]          @relation("PodTiktokFulfillmentAccount")
  webhookLogs     FulfillmentWebhookLog[]
  syncLogs        FulfillmentSyncLog[]

  /// Bản sao danh mục của nhà cung cấp (xem `FulfillmentCatalogue`).
  catalogues        FulfillmentCatalogue[]
  catalogueProducts FulfillmentProduct[]
  mappingCandidates FulfillmentMappingCandidate[]

  @@index([organizationId, provider])
  @@index([isActive])
  @@map("fulfillment_accounts")
}

// ---------------------------------------------------------------------------
// FulfillmentProductMapping — SẢN PHẨM POD của tổ chức.
//
// 🔴 DANH TÍNH của một ánh xạ là **(Product ID + Seller SKU)** — không gì khác.
// Không dùng Title, không dùng Variant Name, không dùng Image: ba thứ đó do người bán tự
// đặt, đổi lúc nào cũng được, và hai sản phẩm khác nhau hoàn toàn có thể trùng tên.
// `tiktok_sku_id` KHÔNG còn tham gia ghép (xem `shared/mapping-match.ts`) — giữ lại chỉ để
// đối soát khi cần tra ngược về biến thể phía TikTok.
//
// Hệ quả trực tiếp: mỗi (Product ID + Seller SKU) có **đúng một** bộ Design, một Fulfillment
// SKU, một Provider, một Base Cost. Mọi đơn mang cùng cặp khoá đó — kể cả đơn ngày mai mới
// đồng bộ về — đọc chung bản ghi này, không sao chép, không sinh thêm dữ liệu.
//
// Ràng buộc ở migration `20260826170000_design_by_product_sku`:
//   - UNIQUE TỪNG PHẦN (organization_id, tiktok_product_id, seller_sku) WHERE deleted_at IS NULL
//   - CHECK NOT VALID: hai khoá phải có đủ (bản ghi cũ thiếu khoá được giữ nguyên để không
//     mất dữ liệu, nhưng không ghép được với đơn nào và không sửa được nếu chưa điền đủ)
// ---------------------------------------------------------------------------
model FulfillmentProductMapping {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  provider       FulfillmentProvider

  /// 🔴 KHOÁ NGHIỆP VỤ — cặp này xác định ánh xạ. Bắt buộc khi tạo/sửa qua API.
  ///
  /// Nullable ở tầng DB **có chủ đích**: bản ghi khai từ trước sprint này có thể thiếu một
  /// trong hai. Ép NOT NULL sẽ làm migration chết trên môi trường có dữ liệu như vậy, mà
  /// bịa giá trị thay thế thì còn tệ hơn. Thiếu khoá ⇒ không ghép được đơn nào (xem
  /// `findMappingForItem`) ⇒ hiện lên giao diện là "ánh xạ chưa đủ khoá" để người dùng sửa.
  tiktokProductId String? @map("tiktok_product_id") @db.VarChar(64)
  sellerSku       String? @map("seller_sku") @db.VarChar(255)

  /// ⚠️ THAM CHIẾU, KHÔNG PHẢI KHOÁ GHÉP. Trước sprint này `tiktokSkuId` là khoá ưu tiên số
  /// một; nó bị loại khỏi luật ghép vì một Seller SKU có thể mang nhiều `sku_id` khác nhau
  /// giữa các shop, khiến cùng một sản phẩm bị tách thành nhiều bộ design.
  tiktokSkuId String? @map("tiktok_sku_id") @db.VarChar(64)

  /// SKU biến thể phía nhà cung cấp — giá trị gửi vào `items[].sku` khi tạo đơn.
  providerSku         String  @map("provider_sku") @db.VarChar(255)
  /// ID sản phẩm/biến thể phía nhà cung cấp (tham chiếu, không bắt buộc để tạo đơn).
  providerProductId   String? @map("provider_product_id") @db.VarChar(64)
  providerVariantId   String? @map("provider_variant_id") @db.VarChar(64)
  /// Tên/màu/size để người vận hành đối chiếu khi khai báo.
  providerProductName String? @map("provider_product_name") @db.VarChar(500)
  /// Tên biến thể NGUYÊN VĂN do nhà cung cấp trả về (vd "Black / L"). Lưu để hiển thị
  /// và đối soát; màu/size tách riêng bên dưới phục vụ lọc.
  providerVariantName String? @map("provider_variant_name") @db.VarChar(255)
  providerColor       String? @map("provider_color") @db.VarChar(100)
  providerSize        String? @map("provider_size") @db.VarChar(100)

  /// Giá vốn nhà cung cấp cho SKU này — người vận hành khai khi ánh xạ.
  ///
  /// Nằm ở đây chứ không ở đơn hàng vì giá vốn là thuộc tính của SẢN PHẨM. Lúc gửi sản xuất,
  /// giá trị này được CHÉP sang `fulfillment_order_items.base_cost` làm ảnh chụp bất biến —
  /// đơn đã gửi không được đổi giá vốn khi ánh xạ sửa về sau (ADR-014: Profit tính runtime
  /// từ số liệu tại thời điểm giao dịch).
  baseCost Decimal? @map("base_cost") @db.Decimal(18, 4)

  /// `production_config` của Mango (default | large). NULL = không gửi.
  productionConfig String? @map("production_config") @db.VarChar(40)
  /// Ghi đè production line cho riêng sản phẩm này.
  productionLine   String? @map("production_line") @db.VarChar(64)

  /// Ánh xạ vị trí in: `{ "FRONT": "front", "BACK": "back" }`
  /// (khoá = PodDesignPlacement của NCMedia, giá trị = `print_files[].key` của nhà cung cấp).
  /// NULL = dùng ánh xạ mặc định trong code.
  placementMap Json? @map("placement_map")

  isActive Boolean @default(true) @map("is_active")
  note     String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account      FulfillmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// ⚠️ KHÔNG có quan hệ `designs` ở đây nữa. Design khoá theo (Product ID + Seller SKU) và
  /// ĐỘC LẬP với ánh xạ — xem `FulfillmentProductDesign`. Nối lại quan hệ này là dựng lại
  /// đúng ràng buộc "phải ánh xạ xong mới upload được design" mà sprint này gỡ bỏ.

  @@index([organizationId, provider])
  /// Chỉ mục CHÍNH — đúng khoá ghép, phục vụ mọi lượt đọc design của màn hình đơn.
  @@index([organizationId, tiktokProductId, sellerSku])
  @@index([organizationId, sellerSku])
  @@index([accountId])
  @@map("fulfillment_product_mappings")
}

// ===========================================================================
// BẢN SAO DANH MỤC NHÀ CUNG CẤP (Catalogue → Product → Variant)
//
// 🔴 Ba bảng dưới đây là **BẢN SAO CHỈ-ĐỌC** của danh mục phía nhà cung cấp, KHÔNG phải sản
// phẩm của tổ chức. Nguồn sự thật vẫn là nhà cung cấp; ở đây chỉ là ảnh chụp được làm mới
// bởi Sync Job.
//
// Vì sao phải có: trước đây mỗi lần mở màn hình Product Mapping là một loạt lời gọi thẳng
// sang Mango API (danh mục vài nghìn sản phẩm × mỗi sản phẩm một lần gọi variations). Chậm,
// phụ thuộc mạng, và hỏng hoàn toàn khi nhà cung cấp lỗi — trong khi dữ liệu này gần như
// tĩnh. Nay: Mango API → Sync Job → Database → UI. Giao diện KHÔNG gọi Mango nữa.
//
// Vì sao KHÔNG dùng Redis như trước: cache 5 phút chỉ giấu được độ trễ, không giải quyết
// được ba việc mà tính năng thực sự cần — tìm kiếm/phân trang phía server, ánh xạ tự động
// (phải quét toàn bộ danh mục), và hoạt động được khi nhà cung cấp đang lỗi.
//
// Tenant (ADR-003): tuy danh mục là dữ liệu của nhà cung cấp, mỗi tổ chức kết nối bằng API
// key riêng và **thấy danh mục riêng**, nên đây là bảng NGHIỆP VỤ và có `organization_id`.
// ===========================================================================

/// Trạng thái một bản ghi danh mục sau lần đồng bộ gần nhất.
enum FulfillmentCatalogItemStatus {
  /// Nhà cung cấp còn trả về ở lần đồng bộ gần nhất.
  ACTIVE
  /// Nhà cung cấp trả về nhưng đánh dấu ngừng bán.
  INACTIVE
  /// KHÔNG còn xuất hiện ở lần đồng bộ gần nhất — giữ lại để ánh xạ cũ không trỏ vào hư không.
  ARCHIVED

  @@map("fulfillment_catalog_item_status")
}

// ---------------------------------------------------------------------------
// FulfillmentCatalogue — nhóm sản phẩm phía nhà cung cấp.
//
// ⚠️ Mango KHÔNG có endpoint `/catalogs` (đã dò thực tế: trả 404). Danh mục được SUY RA từ
// cặp `catalog_id` / `catalog_name` gắn trên mỗi sản phẩm của `GET /products`. Đây là lý do
// bảng này không có `raw_data` của riêng nó cho Mango — không có payload nào để lưu; trường
// vẫn tồn tại vì nhà cung cấp khác (Printify/Printful) có endpoint danh mục riêng.
// ---------------------------------------------------------------------------
model FulfillmentCatalogue {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  /// Tài khoản nhà cung cấp đã đọc ra danh mục này (yêu cầu gọi là `provider_id`).
  accountId      String              @map("account_id") @db.Uuid
  provider       FulfillmentProvider

  /// ID danh mục phía nhà cung cấp — nửa khoá định danh.
  externalCatalogueId String                       @map("external_catalogue_id") @db.VarChar(128)
  name                String                       @db.VarChar(500)
  status              FulfillmentCatalogItemStatus @default(ACTIVE)

  /// Payload nguyên văn của nhà cung cấp. NULL khi danh mục được suy ra từ sản phẩm.
  rawData  Json?    @map("raw_data")
  /// Thời điểm bản ghi này được nhà cung cấp xác nhận còn tồn tại.
  syncedAt DateTime @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account  FulfillmentAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products FulfillmentProduct[]

  /// Một danh mục của nhà cung cấp chỉ xuất hiện MỘT lần trong mỗi tài khoản.
  @@unique([accountId, externalCatalogueId])
  @@index([organizationId, provider])
  @@index([accountId, status])
  @@map("fulfillment_catalogues")
}

// ---------------------------------------------------------------------------
// FulfillmentProduct — sản phẩm trong danh mục nhà cung cấp.
//
// ⚠️ ĐỪNG NHẦM với `FulfillmentProductMapping`: bảng đó là KHAI BÁO của tổ chức
// (TikTok product ⇄ SKU nhà cung cấp); bảng này là DANH MỤC của nhà cung cấp.
// ---------------------------------------------------------------------------
model FulfillmentProduct {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  provider       FulfillmentProvider
  /// NULL = nhà cung cấp không gắn sản phẩm này vào danh mục nào.
  catalogueId    String?             @map("catalogue_id") @db.Uuid

  externalProductId String  @map("external_product_id") @db.VarChar(128)
  name              String  @db.VarChar(1000)
  sku               String? @db.VarChar(255)
  /// Ảnh đại diện (ảnh đầu tiên nhà cung cấp trả về).
  image             String? @db.VarChar(2048)

  basePrice       String? @map("base_price") @db.VarChar(64)
  currency        String? @db.VarChar(10)
  /// Số biến thể nhà cung cấp báo — đối chiếu với số thực sự đồng bộ được để phát hiện thiếu.
  variationsCount Int?    @map("variations_count")

  status FulfillmentCatalogItemStatus @default(ACTIVE)

  /// Payload nguyên văn — giữ để không mất field mới của nhà cung cấp và để điều tra lệch dữ liệu.
  rawData  Json?    @map("raw_data")
  syncedAt DateTime @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  account   FulfillmentAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  catalogue FulfillmentCatalogue? @relation(fields: [catalogueId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  variants  FulfillmentVariant[]

  @@unique([accountId, externalProductId])
  @@index([organizationId, provider])
  @@index([accountId, status])
  @@index([catalogueId])
  /// Ánh xạ tự động tra theo SKU sản phẩm (tầng 1 của luật tìm kiếm).
  @@index([accountId, sku])
  @@map("fulfillment_products")
}

// ---------------------------------------------------------------------------
// FulfillmentVariant — biến thể; `sku` chính là giá trị gửi trong `items[].sku` khi tạo đơn.
// ---------------------------------------------------------------------------
model FulfillmentVariant {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  provider       FulfillmentProvider
  productId      String              @map("product_id") @db.Uuid

  externalVariantId String  @map("external_variant_id") @db.VarChar(128)
  /// 🔴 Giá trị THỰC SỰ gửi sang nhà cung cấp khi tạo đơn.
  sku               String  @db.VarChar(255)
  name              String  @db.VarChar(500)
  color             String? @db.VarChar(100)
  size              String? @db.VarChar(100)
  /// Giữ dạng chuỗi ĐÚNG như nhà cung cấp trả về — không ép sang số để khỏi mất định dạng/độ chính xác.
  price             String? @db.VarChar(64)

  status FulfillmentCatalogItemStatus @default(ACTIVE)

  rawData  Json?    @map("raw_data")
  syncedAt DateTime @map("synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product FulfillmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, externalVariantId])
  @@index([organizationId, provider])
  @@index([productId, status])
  /// 🔴 Chỉ mục CHÍNH của ánh xạ tự động: tra Seller SKU của TikTok trên SKU biến thể.
  @@index([accountId, sku])
  @@map("fulfillment_variants")
}

// ---------------------------------------------------------------------------
// FulfillmentMappingCandidate — KẾT QUẢ của một lần thử ánh xạ tự động.
//
// 🔴 Vì sao cần bảng riêng thay vì nhét vào Product Mapping: khi hệ thống KHÔNG tự ánh xạ
// được, không có bản ghi Product Mapping nào để ghi trạng thái vào. Ba kết cục "đã tự ánh
// xạ" / "cần chọn tay vì nhiều ứng viên" / "không tìm thấy" phải phân biệt được, vì chúng
// dẫn tới ba hành động khác nhau của người vận hành.
//
// Bảng này KHÔNG phải bản sao của Product Mapping và không tham gia luồng gửi đơn: nó chỉ
// trả lời "lần rà gần nhất tìm được gì cho cặp khoá này", cộng danh sách ứng viên để màn
// hình Map Product mở ra là đã lọc sẵn thay vì bắt người dùng dò từ đầu.
//
// Khoá trùng với danh tính của Product Mapping: (organization, Product ID, Seller SKU).
// ---------------------------------------------------------------------------

/// Kết cục của một lần ánh xạ tự động.
enum FulfillmentAutoMapStatus {
  /// Tìm được DUY NHẤT một ứng viên ⇒ đã tạo Product Mapping.
  AUTO_MAPPED
  /// Nhiều ứng viên ⇒ KHÔNG tự ánh xạ (ánh xạ sai còn tệ hơn không ánh xạ).
  NEED_MANUAL
  /// Không có ứng viên nào.
  NOT_FOUND
  /// Chưa rà được: tài khoản TikTok chưa gán nhà cung cấp, hoặc danh mục chưa đồng bộ lần nào.
  SKIPPED

  @@map("fulfillment_auto_map_status")
}

/// Tầng nào của luật tìm kiếm đã cho ra kết quả — phục vụ đối soát chất lượng ánh xạ tự động.
enum FulfillmentAutoMapTier {
  SELLER_SKU
  PRODUCT_TITLE
  VARIANT
  CATALOGUE

  @@map("fulfillment_auto_map_tier")
}

model FulfillmentMappingCandidate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  accountId      String @map("account_id") @db.Uuid

  /// Khoá nghiệp vụ của sản phẩm TikTok — trùng danh tính của Product Mapping.
  tiktokProductId String @map("tiktok_product_id") @db.VarChar(64)
  sellerSku       String @map("seller_sku") @db.VarChar(255)

  status         FulfillmentAutoMapStatus
  /// Tầng cho ra kết quả. NULL khi không tìm thấy gì.
  tier           FulfillmentAutoMapTier?
  /// Số ứng viên tìm được (0 khi NOT_FOUND, 1 khi AUTO_MAPPED, >1 khi NEED_MANUAL).
  candidateCount Int                      @default(0) @map("candidate_count")

  /// Tối đa `AUTO_MAP_MAX_CANDIDATES` ứng viên hàng đầu:
  /// `[{ productId, externalProductId, productName, variantId, externalVariantId, sku, variantName }]`
  /// Dùng để màn hình Map Product mở ra đã lọc sẵn. KHÔNG dùng để gửi đơn.
  candidates Json? @map("candidates")

  /// Product Mapping đã được tạo tự động (chỉ có với AUTO_MAPPED).
  mappingId String? @map("mapping_id") @db.Uuid

  resolvedAt DateTime @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account FulfillmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Mỗi cặp khoá chỉ giữ KẾT QUẢ GẦN NHẤT — không tích luỹ lịch sử rà soát.
  @@unique([organizationId, tiktokProductId, sellerSku])
  @@index([organizationId, status])
  @@index([accountId])
  @@map("fulfillment_mapping_candidates")
}

// ---------------------------------------------------------------------------
// FulfillmentOrder — một lần gửi đơn POD sang nhà cung cấp.
// ---------------------------------------------------------------------------
model FulfillmentOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  provider       FulfillmentProvider

  /// Đơn POD TikTok nguồn. UNIQUE theo (podOrderId, provider): mỗi đơn chỉ gửi MỘT lần
  /// tới mỗi nhà cung cấp — hàng rào chống tạo trùng ở tầng DB.
  podOrderId String @map("pod_order_id") @db.Uuid

  /// `order_id` do NCMedia sinh và gửi sang nhà cung cấp — Mango yêu cầu DUY NHẤT
  /// và trả lỗi nếu trùng ⇒ chính là khoá idempotency của luồng tạo đơn.
  externalOrderId String @map("external_order_id") @db.VarChar(40)

  /// ID đơn phía nhà cung cấp (Mango: `data.id`).
  providerOrderId   String? @map("provider_order_id") @db.VarChar(64)
  /// `order_fulfill_id` — mã đơn ở xưởng sản xuất.
  providerFulfillId String? @map("provider_fulfill_id") @db.VarChar(64)

  status         FulfillmentStatus @default(DRAFT)
  /// Trạng thái NGUYÊN VĂN của nhà cung cấp (Mango: new_order, in_production, shipped...).
  providerStatus String?           @map("provider_status") @db.VarChar(64)

  /// Thông số đã dùng khi tạo đơn (ghi lại để đối soát khi cấu hình đổi về sau).
  productionLine String? @map("production_line") @db.VarChar(64)
  shippingMethod String? @map("shipping_method") @db.VarChar(40)
  facility       String? @db.VarChar(40)
  speedType      String? @map("speed_type") @db.VarChar(40)

  /// Vận chuyển (từ Get Order Detail hoặc webhook `order.shipment`).
  trackingNumber String? @map("tracking_number") @db.VarChar(128)
  trackingStatus String? @map("tracking_status") @db.VarChar(64)
  trackingUrl    String? @map("tracking_url") @db.VarChar(1024)
  carrier        String? @db.VarChar(100)
  labelUrl       String? @map("label_url") @db.VarChar(1024)

  /// Chi phí nhà cung cấp báo (Get Order Detail).
  subtotal    Decimal? @db.Decimal(18, 4)
  shippingFee Decimal? @map("shipping_fee") @db.Decimal(18, 4)
  tax         Decimal? @db.Decimal(18, 4)
  total       Decimal? @db.Decimal(18, 4)
  currency    String?  @db.VarChar(10)

  /// 🔴 Payload GỐC của lần tạo đơn gần nhất — bắt buộc để đối soát khi có tranh chấp.
  /// PII người nhận đã được che trước khi lưu (xem `FulfillmentMangoMapper`).
  rawRequest  Json? @map("raw_request")
  rawResponse Json? @map("raw_response")

  /// Lỗi gần nhất (bản tóm tắt; chi tiết đầy đủ ở `fulfillment_error_logs`).
  lastErrorCode    String? @map("last_error_code") @db.VarChar(64)
  lastErrorMessage String? @map("last_error_message") @db.VarChar(2000)
  /// `request_id` của nhà cung cấp — cần khi mở ticket hỗ trợ.
  lastRequestId    String? @map("last_request_id") @db.VarChar(64)

  /// Số lần đã thử gửi (mỗi lần Fulfill/Retry +1).
  attemptCount Int       @default(0) @map("attempt_count")
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  /// Thời điểm đơn hoàn tất tại nhà cung cấp (chuyển sang DELIVERED). Ghi MỘT LẦN,
  /// không ghi đè khi trạng thái dao động — mốc hoàn tất phải ổn định để đối soát.
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account      FulfillmentAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  podOrder     PodOrder                @relation(fields: [podOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items        FulfillmentOrderItem[]
  histories    FulfillmentHistory[]
  errorLogs    FulfillmentErrorLog[]
  webhookLogs  FulfillmentWebhookLog[]

  @@unique([podOrderId, provider])
  @@unique([organizationId, externalOrderId])
  @@index([organizationId, status])
  @@index([accountId])
  @@index([providerOrderId])
  @@index([lastSyncedAt])
  @@map("fulfillment_orders")
}

// ---------------------------------------------------------------------------
// FulfillmentOrderItem — một dòng sản phẩm đã gửi sang nhà cung cấp.
// ---------------------------------------------------------------------------
model FulfillmentOrderItem {
  id                 String @id @default(uuid()) @db.Uuid
  organizationId     String @map("organization_id") @db.Uuid
  fulfillmentOrderId String @map("fulfillment_order_id") @db.Uuid

  /// Line item POD nguồn (giữ liên kết ngược để tra design/sản phẩm).
  podOrderItemId String? @map("pod_order_item_id") @db.Uuid

  /// SKU đã gửi (`items[].sku`) + số lượng.
  providerSku String @map("provider_sku") @db.VarChar(255)
  quantity    Int

  /// `item_id` do nhà cung cấp sinh/nhận.
  providerItemId   String? @map("provider_item_id") @db.VarChar(64)
  productionConfig String? @map("production_config") @db.VarChar(40)

  /// Ảnh chụp danh sách file in đã gửi: `[{ key, url }]`. Giữ nguyên để đối soát về sau
  /// (design có thể bị thay/xoá, bản ghi này phải bất biến).
  printFiles Json? @map("print_files")

  /// Giá vốn nhà cung cấp báo về (Get Order Detail).
  baseCost Decimal? @map("base_cost") @db.Decimal(18, 4)
  color    String?  @db.VarChar(100)
  size     String?  @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  podOrderItem     PodOrderItem?    @relation(fields: [podOrderItemId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([fulfillmentOrderId])
  @@index([organizationId])
  @@index([podOrderItemId])
  @@map("fulfillment_order_items")
}

// ---------------------------------------------------------------------------
// FulfillmentHistory — nhật ký APPEND-ONLY của mọi thao tác/chuyển trạng thái.
// 🔴 KHÔNG BAO GIỜ ghi đè hay xoá: đây là bằng chứng đối soát với xưởng in.
// ---------------------------------------------------------------------------
model FulfillmentHistory {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  fulfillmentOrderId String               @map("fulfillment_order_id") @db.Uuid
  eventType          FulfillmentEventType @map("event_type")
  trigger            FulfillmentTrigger

  /// Chuyển trạng thái (nếu có).
  fromStatus     FulfillmentStatus? @map("from_status")
  toStatus       FulfillmentStatus? @map("to_status")
  /// Trạng thái nguyên văn của nhà cung cấp tại thời điểm ghi.
  providerStatus String?            @map("provider_status") @db.VarChar(64)

  success Boolean @default(true)
  message String? @db.VarChar(2000)
  /// Dữ liệu kèm theo (payload webhook, tóm tắt request/response, thay đổi tracking...).
  payload Json?

  /// Thời lượng thao tác (ms) — theo dõi hiệu năng gọi API.
  durationMs Int?    @map("duration_ms")
  requestId  String? @map("request_id") @db.VarChar(64)

  /// NULL = do hệ thống (cron/webhook); có giá trị = người dùng thao tác.
  performedBy String?  @map("performed_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fulfillmentOrder FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([fulfillmentOrderId, createdAt])
  @@index([organizationId, createdAt])
  @@index([eventType])
  @@map("fulfillment_histories")
}

// ---------------------------------------------------------------------------
// FulfillmentErrorLog — chi tiết lỗi đầy đủ (HTTP status, code, validation errors).
// Tách khỏi History để History gọn nhẹ mà vẫn giữ được nguyên văn lỗi phục vụ debug.
// ---------------------------------------------------------------------------
model FulfillmentErrorLog {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  fulfillmentOrderId String?             @map("fulfillment_order_id") @db.Uuid
  provider           FulfillmentProvider

  /// Thao tác đang thực hiện khi lỗi (create/sync/cancel/webhook).
  operation  String @db.VarChar(40)
  /// Phân loại để quyết định có retry hay không (xem `FulfillmentErrorClass`).
  errorClass String @map("error_class") @db.VarChar(40)

  httpStatus       Int?    @map("http_status")
  /// `code` trong envelope của nhà cung cấp (VALIDATION_ERROR, NOT_FOUND...).
  providerCode     String? @map("provider_code") @db.VarChar(64)
  message          String  @db.VarChar(2000)
  /// Mảng lỗi validate nguyên văn: `[{ field, message, type }]`.
  validationErrors Json?   @map("validation_errors")
  /// Toàn bộ body lỗi (đã che PII).
  rawError         Json?   @map("raw_error")
  requestId        String? @map("request_id") @db.VarChar(64)

  /// Có thể thử lại được không (mạng/5xx/rate limit = có; validate/auth = không).
  retryable Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fulfillmentOrder FulfillmentOrder? @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([fulfillmentOrderId])
  @@index([errorClass])
  @@map("fulfillment_error_logs")
}

// ---------------------------------------------------------------------------
// FulfillmentWebhookLog — mọi webhook nhận được, lưu RAW trước khi xử lý.
// Lưu trước-xử lý-sau để không mất sự kiện khi xử lý lỗi (dead letter + retry).
// ---------------------------------------------------------------------------
model FulfillmentWebhookLog {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  accountId      String?             @map("account_id") @db.Uuid
  provider       FulfillmentProvider

  /// `event` trong payload (Mango: order.status | order.shipment).
  eventType       String  @map("event_type") @db.VarChar(64)
  /// `order_id` mà NCMedia đã gửi đi — dùng để tìm ngược FulfillmentOrder.
  externalOrderId String? @map("external_order_id") @db.VarChar(64)

  /// Payload NGUYÊN VĂN — không bao giờ sửa.
  payload Json
  /// Header đã lọc (bỏ thông tin nhạy cảm) để truy vết nguồn gọi.
  headers Json?

  /// Kết quả xác thực nguồn gọi. Mango KHÔNG ký payload nên hệ thống dùng secret
  /// riêng trên URL webhook — xem docs/fulfillment/README.md §Webhook.
  verified Boolean @default(false)

  processed    Boolean   @default(false)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(6)
  /// Số lần thử xử lý; vượt ngưỡng ⇒ chuyển sang dead letter.
  attemptCount Int       @default(0) @map("attempt_count")
  deadLetter   Boolean   @default(false) @map("dead_letter")
  errorMessage String?   @map("error_message") @db.VarChar(2000)

  fulfillmentOrderId String? @map("fulfillment_order_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account          FulfillmentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  fulfillmentOrder FulfillmentOrder?   @relation(fields: [fulfillmentOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([provider, eventType])
  @@index([processed, deadLetter])
  @@index([externalOrderId])
  @@index([createdAt])
  @@map("fulfillment_webhook_logs")
}

// ---------------------------------------------------------------------------
// FulfillmentSyncLog — một lượt đồng bộ trạng thái (cron hoặc thủ công).
// ---------------------------------------------------------------------------
model FulfillmentSyncLog {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  accountId      String?             @map("account_id") @db.Uuid
  provider       FulfillmentProvider
  trigger        FulfillmentTrigger

  status String @db.VarChar(20)

  ordersChecked Int @default(0) @map("orders_checked")
  ordersUpdated Int @default(0) @map("orders_updated")
  ordersFailed  Int @default(0) @map("orders_failed")
  apiCalls      Int @default(0) @map("api_calls")

  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")

  errorCode    String? @map("error_code") @db.VarChar(64)
  errorMessage String? @map("error_message") @db.VarChar(2000)
  triggeredBy  String? @map("triggered_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account FulfillmentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, startedAt])
  @@index([status])
  @@map("fulfillment_sync_logs")
}

// ===========================================================================
// MODULE POD — PRODUCT (Sprint 2: Product Synchronization)
//
// Đồng bộ MỘT CHIỀU: TikTok → NCMedia. Sprint này KHÔNG tạo/sửa/xoá/publish
// sản phẩm trên TikTok (xem docs/pod-product/00-product-module-analysis.md).
//
// Nguồn dữ liệu (qua SDK chính thức, module `tiktok-sdk`):
//   · Search Products  (product/202502) → danh sách tóm tắt + phân trang page_token
//   · Get Product      (product/202309) → chi tiết: ảnh, video, brand, category,
//                                          thuộc tính, SKU (giá, tồn kho, biến thể)
//   · Get Categories / Get Category Attributes / Get Brands (product/202309)
//
// 🔴 Public App / nhiều Seller: MỌI bảng đều mang `organization_id` VÀ gắn với một
// shop cụ thể (`shop_id`) — hai seller khác nhau có thể trùng `tiktok_product_id`
// nên khoá duy nhất luôn kèm shop.
//
// Trạng thái của TikTok (product status, audit status) CỐ Ý lưu dạng String:
// TikTok bổ sung giá trị mới bất cứ lúc nào — dùng enum DB là tự chuốc lỗi ghi.
// ===========================================================================

/// Phạm vi một lượt đồng bộ sản phẩm.
/// FULL: quét toàn bộ shop · INCREMENTAL: chỉ sản phẩm đổi sau watermark
/// SINGLE: một sản phẩm cụ thể (người dùng bấm đồng bộ lại ở màn hình chi tiết)
enum PodProductSyncScope {
  FULL
  INCREMENTAL
  SINGLE

  @@map("pod_product_sync_scope")
}

/// Ai kích hoạt lượt đồng bộ.
enum PodProductSyncTrigger {
  MANUAL
  SCHEDULER

  @@map("pod_product_sync_trigger")
}

/// Kết cục của một lượt đồng bộ.
/// PARTIAL: có sản phẩm lỗi nhưng lượt chạy vẫn hoàn tất (fail-soft — P6).
enum PodProductSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED

  @@map("pod_product_sync_status")
}

/// Kết quả xử lý MỘT sản phẩm trong lượt đồng bộ.
enum PodProductSyncAction {
  CREATED
  UPDATED
  SKIPPED
  FAILED

  @@map("pod_product_sync_action")
}

/// Nguồn của payload gốc được lưu lại.
enum PodProductRawSource {
  SEARCH
  DETAIL

  @@map("pod_product_raw_source")
}

// ---------------------------------------------------------------------------
// PodProduct — bản sao (mirror) một sản phẩm TikTok tại NCMedia.
// ---------------------------------------------------------------------------

model PodProduct {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  /// Kết nối (authorization) đã kéo sản phẩm này về.
  accountId      String @map("account_id") @db.Uuid
  /// Shop sở hữu sản phẩm — `product_id` chỉ duy nhất TRONG một shop.
  shopId         String @map("shop_id") @db.Uuid

  /// `data.id` của TikTok.
  tiktokProductId String  @map("tiktok_product_id") @db.VarChar(64)
  title           String? @db.VarChar(1024)
  /// Mô tả là HTML do seller nhập — có thể rất dài.
  description     String? @db.Text

  /// `status` (ACTIVATE / DRAFT / DEACTIVATED / …) và `audit.status`.
  status      String? @db.VarChar(40)
  auditStatus String? @map("audit_status") @db.VarChar(40)

  /// Thương hiệu — vừa giữ FK nội bộ vừa giữ bản sao id/tên để hiển thị được ngay cả
  /// khi bảng brand chưa kịp đồng bộ (hai luồng đồng bộ độc lập nhau).
  brandId       String? @map("brand_id") @db.Uuid
  tiktokBrandId String? @map("tiktok_brand_id") @db.VarChar(64)
  brandName     String? @map("brand_name") @db.VarChar(255)

  /// Danh mục lá + đường dẫn đầy đủ ("Womenswear > Tops > T-Shirts") để hiển thị và
  /// lọc nhanh mà không phải đệ quy cây ở mỗi truy vấn.
  categoryId       String? @map("category_id") @db.Uuid
  tiktokCategoryId String? @map("tiktok_category_id") @db.VarChar(64)
  categoryName     String? @map("category_name") @db.VarChar(255)
  categoryPath     String? @map("category_path") @db.VarChar(1024)

  /// Kích thước & khối lượng kiện hàng (TikTok trả về CHUỖI + đơn vị riêng).
  packageLength String? @map("package_length") @db.VarChar(32)
  packageWidth  String? @map("package_width") @db.VarChar(32)
  packageHeight String? @map("package_height") @db.VarChar(32)
  dimensionUnit String? @map("dimension_unit") @db.VarChar(16)
  packageWeight String? @map("package_weight") @db.VarChar(32)
  weightUnit    String? @map("weight_unit") @db.VarChar(16)

  isNotForSale       Boolean @default(false) @map("is_not_for_sale")
  hasDraft           Boolean @default(false) @map("has_draft")
  listingQualityTier String? @map("listing_quality_tier") @db.VarChar(40)
  /// Mảng nguyên trạng — ít truy vấn, không đáng tách bảng.
  productTags        Json?   @map("product_tags")
  salesRegions       Json?   @map("sales_regions")
  productTypes       Json?   @map("product_types")

  /// Số liệu tổng hợp phục vụ màn hình danh sách (tính lại mỗi lần đồng bộ) — tránh
  /// join + aggregate toàn bộ SKU chỉ để hiển thị một dòng.
  skuCount       Int      @default(0) @map("sku_count")
  minPrice       Decimal? @map("min_price") @db.Decimal(18, 4)
  maxPrice       Decimal? @map("max_price") @db.Decimal(18, 4)
  currency       String?  @db.VarChar(10)
  totalInventory Int      @default(0) @map("total_inventory")

  /// Mốc thời gian PHÍA TIKTOK: giữ cả Unix (so watermark) lẫn timestamptz (truy vấn).
  tiktokCreateTime BigInt?   @map("tiktok_create_time")
  tiktokUpdateTime BigInt?   @map("tiktok_update_time")
  tiktokCreatedAt  DateTime? @map("tiktok_created_at") @db.Timestamptz(6)
  tiktokUpdatedAt  DateTime? @map("tiktok_updated_at") @db.Timestamptz(6)

  /// sha256 của payload chi tiết — không đổi thì BỎ QUA mọi lệnh ghi (idempotent, P4).
  payloadHash  String    @map("payload_hash") @db.Char(64)
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  account  PodTiktokAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop     PodTiktokShop       @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  brand    PodProductBrand?    @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  category PodProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  variants        PodProductVariant[]
  images          PodProductImage[]
  videos          PodProductVideo[]
  attributes      PodProductAttribute[]
  rawData         PodProductRawData[]
  syncLogs        PodProductSyncLog[]
  listingPayloads PodListingPayload[]
  listingJobItems PodListingJobItem[]

  @@unique([shopId, tiktokProductId])
  @@index([organizationId])
  @@index([accountId])
  @@index([shopId, status])
  @@index([organizationId, tiktokUpdateTime])
  @@index([categoryId])
  @@index([brandId])
  @@index([title])
  @@map("pod_products")
}

// ---------------------------------------------------------------------------
// PodProductVariant — một SKU (đơn vị bán, giá, tồn kho) của sản phẩm.
// TikTok gọi là `skus[]`; "variant" là tổ hợp `sales_attributes[]` của SKU đó.
// ---------------------------------------------------------------------------

model PodProductVariant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  tiktokSkuId   String  @map("tiktok_sku_id") @db.VarChar(64)
  sellerSku     String? @map("seller_sku") @db.VarChar(255)
  externalSkuId String? @map("external_sku_id") @db.VarChar(255)

  /// Tên biến thể ghép từ `sales_attributes` ("Black / L") — để hiển thị và đối soát với
  /// `pod_order_items.sku_name`. Mảng gốc giữ nguyên ở `salesAttributes`.
  variantName     String? @map("variant_name") @db.VarChar(512)
  salesAttributes Json?   @map("sales_attributes")

  salePrice         Decimal? @map("sale_price") @db.Decimal(18, 4)
  listPrice         Decimal? @map("list_price") @db.Decimal(18, 4)
  taxExclusivePrice Decimal? @map("tax_exclusive_price") @db.Decimal(18, 4)
  currency          String?  @db.VarChar(10)

  /// Tổng tồn kho mọi kho + chi tiết theo kho (`inventory[]`).
  inventoryTotal Int   @default(0) @map("inventory_total")
  inventory      Json?

  skuWeight     String? @map("sku_weight") @db.VarChar(32)
  weightUnit    String? @map("weight_unit") @db.VarChar(16)
  skuLength     String? @map("sku_length") @db.VarChar(32)
  skuWidth      String? @map("sku_width") @db.VarChar(32)
  skuHeight     String? @map("sku_height") @db.VarChar(32)
  dimensionUnit String? @map("dimension_unit") @db.VarChar(16)

  /// `status_info.status` — SKU có thể bị vô hiệu riêng dù sản phẩm vẫn ACTIVE.
  status   String? @db.VarChar(40)
  imageUrl String? @map("image_url") @db.VarChar(2048)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  product PodProduct        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  images  PodProductImage[]

  @@unique([productId, tiktokSkuId])
  @@index([organizationId])
  @@index([productId])
  /// Cầu nối với đơn hàng: `pod_order_items.sku_id` / `seller_sku`.
  @@index([tiktokSkuId])
  @@index([sellerSku])
  @@map("pod_product_variants")
}

// ---------------------------------------------------------------------------
// PodProductImage — ảnh sản phẩm (`main_images[]`) và ảnh biến thể (`sku_img`).
// ---------------------------------------------------------------------------

model PodProductImage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  /// NULL = ảnh chính của sản phẩm; có giá trị = ảnh của SKU/biến thể.
  variantId      String? @map("variant_id") @db.Uuid

  /// `uri` là ĐỊNH DANH ảnh phía TikTok (dùng lại được khi tạo/sửa sản phẩm sau này);
  /// `url` là link tải có hạn — KHÔNG dùng làm khoá.
  uri       String? @db.VarChar(512)
  url       String? @db.VarChar(2048)
  thumbUrl  String? @map("thumb_url") @db.VarChar(2048)
  width     Int?
  height    Int?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product PodProduct         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant PodProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([variantId])
  @@map("pod_product_images")
}

// ---------------------------------------------------------------------------
// PodProductVideo — video sản phẩm (`video`). TikTok hiện trả tối đa một video,
// nhưng để dạng 1—N để sau này cho nhiều video thì không phải migration.
// ---------------------------------------------------------------------------

model PodProductVideo {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  tiktokVideoId String? @map("tiktok_video_id") @db.VarChar(128)
  url           String? @db.VarChar(2048)
  coverUrl      String? @map("cover_url") @db.VarChar(2048)
  format        String? @db.VarChar(20)
  width         Int?
  height        Int?
  size          BigInt?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product PodProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@map("pod_product_videos")
}

// ---------------------------------------------------------------------------
// PodProductAttribute — GIÁ TRỊ thuộc tính của một sản phẩm (`product_attributes[]`).
// Khác với `PodCategoryAttribute` (ĐỊNH NGHĨA thuộc tính của danh mục).
// ---------------------------------------------------------------------------

model PodProductAttribute {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid

  tiktokAttributeId String  @map("tiktok_attribute_id") @db.VarChar(64)
  name              String? @db.VarChar(255)
  /// `values[]` nguyên trạng: `[{ id, name }]` — một thuộc tính có thể có nhiều giá trị.
  values            Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product PodProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, tiktokAttributeId])
  @@index([organizationId])
  @@map("pod_product_attributes")
}

// ---------------------------------------------------------------------------
// PodProductCategory — cây danh mục TikTok (cache).
//
// 🔴 Danh mục phụ thuộc THỊ TRƯỜNG của shop ⇒ scope theo `shop_id`, không dùng chung
// toàn hệ thống. Public App phục vụ nhiều seller ở nhiều thị trường khác nhau.
// ---------------------------------------------------------------------------

model PodProductCategory {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  tiktokCategoryId   String  @map("tiktok_category_id") @db.VarChar(64)
  parentTiktokId     String? @map("parent_tiktok_id") @db.VarChar(64)
  localName          String? @map("local_name") @db.VarChar(255)
  isLeaf             Boolean @default(false) @map("is_leaf")
  /// Độ sâu + đường dẫn tên đầy đủ, dựng khi đồng bộ để truy vấn không phải đệ quy.
  level              Int     @default(0)
  path               String? @db.VarChar(1024)
  /// `permission_statuses[]` — seller có được đăng bán ở danh mục này không.
  permissionStatuses Json?   @map("permission_statuses")

  syncedAt  DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  shop       PodTiktokShop          @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products   PodProduct[]
  attributes PodCategoryAttribute[]

  @@unique([shopId, tiktokCategoryId])
  @@index([organizationId])
  @@index([shopId, isLeaf])
  @@index([parentTiktokId])
  @@map("pod_product_categories")
}

// ---------------------------------------------------------------------------
// PodCategoryAttribute — ĐỊNH NGHĨA thuộc tính của một danh mục (bắt buộc? kiểu?
// giá trị hợp lệ?). Đây là nền cho Sprint 3 (Template) và cho việc validate listing
// sau này: quy tắc ĐẾN TỪ API, không hardcode trong mã.
// ---------------------------------------------------------------------------

model PodCategoryAttribute {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  categoryId     String @map("category_id") @db.Uuid

  tiktokAttributeId   String  @map("tiktok_attribute_id") @db.VarChar(64)
  name                String? @db.VarChar(255)
  /// `type` của TikTok (vd SALES_PROPERTY / PRODUCT_PROPERTY).
  type                String? @db.VarChar(40)
  /// ⚠️ TikTok đặt tên trường là `is_requried` (sai chính tả ở API gốc). DB dùng tên đúng
  /// chính tả; việc ánh xạ nằm ở mapper — không để lỗi của API lan vào schema.
  isRequired          Boolean @default(false) @map("is_required")
  isMultipleSelection Boolean @default(false) @map("is_multiple_selection")
  isCustomizable      Boolean @default(false) @map("is_customizable")
  valueDataFormat     String? @map("value_data_format") @db.VarChar(40)
  /// Danh sách giá trị hợp lệ `[{ id, name }]`.
  values              Json?

  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category PodProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, tiktokAttributeId])
  @@index([organizationId])
  @@map("pod_category_attributes")
}

// ---------------------------------------------------------------------------
// PodProductBrand — thương hiệu (cache theo shop, cùng lý do với danh mục).
// ---------------------------------------------------------------------------

model PodProductBrand {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  tiktokBrandId    String  @map("tiktok_brand_id") @db.VarChar(64)
  name             String? @db.VarChar(255)
  /// Seller đã được cấp quyền dùng thương hiệu này hay chưa.
  authorizedStatus String? @map("authorized_status") @db.VarChar(40)
  brandStatus      String? @map("brand_status") @db.VarChar(40)

  /// 🔴 "No brand" — lựa chọn LUÔN hợp lệ trong Seller Center và là mặc định của hàng POD.
  /// Đánh dấu bằng cột riêng thay vì so tên ở mỗi chỗ dùng: tên hiển thị đổi theo ngôn ngữ
  /// và theo lần đồng bộ, còn cờ này thì không.
  isNoBrand Boolean @default(false) @map("is_no_brand")
  /// Bản ghi do HỆ THỐNG tạo vì TikTok không trả về (xem `ensureNoBrand`). Lần đồng bộ sau
  /// TikTok trả về thật thì bản ghi được cập nhật tại chỗ và cờ này tắt đi.
  isSystem  Boolean @default(false) @map("is_system")

  syncedAt  DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  shop     PodTiktokShop @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products PodProduct[]

  @@unique([shopId, tiktokBrandId])
  @@index([organizationId])
  @@index([name])
  @@index([organizationId, isNoBrand])
  @@map("pod_product_brands")
}

// ---------------------------------------------------------------------------
// PodProductSyncHistory — MỘT lượt đồng bộ (thủ công hoặc theo lịch).
// Bảng vận hành: xoá cứng theo retention, không soft delete (giống các bảng log khác).
// ---------------------------------------------------------------------------

model PodProductSyncHistory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  shopId         String? @map("shop_id") @db.Uuid

  scope   PodProductSyncScope
  trigger PodProductSyncTrigger
  status  PodProductSyncStatus  @default(RUNNING)

  /// Cửa sổ thời gian đã dùng cho INCREMENTAL (Unix giây) — tra được vì sao thiếu dữ liệu.
  watermarkFrom BigInt? @map("watermark_from")
  watermarkTo   BigInt? @map("watermark_to")

  productsFetched Int @default(0) @map("products_fetched")
  productsCreated Int @default(0) @map("products_created")
  productsUpdated Int @default(0) @map("products_updated")
  productsSkipped Int @default(0) @map("products_skipped")
  productsFailed  Int @default(0) @map("products_failed")
  pagesFetched    Int @default(0) @map("pages_fetched")
  apiCalls        Int @default(0) @map("api_calls")

  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")

  errorCode       String? @map("error_code") @db.VarChar(64)
  errorMessage    String? @map("error_message") @db.VarChar(2000)
  tiktokRequestId String? @map("tiktok_request_id") @db.VarChar(64)

  /// NULL = do scheduler chạy.
  triggeredBy String? @map("triggered_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account PodTiktokAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop    PodTiktokShop?      @relation(fields: [shopId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  logs    PodProductSyncLog[]

  @@index([organizationId, startedAt])
  @@index([accountId, startedAt])
  @@index([status])
  @@map("pod_product_sync_histories")
}

// ---------------------------------------------------------------------------
// PodProductSyncLog — kết quả xử lý TỪNG sản phẩm trong một lượt đồng bộ.
// Nhờ bảng này, câu hỏi "vì sao sản phẩm X không về" luôn có câu trả lời.
// ---------------------------------------------------------------------------

model PodProductSyncLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  historyId      String  @map("history_id") @db.Uuid
  /// NULL khi sản phẩm lỗi ngay từ bước đọc chi tiết (chưa kịp tạo bản ghi).
  productId      String? @map("product_id") @db.Uuid

  tiktokProductId String               @map("tiktok_product_id") @db.VarChar(64)
  action          PodProductSyncAction
  message         String?              @db.VarChar(1000)
  errorCode       String?              @map("error_code") @db.VarChar(64)
  tiktokRequestId String?              @map("tiktok_request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  history PodProductSyncHistory @relation(fields: [historyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product PodProduct?           @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([historyId])
  @@index([organizationId, createdAt])
  @@index([tiktokProductId])
  @@index([action])
  @@map("pod_product_sync_logs")
}

// ---------------------------------------------------------------------------
// PodProductRawData — RESPONSE GỐC của TikTok.
//
// 🔴 Vì sao giữ: (1) debug khi dữ liệu hiển thị sai mà không phải gọi lại API,
// (2) khi nâng cấp mapper/thêm trường, có thể CHIẾU LẠI từ payload cũ thay vì quét
// lại toàn bộ shop (P2 — staging mirror rồi mới projection).
// Chỉ giữ bản MỚI NHẤT theo (shop, product, source) để bảng không phình vô hạn.
// ---------------------------------------------------------------------------

model PodProductRawData {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  shopId         String  @map("shop_id") @db.Uuid
  productId      String? @map("product_id") @db.Uuid

  tiktokProductId String              @map("tiktok_product_id") @db.VarChar(64)
  source          PodProductRawSource
  /// Version API đã sinh ra payload (vd `product/202502`) — biết bản nào đọc được gì.
  apiVersion      String              @map("api_version") @db.VarChar(20)
  /// Payload NGUYÊN TRẠNG, không lược bớt.
  payload         Json
  payloadHash     String              @map("payload_hash") @db.Char(64)
  tiktokRequestId String?             @map("tiktok_request_id") @db.VarChar(64)

  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product PodProduct? @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([shopId, tiktokProductId, source])
  @@index([organizationId])
  @@index([productId])
  @@index([fetchedAt])
  @@map("pod_product_raw_data")
}

// ===========================================================================
// MODULE POD — LISTING TEMPLATE MANAGEMENT (Sprint 3)
//
// Mục tiêu: người dùng chọn NHIỀU sản phẩm × NHIỀU shop + một Listing Template
// ⇒ sinh ra **Draft Listing** lưu trong DB. Sprint 4 chỉ việc đọc draft, dựng
// payload TikTok và gọi Create/Publish qua SDK — KHÔNG phải sửa lại schema.
//
// 🔴 Sprint 3 TUYỆT ĐỐI không gọi API ghi của TikTok: không Create Product,
// không Publish, không Upload Product.
//
// Nguyên tắc chống hardcode (yêu cầu bắt buộc):
//   · Category / Attribute / Brand / Warehouse đều là **dữ liệu đã đồng bộ** từ TikTok
//     (bảng `pod_product_categories`, `pod_category_attributes`, `pod_product_brands`,
//     `pod_tiktok_warehouses`). Template chỉ LƯU LỰA CHỌN, không định nghĩa danh mục.
//   · Template tham chiếu TikTok bằng **ID chuỗi của TikTok + market**, không phải FK tới
//     bản ghi cache theo shop ⇒ một template dùng được cho MỌI shop cùng thị trường
//     (đúng mô hình Public App: nhiều seller, nhiều shop).
// ===========================================================================

/// Thị trường của template. Mỗi thị trường có cây danh mục và quy tắc riêng
/// ⇒ template phải gắn thị trường, không dùng lẫn.
/// Sales Market của template — mã vùng marketplace của TikTok Shop.
/// `EU`/`AU` là hai vùng gộp có từ bản đầu, giữ lại để không phá dữ liệu cũ.
enum PodListingMarket {
  US
  UK
  EU
  AU
  DE
  FR
  IT
  ES
  IE
  JP
  SG
  MY
  TH
  VN
  PH
  ID
  BR
  MX

  @@map("pod_listing_market")
}

/// VAI TRÒ của một tấm ảnh trong bộ ảnh mẫu (mockup) của một phôi.
///
/// 🔴 Đây là ảnh **của phôi**, không phải ảnh của sản phẩm: "Comfort Colors — mặt trước",
/// "bảng size", "hướng dẫn giặt". Một bộ dùng cho hàng nghìn listing.
enum PodImageAssetType {
  /// Mockup mặt trước.
  MAIN_FRONT
  /// Mockup mặt sau.
  MAIN_BACK
  /// Ảnh đời thường (người mặc, bối cảnh).
  LIFESTYLE
  /// Ảnh cận cảnh chi tiết (đường may, chất vải).
  DETAIL
  /// Bảng size.
  SIZE_CHART
  /// Ảnh đóng gói / hộp.
  PACKAGING
  /// Loại khác do người dùng tự đặt tên ở `title` (vd hướng dẫn giặt).
  CUSTOM

  @@map("pod_image_asset_type")
}

/// Cách một biến thể điều chỉnh giá so với giá do Pricing Template tính ra.
enum PodPriceAdjustmentType {
  /// Không điều chỉnh — dùng đúng giá của Pricing Template.
  NONE
  /// Cộng/trừ một số tiền (vd size XXL +2.00).
  AMOUNT
  /// Cộng/trừ theo phần trăm (vd +10%).
  PERCENT

  @@map("pod_price_adjustment_type")
}

/// Tài nguyên dùng chung phải kéo từ TikTok về trước khi dựng Template.
///
/// 🔴 Template CHỈ ĐỌC những bảng cache này. Cách duy nhất để dữ liệu vào là bấm Sync —
/// không màn hình nào được gọi thẳng TikTok khi mở dropdown.
enum PodResourceType {
  /// Cây danh mục (`pod_product_categories`).
  CATEGORY
  /// Thương hiệu (`pod_product_brands`).
  BRAND
  /// Kho hàng (`pod_tiktok_warehouses`).
  WAREHOUSE
  /// Định nghĩa thuộc tính theo danh mục (`pod_category_attributes`).
  CATEGORY_ATTRIBUTE

  @@map("pod_resource_type")
}

/// Trạng thái một lượt đồng bộ tài nguyên.
enum PodResourceSyncStatus {
  /// Chưa chạy lần nào.
  IDLE
  RUNNING
  SUCCESS
  /// Có shop thành công, có shop lỗi — nói rõ thay vì báo xanh giả.
  PARTIAL
  FAILED

  @@map("pod_resource_sync_status")
}

// ---------------------------------------------------------------------------
// PodResourceSync — TRẠNG THÁI HIỆN TẠI của mỗi tài nguyên trong một Organization.
//
// Một dòng cho mỗi (tổ chức × loại tài nguyên). Chi tiết từng lượt chạy và từng shop nằm
// ở `pod_resource_sync_logs`; bảng này chỉ trả lời nhanh câu "còn mới không, bao nhiêu bản
// ghi, lần cuối có lỗi gì" cho màn hình Resources.
// ---------------------------------------------------------------------------

model PodResourceSync {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  resource       PodResourceType

  status       PodResourceSyncStatus @default(IDLE)
  /// Thời điểm kết thúc lượt đồng bộ gần nhất.
  lastSyncAt   DateTime?             @map("last_sync_at") @db.Timestamptz(6)
  /// Số bản ghi ghi được ở lượt gần nhất.
  totalRecords Int                   @default(0) @map("total_records")
  /// Thời gian chạy lượt gần nhất (ms).
  durationMs   Int?                  @map("duration_ms")
  /// Lỗi của lượt gần nhất — NULL khi thành công.
  lastError    String?               @map("last_error") @db.VarChar(2000)
  /// Mã lượt chạy gần nhất, để nối sang bảng log.
  jobId        String?               @map("job_id") @db.Uuid
  lastRunBy    String?               @map("last_run_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([organizationId, resource])
  @@index([organizationId])
  @@map("pod_resource_syncs")
}

// ---------------------------------------------------------------------------
// PodResourceSyncLog — NHẬT KÝ từng lượt, tách theo shop.
//
// Bảng vận hành (xoá cứng theo retention, không soft delete) — giống các bảng log khác.
// Một `jobId` sinh ra nhiều dòng: mỗi shop một dòng, cộng một dòng tổng kết khi cần.
// ---------------------------------------------------------------------------

model PodResourceSyncLog {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  resource       PodResourceType
  /// Gom các dòng của cùng một lần bấm Sync.
  jobId          String          @map("job_id") @db.Uuid

  status PodResourceSyncStatus

  /// Shop tương ứng. NULL = dòng tổng kết của cả lượt.
  shopId   String? @map("shop_id") @db.Uuid
  shopName String? @map("shop_name") @db.VarChar(255)

  totalRecords Int     @default(0) @map("total_records")
  durationMs   Int     @default(0) @map("duration_ms")
  /// Thông điệp lỗi nguyên trạng — đây là thứ người vận hành cần đọc khi sync hỏng.
  errorMessage String? @map("error_message") @db.VarChar(2000)

  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  triggeredBy String?   @map("triggered_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, resource, startedAt])
  @@index([jobId])
  @@map("pod_resource_sync_logs")
}

/// Cách một Listing Template chọn ra tập sản phẩm mà nó áp dụng.
///
/// 🔴 Quan hệ đi theo chiều **Template → Product**: template mô tả "tôi áp cho những sản
/// phẩm nào", sản phẩm KHÔNG mang cột trỏ về template. Đây là điều kiện để Bulk Listing —
/// gắn template vào từng sản phẩm thì 10.000 sản phẩm là 10.000 lần gán tay.
enum PodListingScopeMatch {
  /// Mọi sản phẩm đã đồng bộ của tổ chức.
  ALL
  /// Theo danh mục TikTok (`tiktok_category_id`).
  CATEGORY
  /// Theo thương hiệu (`tiktok_brand_id`).
  BRAND
  /// Theo shop.
  SHOP
  /// Tiêu đề CHỨA từ khoá.
  TITLE_KEYWORD
  /// Có biến thể với Seller SKU bắt đầu bằng tiền tố.
  SELLER_SKU_PREFIX
  /// Theo trạng thái sản phẩm phía TikTok (ACTIVATE / DRAFT / …).
  PRODUCT_STATUS

  @@map("pod_listing_scope_match")
}

/// Cách tính giá bán từ giá vốn.
enum PodPricingMarkupType {
  /// Cộng theo phần trăm giá vốn: sale = (cost + shipping) × (1 + value/100)
  PERCENT
  /// Cộng số tiền cố định: sale = cost + shipping + value
  FIXED
  /// Biểu thức số học do người dùng nhập (`formula`), chỉ dùng biến trong danh sách trắng.
  /// KHÔNG eval — biểu thức được phân tích bằng parser riêng (`pod-pricing.formula.ts`).
  FORMULA

  @@map("pod_pricing_markup_type")
}

/// Thành phần cấu thành một Listing Template.
enum PodListingTemplateItemType {
  CATEGORY
  SKU
  DESCRIPTION
  IMAGE
  PRICING

  @@map("pod_listing_template_item_type")
}

/// Vòng đời một Draft Listing.
/// DRAFT: vừa sinh, còn lỗi validate · READY: đủ dữ liệu, chờ Sprint 4 publish
/// PUBLISHING/PUBLISHED/FAILED: do Sprint 4 cập nhật · ARCHIVED: người dùng bỏ
enum PodListingPayloadStatus {
  DRAFT
  READY
  PUBLISHING
  /// 🔴 Sprint 4: đã tạo **Draft Product** trên TikTok (có `tiktok_product_id`) nhưng CHƯA
  /// đăng bán. Đây là đích của Bulk Listing Engine và là ĐẦU VÀO của Sprint 5.
  TIKTOK_DRAFT
  /// 🔴 Sprint 5: đã gửi Publish và TikTok nhận. Sản phẩm vào hàng chờ duyệt — trạng thái
  /// duyệt thật nằm ở cột `review_status`, không nằm ở đây.
  PUBLISHED
  FAILED
  ARCHIVED

  @@map("pod_listing_payload_status")
}

// ---------------------------------------------------------------------------
// PodTiktokWarehouse — kho hàng đồng bộ từ TikTok (Get Warehouse List).
// Người dùng CHỌN kho ở Listing Template; không tự nhập, không hardcode.
// ---------------------------------------------------------------------------

model PodTiktokWarehouse {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  /// `warehouses[].id` phía TikTok.
  tiktokWarehouseId String  @map("tiktok_warehouse_id") @db.VarChar(64)
  name              String? @db.VarChar(255)
  /// `type` (SALES_WAREHOUSE / RETURN_WAREHOUSE) và `sub_type`.
  type              String? @db.VarChar(40)
  subType           String? @map("sub_type") @db.VarChar(40)
  effectStatus      String? @map("effect_status") @db.VarChar(40)
  isDefault         Boolean @default(false) @map("is_default")
  /// Vùng/quốc gia của kho — dùng để lọc theo thị trường của template.
  regionCode        String? @map("region_code") @db.VarChar(10)
  /// Địa chỉ nguyên trạng (JSON) — chỉ hiển thị, không tách cột vì không truy vấn theo.
  address           Json?

  syncedAt  DateTime  @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  shop              PodTiktokShop         @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listingTemplates  PodListingTemplate[]
  categoryTemplates PodCategoryTemplate[]

  /// Các shop đang lấy kho này làm kho mặc định lúc Publish.
  defaultForShops PodTiktokShop[] @relation("PodShopDefaultWarehouse")

  @@unique([shopId, tiktokWarehouseId])
  @@index([organizationId])
  @@map("pod_tiktok_warehouses")
}

// ---------------------------------------------------------------------------
// PodCategoryTemplate — mẫu cho MỘT danh mục TikTok: brand, kiện hàng, size chart,
// video mặc định và **giá trị thuộc tính** của danh mục đó.
// ---------------------------------------------------------------------------

model PodCategoryTemplate {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(255)
  market         PodListingMarket

  /// Danh mục TikTok đã chọn — lưu ID CHUỖI của TikTok (không phải FK theo shop)
  /// để template dùng lại được cho mọi shop cùng thị trường.
  tiktokCategoryId String  @map("tiktok_category_id") @db.VarChar(64)
  /// Ảnh chụp tên + đường dẫn danh mục tại thời điểm tạo — hiển thị được ngay cả khi
  /// cache danh mục của shop chưa đồng bộ.
  categoryName     String? @map("category_name") @db.VarChar(255)
  categoryPath     String? @map("category_path") @db.VarChar(1024)

  /// Thương hiệu (đồng bộ từ TikTok). NULL = không gắn brand.
  tiktokBrandId String? @map("tiktok_brand_id") @db.VarChar(64)
  brandName     String? @map("brand_name") @db.VarChar(255)

  /// Kiện hàng mặc định. Lưu CHUỖI đúng như TikTok yêu cầu (không ép số).
  packageWeight String? @map("package_weight") @db.VarChar(32)
  weightUnit    String? @map("weight_unit") @db.VarChar(16)
  packageLength String? @map("package_length") @db.VarChar(32)
  packageWidth  String? @map("package_width") @db.VarChar(32)
  packageHeight String? @map("package_height") @db.VarChar(32)
  dimensionUnit String? @map("dimension_unit") @db.VarChar(16)

  /// Size chart & product video mặc định — trỏ tới file trong Storage Module (R2).
  sizeChartFileId String? @map("size_chart_file_id") @db.Uuid
  videoFileId     String? @map("video_file_id") @db.Uuid

  /// Kho mặc định của template (kho đã đồng bộ từ TikTok — không tự nhập, không hardcode).
  warehouseId String? @map("warehouse_id") @db.Uuid

  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  /// Thứ tự hiển thị do người dùng đặt — danh sách sắp theo cột này trước khi sắp theo tên.
  displayOrder Int     @default(0) @map("display_order")
  note         String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  warehouse        PodTiktokWarehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attributes       PodCategoryTemplateAttribute[]
  listingTemplates PodListingTemplate[]
  sessionTemplates PodListingSessionTemplate[]

  @@index([organizationId, market])
  @@index([organizationId, displayOrder])
  @@index([tiktokCategoryId])
  @@map("pod_category_templates")
}

// ---------------------------------------------------------------------------
// PodCategoryTemplateAttribute — GIÁ TRỊ thuộc tính người dùng nhập cho template.
//
// 🔴 Danh sách thuộc tính KHÔNG hardcode: UI đọc `pod_category_attributes` (đã đồng bộ
// từ Get Category Attributes) rồi render động. Bảng này chỉ lưu giá trị đã chọn, kèm
// ẢNH CHỤP tên/độ bắt buộc để draft cũ vẫn tái dựng được khi TikTok đổi thuộc tính.
// ---------------------------------------------------------------------------

model PodCategoryTemplateAttribute {
  id                 String @id @default(uuid()) @db.Uuid
  organizationId     String @map("organization_id") @db.Uuid
  categoryTemplateId String @map("category_template_id") @db.Uuid

  tiktokAttributeId   String  @map("tiktok_attribute_id") @db.VarChar(64)
  attributeName       String? @map("attribute_name") @db.VarChar(255)
  /// Ảnh chụp `type` của TikTok (PRODUCT_PROPERTY / SALES_PROPERTY) — nhờ đó màn hình
  /// tách được "Product Attributes" và "Sale Attributes" mà không phải gọi lại API.
  attributeType       String? @map("attribute_type") @db.VarChar(40)
  /// Ảnh chụp `is_required` lúc nhập — biết được vì sao ngày đó bắt buộc.
  isRequired          Boolean @default(false) @map("is_required")
  /// Ảnh chụp `is_multiple_selection` / `is_customizable` lúc nhập.
  isMultipleSelection Boolean @default(false) @map("is_multiple_selection")
  isCustomizable      Boolean @default(false) @map("is_customizable")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoryTemplate PodCategoryTemplate                       @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values           PodCategoryTemplateAttributeValue[]
  customValues     PodCategoryTemplateAttributeCustomValue[]

  @@unique([categoryTemplateId, tiktokAttributeId])
  @@index([organizationId])
  @@map("pod_category_template_attributes")
}

// ---------------------------------------------------------------------------
// PodCategoryTemplateAttributeValue — MỘT giá trị đã chọn của một thuộc tính.
//
// Tách bảng thay vì mảng JSON: thuộc tính nhiều lựa chọn (`is_multiple_selection`)
// sinh ra quan hệ 1—n thật sự, và truy vấn "template nào đang dùng giá trị X" chỉ
// làm được khi giá trị nằm ở cột, không nằm trong JSON.
// ---------------------------------------------------------------------------

model PodCategoryTemplateAttributeValue {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  templateAttributeId String @map("template_attribute_id") @db.Uuid

  /// `id` của giá trị phía TikTok (lấy từ `pod_category_attributes.values`).
  tiktokValueId String  @map("tiktok_value_id") @db.VarChar(64)
  /// Ảnh chụp tên hiển thị lúc chọn.
  valueName     String? @map("value_name") @db.VarChar(255)
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attribute PodCategoryTemplateAttribute @relation(fields: [templateAttributeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([templateAttributeId, tiktokValueId])
  @@index([organizationId])
  @@map("pod_category_template_attribute_values")
}

// ---------------------------------------------------------------------------
// PodCategoryTemplateAttributeCustomValue — giá trị NGƯỜI DÙNG tự nhập cho một thuộc tính.
//
// 🔴 Vì sao tách bảng riêng thay vì nhét chung với giá trị chính thức: dữ liệu của TikTok là
// BẤT BIẾN — đồng bộ lại là ghi đè. Trộn giá trị tự nhập vào đó thì lần sync sau sẽ xoá mất,
// hoặc tệ hơn là gửi lên TikTok một `value_id` không tồn tại. Hai nguồn, hai bảng:
//
//   pod_category_template_attribute_values        → chọn từ danh sách TikTok (có `value_id`)
//   pod_category_template_attribute_custom_values → người dùng gõ tay (chỉ có tên)
//
// Lúc dựng listing cả hai được ghép lại thành `product_attributes[].values[]`: giá trị chính
// thức đi kèm `id`, giá trị tự nhập chỉ có `name` — đúng cách TikTok nhận custom value.
//
// ⚠️ Chỉ được phép nhập khi ĐỊNH NGHĨA thuộc tính từ TikTok có `is_customizable = true`
// (`pod_category_attributes.is_customizable`). Backend kiểm tra lại, không tin cờ do client gửi.
// ---------------------------------------------------------------------------

model PodCategoryTemplateAttributeCustomValue {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  templateAttributeId String @map("template_attribute_id") @db.Uuid

  /// Chuỗi người dùng nhập, đã trim. Không có `value_id` — TikTok cấp id, người dùng thì không.
  value        String @db.VarChar(500)
  displayOrder Int    @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  attribute PodCategoryTemplateAttribute @relation(fields: [templateAttributeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Hàng rào cuối cùng chống trùng; phần so sánh KHÔNG phân biệt hoa thường nằm ở service.
  @@unique([templateAttributeId, value])
  @@index([organizationId])
  @@map("pod_category_template_attribute_custom_values")
}

// ---------------------------------------------------------------------------
// SKU TEMPLATE — bốn bảng, không còn JSON:
//
//   pod_sku_templates              quy tắc chung (tiền tố mã, giá/tồn mặc định)
//     └── pod_sku_template_variants          TRỤC biến thể      (Color, Size, Style…)
//           └── pod_sku_template_variant_values   GIÁ TRỊ của trục (Black, White…)
//     └── pod_sku_template_items             TỔ HỢP đã sinh     (Black / S)
//           └── pod_sku_template_item_values      tổ hợp ⇄ giá trị (n—n)
//
// Vì sao tách hết ra bảng: trục biến thể là dữ liệu người dùng truy vấn và sửa
// (đổi tên một màu phải đổi cho mọi tổ hợp), còn "Black / S ↔ Black + S" là quan hệ
// n—n thật sự. Nhét vào JSON thì mọi thao tác đó thành đọc-sửa-ghi cả cục.
// ---------------------------------------------------------------------------

model PodSkuTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(255)

  /// Quy tắc sinh mã SKU: `{prefix}-{sản phẩm}-{mã tổ hợp}-{suffix}` — người dùng tự đặt.
  skuPrefix String? @map("sku_prefix") @db.VarChar(64)
  skuSuffix String? @map("sku_suffix") @db.VarChar(64)

  /// Giá trị mặc định áp cho mọi tổ hợp khi sinh (vẫn sửa được từng dòng).
  /// `retail` = giá gốc (gạch ngang), `sale` = giá bán thực tế — đúng cặp
  /// `original_price` / `sale_price` của TikTok Shop.
  defaultRetailPrice Decimal? @map("default_retail_price") @db.Decimal(18, 4)
  defaultSalePrice   Decimal? @map("default_sale_price") @db.Decimal(18, 4)
  defaultQuantity    Int      @default(0) @map("default_quantity")
  defaultDiscount    Decimal? @map("default_discount") @db.Decimal(9, 4)
  currency           String?  @db.VarChar(10)

  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  note         String? @db.VarChar(500)

  /// 🔴 Hai mốc thời gian này là toàn bộ cơ chế "SKU đã cũ so với trục biến thể".
  ///
  /// Lưu template chỉ ghi TRỤC; bảng SKU chỉ đổi khi người dùng bấm **Tạo SKU**. Sửa trục
  /// xong mà chưa tạo lại ⇒ `axes_updated_at > items_generated_at` ⇒ màn hình cảnh báo, dữ
  /// liệu giá/tồn đã nhập tay KHÔNG bị ghi đè. Tự sinh lại sau mỗi lần sửa là cách chắc chắn
  /// nhất để xoá sạch bảng giá của hàng chục SKU chỉ vì gõ nhầm một chữ trong tên trục.
  axesUpdatedAt    DateTime  @default(now()) @map("axes_updated_at") @db.Timestamptz(6)
  /// NULL = chưa bấm Tạo SKU lần nào.
  itemsGeneratedAt DateTime? @map("items_generated_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  variants         PodSkuTemplateVariant[]
  items            PodSkuTemplateItem[]
  listingTemplates PodListingTemplate[]
  sessionTemplates PodListingSessionTemplate[]

  @@index([organizationId])
  @@index([organizationId, displayOrder])
  @@map("pod_sku_templates")
}

/// PodSkuTemplateVariant — MỘT trục biến thể (Color, Size, Style…).
/// Số trục do người dùng quyết định; hệ thống không biết trước tên trục nào.
model PodSkuTemplateVariant {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  skuTemplateId  String @map("sku_template_id") @db.Uuid

  name      String @db.VarChar(64)
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  skuTemplate PodSkuTemplate               @relation(fields: [skuTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  values      PodSkuTemplateVariantValue[]

  @@unique([skuTemplateId, name])
  @@index([organizationId])
  @@map("pod_sku_template_variants")
}

/// PodSkuTemplateVariantValue — MỘT giá trị của trục (Black, White, S, M…).
model PodSkuTemplateVariantValue {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid

  value     String  @db.VarChar(128)
  /// Mã rút gọn dùng khi ghép SKU Code (vd Black → BLK). Bỏ trống ⇒ suy từ `value`.
  code      String? @db.VarChar(32)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant    PodSkuTemplateVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  itemValues PodSkuTemplateItemValue[]

  @@unique([variantId, value])
  @@index([organizationId])
  @@map("pod_sku_template_variant_values")
}

/// PodSkuTemplateItem — MỘT tổ hợp đã sinh ("Black / S") = một SKU sẽ đăng bán.
/// Vật chất hoá thay vì tính lúc chạy: người dùng chỉnh giá/tồn/ảnh/barcode cho TỪNG dòng.
model PodSkuTemplateItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  skuTemplateId  String @map("sku_template_id") @db.Uuid

  /// Tên hiển thị ghép sẵn ("Black / S") để UI và draft khỏi ghép lại.
  variantName String  @map("variant_name") @db.VarChar(512)
  /// Phần đuôi mã SKU của riêng tổ hợp (vd "BLK-S").
  skuCode     String? @map("sku_code") @db.VarChar(128)
  /// Mã vạch (GTIN/UPC/EAN) — TikTok cho phép khai báo ở mức SKU.
  barcode     String? @db.VarChar(64)

  /// **Điều chỉnh giá theo biến thể** — cách đúng để một SKU Template dùng chung cho nhiều
  /// sản phẩm có giá vốn khác nhau: "size XXL cộng thêm 2.00" hoặc "+10%", áp lên giá do
  /// Pricing Template tính ra. Đây là QUY TẮC, không phải giá của một sản phẩm cụ thể.
  priceAdjustmentType  PodPriceAdjustmentType @default(NONE) @map("price_adjustment_type")
  priceAdjustmentValue Decimal                @default(0) @map("price_adjustment_value") @db.Decimal(18, 4)

  /// Giá TUYỆT ĐỐI, tuỳ chọn — chỉ dùng khi cả bộ SKU bán đúng một giá cố định bất kể
  /// sản phẩm nào (vd phôi đồng giá). Để trống là bình thường và được khuyến khích.
  /// `retailPrice` = giá gốc (hiển thị gạch ngang) · `salePrice` = giá bán thực tế.
  retailPrice Decimal? @map("retail_price") @db.Decimal(18, 4)
  salePrice   Decimal? @map("sale_price") @db.Decimal(18, 4)
  /// Tồn kho mặc định gán cho biến thể khi dựng listing (quy tắc, không phải tồn thật).
  quantity    Int      @default(0)
  discount    Decimal? @db.Decimal(9, 4)

  /// Ảnh riêng của tổ hợp (Storage Module).
  imageFileId     String?   @map("image_file_id") @db.Uuid
  /// `uri` phía TikTok của ảnh biến thể sau lần upload đầu — cùng cơ chế tiết kiệm với bộ
  /// ảnh mẫu: ảnh "màu Đen" chỉ upload một lần rồi dùng cho mọi listing về sau.
  tiktokImageUri  String?   @map("tiktok_image_uri") @db.VarChar(512)
  imageUploadedAt DateTime? @map("image_uploaded_at") @db.Timestamptz(6)
  /// Enable / Disable — tổ hợp tắt sẽ không sinh SKU khi làm listing.
  isActive        Boolean   @default(true) @map("is_active")
  sortOrder       Int       @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  skuTemplate PodSkuTemplate            @relation(fields: [skuTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  image       StorageFile?              @relation("PodSkuTemplateItemImage", fields: [imageFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  values      PodSkuTemplateItemValue[]

  @@unique([skuTemplateId, variantName])
  @@index([organizationId])
  @@index([skuTemplateId, sortOrder])
  @@map("pod_sku_template_items")
}

/// PodSkuTemplateItemValue — nối tổ hợp với từng giá trị trục đã tạo ra nó.
/// Đây là bảng thay cho mảng JSON `option_values` của thiết kế cũ.
model PodSkuTemplateItemValue {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  itemId         String @map("item_id") @db.Uuid
  variantValueId String @map("variant_value_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  item         PodSkuTemplateItem         @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variantValue PodSkuTemplateVariantValue @relation(fields: [variantValueId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([itemId, variantValueId])
  @@index([organizationId])
  @@index([variantValueId])
  @@map("pod_sku_template_item_values")
}

// ---------------------------------------------------------------------------
// PodDescriptionTemplate — mẫu mô tả (HTML từ rich text editor).
// ---------------------------------------------------------------------------

model PodDescriptionTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(255)

  /// HTML do editor sinh ra. Cho phép token `{{PRODUCT.TITLE}}`, `{{MATERIAL}}` … được
  /// thay ở bước resolve. Token hệ thống là DANH SÁCH TRẮNG trong mã; token tự đặt nằm ở
  /// bảng `pod_description_template_tokens`. Không có eval ở bất kỳ đâu.
  contentHtml String @map("content_html") @db.Text

  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  note         String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  tokens           PodDescriptionTemplateToken[]
  listingTemplates PodListingTemplate[]
  sessionTemplates PodListingSessionTemplate[]

  @@index([organizationId])
  @@index([organizationId, displayOrder])
  @@map("pod_description_templates")
}

// ---------------------------------------------------------------------------
// PodDescriptionTemplateToken — token DO NGƯỜI DÙNG tự đặt cho một mẫu mô tả.
//
// Đây là chỗ làm cho Token Engine "mở rộng được" mà không phải sửa mã: `{{MATERIAL}}`,
// `{{CARE}}`, `{{SHIPPING}}`… là dữ liệu, không phải hằng số trong code. Token hệ thống
// (lấy từ sản phẩm/shop/template) vẫn là danh sách trắng cố định để không ai bơm được
// biểu thức tuỳ ý vào server đa tenant.
// ---------------------------------------------------------------------------

model PodDescriptionTemplateToken {
  id                    String @id @default(uuid()) @db.Uuid
  organizationId        String @map("organization_id") @db.Uuid
  descriptionTemplateId String @map("description_template_id") @db.Uuid

  /// Mã token viết trong HTML, KHÔNG kèm dấu ngoặc: `MATERIAL`, `CARE`, `SIZE`…
  code      String  @db.VarChar(64)
  /// Nhãn hiển thị trên form soạn thảo.
  label     String? @db.VarChar(255)
  /// Nội dung sẽ thay vào chỗ `{{code}}`.
  value     String  @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  descriptionTemplate PodDescriptionTemplate @relation(fields: [descriptionTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([descriptionTemplateId, code])
  @@index([organizationId])
  @@map("pod_description_template_tokens")
}

// ---------------------------------------------------------------------------
// PodImageTemplate — BỘ ẢNH MẪU (mockup) của một phôi.
//
//   Comfort Colors
//     ├── Front Mockup      MAIN_FRONT
//     ├── Back Mockup       MAIN_BACK
//     ├── Lifestyle 1..3    LIFESTYLE
//     ├── Size Chart        SIZE_CHART
//     └── Care Instruction  CUSTOM
//
// 🔴 Đây là ảnh CỐ ĐỊNH của phôi, KHÔNG phải ảnh của sản phẩm và không lấy từ ảnh sản
// phẩm. Upload một lần, dùng cho hàng nghìn listing — lúc listing chỉ việc lấy nguyên bộ,
// không phải upload lại.
// ---------------------------------------------------------------------------

model PodImageTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(255)

  /// Mô tả bộ ảnh (phôi nào, chụp ở đâu, dùng cho dòng sản phẩm nào).
  description String? @db.Text

  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  items            PodImageTemplateItem[]
  listingTemplates PodListingTemplate[]
  listingJobs      PodListingJob[]
  sessionTemplates PodListingSessionTemplate[]

  @@index([organizationId])
  @@index([organizationId, displayOrder])
  @@map("pod_image_templates")
}

// ---------------------------------------------------------------------------
// PodImageTemplateItem — MỘT TẤM ẢNH trong bộ ảnh mẫu.
//
// Ảnh nằm trên Cloudflare R2 (Storage Module). Bảng này giữ `fileId` để vòng đời file vẫn
// do Storage Module quản, ĐỒNG THỜI chép sẵn `imageUrl` / `imageKey` / kích thước: lúc
// dựng listing hàng loạt chỉ cần đọc một bảng, không phải join sang `storage_files`.
// ---------------------------------------------------------------------------

model PodImageTemplateItem {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  imageTemplateId String @map("image_template_id") @db.Uuid

  /// Tên người vận hành đặt: "Front Mockup", "Care Instruction".
  title     String            @db.VarChar(255)
  /// Vai trò của ảnh trong listing.
  assetType PodImageAssetType @map("asset_type")

  /// File trong Storage Module — nguồn sự thật về vòng đời của object trên R2.
  fileId String @map("file_id") @db.Uuid

  /// Ảnh chụp thông tin file để không phải join khi sinh listing hàng loạt.
  imageUrl    String @map("image_url") @db.VarChar(2048)
  imageKey    String @map("image_key") @db.VarChar(1024)
  contentType String @map("content_type") @db.VarChar(150)
  fileSize    Int    @map("file_size")
  /// NULL khi không đọc được kích thước (định dạng lạ) — không chặn upload vì lý do đó.
  width       Int?
  height      Int?

  /// Ảnh bắt buộc phải có trong listing (vd mockup mặt trước).
  isRequired   Boolean @default(false) @map("is_required")
  /// Thứ tự ảnh trong bộ — cũng là thứ tự ảnh trên listing.
  displayOrder Int     @default(0) @map("display_order")

  /// 🔴 Ô CHỜ cho sprint publish: sau khi Upload Product Image, TikTok trả `uri` — lưu vào
  /// đây để hàng nghìn listing sau dùng lại, khỏi upload cùng một tấm mockup nhiều lần.
  tiktokImageUri String?   @map("tiktok_image_uri") @db.VarChar(512)
  uploadedAt     DateTime? @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  imageTemplate PodImageTemplate @relation(fields: [imageTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file          StorageFile      @relation(fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId])
  @@index([imageTemplateId, displayOrder])
  @@map("pod_image_template_items")
}

// ---------------------------------------------------------------------------
// PodPricingStrategy — công thức giá. Không hardcode con số nào trong mã.
//
//   base   = cost + shipping
//   sale   = PERCENT  → base × (1 + markupValue/100)
//            FIXED    → base + markupValue
//            FORMULA  → giá trị của biểu thức `formula` (parser riêng, KHÔNG eval)
//   sale   = làm tròn LÊN tới bội số roundingIncrement
//   retail = sale × retailPriceMultiplier          (giá gốc gạch ngang)
//   final  = sale × (1 − discountPercent/100)      (giá sau khuyến mãi)
// ---------------------------------------------------------------------------

model PodPricingStrategy {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name           String @db.VarChar(255)

  cost         Decimal              @db.Decimal(18, 4)
  shippingCost Decimal              @default(0) @map("shipping_cost") @db.Decimal(18, 4)
  markupType   PodPricingMarkupType @default(PERCENT) @map("markup_type")
  markupValue  Decimal              @default(0) @map("markup_value") @db.Decimal(18, 4)

  /// Biểu thức khi `markupType = FORMULA`, vd `(cost + shipping) * 1.8 + 2`.
  /// Chỉ dùng biến trong danh sách trắng và bốn phép tính — xem `pod-pricing.formula.ts`.
  formula String? @db.VarChar(500)

  /// Giá gốc (gạch ngang) = giá bán × hệ số này. 1 = không hiển thị giá gạch.
  retailPriceMultiplier Decimal @default(1) @map("retail_price_multiplier") @db.Decimal(9, 4)
  /// Khuyến mãi mặc định (%).
  discountPercent       Decimal @default(0) @map("discount_percent") @db.Decimal(9, 4)
  /// Làm tròn tới bội số này (vd 0.99 → giá đẹp). 0 = không làm tròn.
  roundingIncrement     Decimal @default(0) @map("rounding_increment") @db.Decimal(9, 4)

  currency     String  @default("USD") @db.VarChar(10)
  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  note         String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  listingTemplates PodListingTemplate[]
  sessionTemplates PodListingSessionTemplate[]

  @@index([organizationId])
  @@index([organizationId, displayOrder])
  @@map("pod_pricing_strategies")
}

// ---------------------------------------------------------------------------
// PodListingTemplate — template LỚN NHẤT, ghép mọi mảnh lại.
// ---------------------------------------------------------------------------

model PodListingTemplate {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(255)
  market         PodListingMarket

  categoryTemplateId    String? @map("category_template_id") @db.Uuid
  skuTemplateId         String? @map("sku_template_id") @db.Uuid
  descriptionTemplateId String? @map("description_template_id") @db.Uuid
  imageTemplateId       String? @map("image_template_id") @db.Uuid
  pricingStrategyId     String? @map("pricing_strategy_id") @db.Uuid
  /// Kho đã đồng bộ từ TikTok (theo shop). NULL = lấy kho mặc định của shop lúc sinh draft.
  warehouseId           String? @map("warehouse_id") @db.Uuid

  /// Brand ghi đè brand của Category Template (một số dòng sản phẩm dùng brand khác).
  tiktokBrandId String? @map("tiktok_brand_id") @db.VarChar(64)
  brandName     String? @map("brand_name") @db.VarChar(255)

  /// Vận chuyển: `shipping_template_id` phía TikTok + thời gian xử lý (ngày).
  shippingTemplateId String? @map("shipping_template_id") @db.VarChar(64)
  handlingDays       Int?    @map("handling_days")

  /// Kiện hàng GHI ĐÈ kiện hàng của Category Template. Cùng một danh mục nhưng phôi khác
  /// nhau (áo 1 lớp vs hoodie) có khối lượng khác nhau — ghi đè ở đây thay vì phải nhân
  /// bản cả Category Template chỉ để đổi một con số.
  packageWeight String? @map("package_weight") @db.VarChar(32)
  weightUnit    String? @map("weight_unit") @db.VarChar(16)
  packageLength String? @map("package_length") @db.VarChar(32)
  packageWidth  String? @map("package_width") @db.VarChar(32)
  packageHeight String? @map("package_height") @db.VarChar(32)
  dimensionUnit String? @map("dimension_unit") @db.VarChar(16)

  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")
  note         String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  categoryTemplate    PodCategoryTemplate?    @relation(fields: [categoryTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  skuTemplate         PodSkuTemplate?         @relation(fields: [skuTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  descriptionTemplate PodDescriptionTemplate? @relation(fields: [descriptionTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imageTemplate       PodImageTemplate?       @relation(fields: [imageTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pricingStrategy     PodPricingStrategy?     @relation(fields: [pricingStrategyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse           PodTiktokWarehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items           PodListingTemplateItem[]
  scopes          PodListingTemplateScope[]
  listingPayloads PodListingPayload[]
  listingJobs     PodListingJob[]
  listingJobItems PodListingJobItem[]

  @@index([organizationId, market])
  @@index([organizationId, displayOrder])
  @@map("pod_listing_templates")
}

// ---------------------------------------------------------------------------
// PodListingTemplateScope — QUY TẮC CHỌN SẢN PHẨM mà một Listing Template áp dụng.
//
// 🔴 Đây là mảnh khiến Bulk Listing khả thi. Quan hệ đi theo chiều
//
//     Listing Template ──(scope)──► tập sản phẩm
//
// chứ KHÔNG phải mỗi sản phẩm mang một cột `listing_template_id`. Gắn template vào từng
// sản phẩm thì 10.000 sản phẩm là 10.000 lần gán tay, và mỗi lần đồng bộ về sản phẩm mới
// lại phải gán lại. Với scope, sản phẩm mới đồng bộ về là **tự động** nằm trong phạm vi
// của template phù hợp.
//
// Nhiều dòng INCLUDE = hợp (OR) trong cùng một loại, giao (AND) giữa các loại khác nhau.
// Dòng `isExclude` luôn loại trừ sau cùng — "tất cả áo thun US, TRỪ mấy mã sample".
// ---------------------------------------------------------------------------

model PodListingTemplateScope {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  listingTemplateId String @map("listing_template_id") @db.Uuid

  matchType  PodListingScopeMatch @map("match_type")
  /// Giá trị so khớp — id danh mục, id brand, id shop, từ khoá, tiền tố SKU…
  /// Bỏ trống khi `matchType = ALL`.
  value      String?              @db.VarChar(255)
  /// Nhãn hiển thị của `value` (tên danh mục/brand/shop) — để bảng đọc được mà không join.
  valueLabel String?              @map("value_label") @db.VarChar(255)
  /// `true` = LOẠI TRỪ những sản phẩm khớp dòng này.
  isExclude  Boolean              @default(false) @map("is_exclude")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listingTemplate PodListingTemplate @relation(fields: [listingTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([listingTemplateId])
  @@map("pod_listing_template_scopes")
}

// ---------------------------------------------------------------------------
// PodListingTemplateItem — thành phần đã ghép vào Listing Template.
//
// Vì sao có bảng này khi Listing Template đã có sẵn các FK: FK cho biết "đang dùng
// template nào", còn bảng này giữ **thứ tự và ảnh chụp tên** của từng thành phần tại
// thời điểm ghép — nhờ đó màn hình Listing Template hiển thị đúng cấu trúc kể cả khi
// một template con bị đổi tên, và sau này mở rộng "nhiều Image Template" không phải
// đổi cấu trúc bảng cha.
// ---------------------------------------------------------------------------

model PodListingTemplateItem {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  listingTemplateId String @map("listing_template_id") @db.Uuid

  itemType  PodListingTemplateItemType @map("item_type")
  /// ID của template con tương ứng (category/sku/description/image/pricing).
  refId     String                     @map("ref_id") @db.Uuid
  /// Ảnh chụp tên lúc ghép.
  refName   String?                    @map("ref_name") @db.VarChar(255)
  sortOrder Int                        @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  listingTemplate PodListingTemplate @relation(fields: [listingTemplateId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([listingTemplateId, itemType, refId])
  @@index([organizationId])
  @@map("pod_listing_template_items")
}

// ===========================================================================
// SPRINT — IMPORT PRODUCT & DRAFT LISTING ENGINE
//
//   Excel / CSV  →  Import  →  Draft Listing (NỘI BỘ)  →  Review · Edit · Validate
//                                      ↓  Start Listing
//                              Listing Job (hàng đợi có sẵn)
//                                      ↓
//                        Upload ảnh → Create Product (AS_DRAFT)
//                                      ↓
//                              TikTok Draft  →  (sprint sau) Publish
//
// 🔴 "Draft" ở đây là draft CỦA NCMEDIA, không phải TikTok Draft: người vận hành nhập từ
// file, sửa thoải mái, chưa có gì rời khỏi hệ thống. Chỉ khi bấm Start Listing mới có
// request đi ra ngoài.
//
// 🔴 Thiết kế cho NHIỀU SÀN: draft trỏ tới `platforms` (bảng global), nội dung là dữ liệu
// trung lập (tiêu đề, ảnh, biến thể, giá). Thêm eBay/Etsy/Amazon chỉ cần một bộ template và
// một publisher mới — bảng draft không phải đổi.
// ===========================================================================

/// Vòng đời một Draft Listing nội bộ.
// ===========================================================================
// LISTING SESSION — MỘT LƯỢT ĐĂNG HÀNG, từ lúc chọn cấu hình tới lúc lên sàn.
//
//   New Listing → Market → Shops → 5 Template → Import file → Draft Product
//        → Review → Start Listing → Draft trên sàn  (→ Publish: sprint sau)
//
// 🔴 Draft Product KHÔNG phải thực thể độc lập: nó chỉ tồn tại BÊN TRONG một session và
// chết theo session (`onDelete: Cascade`). Đây là điểm khác căn bản với thiết kế cũ
// (`pod_draft_listings`), nơi mỗi draft tự mang lấy market + shop + 5 template của riêng
// nó — cùng một lô hàng nhập vào bị nhân bản cấu hình hàng trăm lần, và không có chỗ nào
// trả lời được câu "lô hôm nay gồm những gì, đã lên sàn tới đâu".
//
// 🔴 Nhiều sàn: session trỏ `platform_id` sang bảng global `platforms`. Nội dung Draft
// Product là dữ liệu TRUNG LẬP (tiêu đề, mô tả, ảnh, biến thể, giá, tồn) — thêm eBay/
// Amazon/Etsy/Shopify chỉ cần thêm publisher và bộ template của sàn đó, không đụng tới
// bốn bảng dưới đây.
// ===========================================================================

/// Vòng đời một Listing Session.
enum PodListingSessionStatus {
  /// Đang cấu hình hoặc đang sửa Draft Product — chưa đủ điều kiện chạy.
  DRAFT
  /// Mọi Draft Product đã qua cổng validate, được phép Start Listing.
  READY
  /// Đang chạy: Listing Job của session đang đưa hàng lên sàn.
  LISTING
  /// Chạy xong, KHÔNG sản phẩm nào lỗi.
  COMPLETED
  /// Chạy xong nhưng có sản phẩm lỗi — nói rõ thay vì báo xanh giả.
  COMPLETED_WITH_ERRORS
  /// Chạy xong và KHÔNG sản phẩm nào thành công.
  FAILED
  /// Người dùng huỷ lượt chạy.
  CANCELLED

  @@map("pod_listing_session_status")
}

/// Vòng đời MỘT Draft Product bên trong session.
enum PodListingSessionProductStatus {
  /// Vừa import hoặc vừa sửa — chưa validate sạch.
  DRAFT
  /// Qua hết cổng validate, được phép Start Listing.
  READY
  /// Đã đưa vào Listing Job, đang chờ/đang chạy.
  QUEUED
  /// 🔴 Đã tạo được **Draft Product trên sàn** (TikTok Draft). CHƯA đăng bán.
  UPLOADED
  /// 🔴 Sprint 5: đã bấm Publish và TikTok nhận — sản phẩm vào hàng chờ duyệt.
  PUBLISHED
  /// Lượt đưa lên gần nhất thất bại — sửa rồi chạy lại.
  FAILED
  /// Bị cổng validate chặn ngay trong lượt chạy, không gửi request nào lên sàn.
  SKIPPED

  @@map("pod_listing_session_product_status")
}

/// Loại template mà một session đã chọn. Mỗi loại đúng MỘT dòng.
enum PodListingSessionTemplateType {
  CATEGORY
  SKU
  DESCRIPTION
  IMAGE
  PRICING

  @@map("pod_listing_session_template_type")
}

/// Vai trò của một tấm ảnh trong Draft Product.
enum PodListingSessionImageType {
  /// Ảnh chính của sản phẩm.
  MAIN
  /// Ảnh của một biến thể.
  VARIANT
  /// Ảnh chèn trong mô tả.
  DESCRIPTION
  /// Bảng size.
  SIZE_CHART

  @@map("pod_listing_session_image_type")
}

// ---------------------------------------------------------------------------
// PodListingSession — HỘP CHỨA của cả lượt đăng.
//
// Market + Shops + 5 Template nằm ở ĐÂY, không nằm ở từng sản phẩm: người vận hành chọn
// một lần cho cả lô. Import chỉ đổ nội dung vào cái hộp đã cấu hình sẵn.
//
// KHÔNG lưu cột đếm (`total/ready/failed`): số liệu được tính từ chính trạng thái của
// Draft Product mỗi lần đọc. Cột đếm phải cập nhật ở 6 chỗ khác nhau (import, sửa, xoá,
// validate, start, kết thúc job) và chỉ cần sót MỘT chỗ là màn hình nói dối vĩnh viễn.
// ---------------------------------------------------------------------------

model PodListingSession {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Sàn đích — `platforms` là bảng global (TikTok Shop, eBay, Amazon, Etsy, Shopify).
  platformId String @map("platform_id") @db.Uuid

  name   String                  @db.VarChar(255)
  market PodListingMarket
  status PodListingSessionStatus @default(DRAFT)

  note String? @db.VarChar(2000)

  /// File import gần nhất — truy ngược "lô này đến từ file nào".
  sourceFile String?   @map("source_file") @db.VarChar(512)
  importedAt DateTime? @map("imported_at") @db.Timestamptz(6)

  /// Mốc Start Listing và mốc lượt chạy kết thúc.
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Lỗi làm hỏng cả lượt (vd template bị xoá giữa chừng).
  lastError  String?   @map("last_error") @db.VarChar(2000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  shops     PodListingSessionShop[]
  templates PodListingSessionTemplate[]
  products  PodListingSessionProduct[]
  jobs      PodListingJob[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, market])
  @@map("pod_listing_sessions")
}

// ---------------------------------------------------------------------------
// PodListingSessionShop — các shop mà cả lượt này sẽ đăng lên.
//
// Bảng nối thay vì cột `shop_ids`: một session đăng lên 5 shop là 5 dòng, và câu hỏi
// "shop X đang có lượt nào chạy" thành một phép JOIN thay vì quét chuỗi.
// ---------------------------------------------------------------------------

model PodListingSessionShop {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sessionId      String @map("session_id") @db.Uuid
  shopId         String @map("shop_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session PodListingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop    PodTiktokShop     @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([sessionId, shopId])
  @@index([organizationId])
  @@map("pod_listing_session_shops")
}

// ---------------------------------------------------------------------------
// PodListingSessionTemplate — MỘT dòng cho MỖI loại template session đã chọn.
//
// 🔴 Vì sao là bảng riêng chứ không phải 5 cột trên `pod_listing_sessions`: bộ template
// của một lượt đăng phụ thuộc vào SÀN. TikTok cần Category/SKU/Description/Image/Pricing;
// eBay sẽ cần Item Specifics + Shipping Policy + Return Policy. Thêm sàn = thêm giá trị
// enum + cột khoá ngoại tương ứng, KHÔNG phải sửa bảng session.
//
// Mỗi dòng chỉ điền ĐÚNG MỘT cột khoá ngoại — cột nào thì do `template_type` quyết định.
// Ràng buộc CHECK ở migration canh đúng điều đó, nên không thể có dòng "type = SKU nhưng
// trỏ vào Category Template". Giữ khoá ngoại THẬT (thay vì một cột `template_id` đa hình)
// để database tự chặn việc xoá template đang có lượt đăng dùng dở.
// ---------------------------------------------------------------------------

model PodListingSessionTemplate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sessionId      String @map("session_id") @db.Uuid

  templateType PodListingSessionTemplateType @map("template_type")

  categoryTemplateId    String? @map("category_template_id") @db.Uuid
  skuTemplateId         String? @map("sku_template_id") @db.Uuid
  descriptionTemplateId String? @map("description_template_id") @db.Uuid
  imageTemplateId       String? @map("image_template_id") @db.Uuid
  pricingStrategyId     String? @map("pricing_strategy_id") @db.Uuid

  /// Ảnh chụp tên template lúc chọn — lượt đăng cũ vẫn đọc được dù template bị đổi tên.
  templateName String? @map("template_name") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session             PodListingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryTemplate    PodCategoryTemplate?    @relation(fields: [categoryTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  skuTemplate         PodSkuTemplate?         @relation(fields: [skuTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  descriptionTemplate PodDescriptionTemplate? @relation(fields: [descriptionTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imageTemplate       PodImageTemplate?       @relation(fields: [imageTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pricingStrategy     PodPricingStrategy?     @relation(fields: [pricingStrategyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId, templateType])
  @@index([organizationId])
  @@map("pod_listing_session_templates")
}

// ---------------------------------------------------------------------------
// PodListingSessionProduct — MỘT Draft Product bên trong session.
//
// 🔴 Chỉ giữ ĐÚNG HAI thứ do người dùng cung cấp: **tiêu đề** và **danh sách ảnh gốc**.
// Danh mục, thuộc tính, biến thể, giá, tồn, mô tả, kiện hàng — tất cả được dựng từ bộ
// template của session lúc Start Listing. File import vì thế chỉ cần 11 cột
// (`title` + `URL1..URL10`), và người vận hành không phải khai lại quy tắc cho từng dòng.
//
// 🔴 KHÔNG có cột `remote_product_id`: một Draft Product đăng lên N shop sinh ra N sản
// phẩm trên sàn, mỗi shop một id. Id đó nằm ở `pod_listing_job_items.remote_product_id`
// (một dòng cho mỗi cặp sản phẩm × shop) — chỗ duy nhất diễn tả đúng quan hệ 1-N.
// ---------------------------------------------------------------------------

model PodListingSessionProduct {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  sessionId      String @map("session_id") @db.Uuid

  title String @db.VarChar(1024)

  /// Số dòng trong file import — người dùng sửa đúng dòng đó rồi nhập lại.
  sourceRow Int? @map("source_row")

  status PodListingSessionProductStatus @default(DRAFT)

  /// Dòng dữ liệu gốc trong file import (`{ title, urls: [...] }`) — giữ NGUYÊN TRẠNG để
  /// đối chiếu khi nghi ngờ hệ thống đọc sai cột. Đây là blob đúng nghĩa nên để JSON.
  rawData     Json? @map("raw_data")
  /// Payload xem trước gần nhất (kết quả áp template). Chỉ để xem lại nhanh; nguồn sự thật
  /// là `pod_listing_payloads` lúc thực sự gửi đi.
  previewData Json? @map("preview_data")

  /// Kết quả validate gần nhất: `[{ level, field, code, message }]`.
  issues     Json?
  errorCount Int   @default(0) @map("error_count")

  /// Lỗi của lượt đưa lên gần nhất (gộp từ các shop) — màn Review đọc thẳng cột này.
  uploadError String?   @map("upload_error") @db.VarChar(2000)
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  /// Mốc publish gần nhất (gộp từ các shop) — Sprint 5 ghi khi lượt Publish kết thúc.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// Thứ tự sản phẩm trong lượt đăng — đúng thứ tự dòng của file, cộng dồn qua các lần
  /// import bổ sung. Danh sách luôn hiện theo đúng thứ tự người dùng đã nạp vào.
  importOrder Int @default(0) @map("import_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  session PodListingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// Ảnh GỐC của sản phẩm (URL1 → URL10 của file import).
  images   PodListingSessionProductImage[]
  payloads PodListingPayload[]
  jobItems PodListingJobItem[]

  @@index([organizationId, status])
  @@index([sessionId, importOrder])
  @@index([sessionId, status])
  @@map("pod_listing_session_products")
}

// ---------------------------------------------------------------------------
// PodListingSessionProductImage — ẢNH GỐC của một Draft Product (URL1 → URL10).
//
// Ảnh đến từ file import là **URL ngoài** (Google Drive, CDN của xưởng in…): lưu URL, tới
// lúc Start Listing mới tải về rồi đẩy lên sàn. `file_id` chỉ có khi người dùng tự upload
// ảnh qua Storage Module.
//
// `sort_order` giữ đúng thứ tự cột trong file: URL1 là ảnh đại diện (thumbnail) và cũng là
// ảnh đầu tiên của listing.
// ---------------------------------------------------------------------------

model PodListingSessionProductImage {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  sessionProductId String @map("session_product_id") @db.Uuid

  imageUrl  String                     @map("image_url") @db.VarChar(2048)
  imageType PodListingSessionImageType @default(MAIN) @map("image_type")
  sortOrder Int                        @default(0) @map("sort_order")

  /// File trong Storage Module khi ảnh do người dùng tải lên (không phải URL ngoài).
  fileId     String?   @map("file_id") @db.Uuid
  /// `uri` phía sàn sau lần upload đầu — lần sau dùng lại, không tải/đẩy lại cùng một ảnh.
  remoteUri  String?   @map("remote_uri") @db.VarChar(512)
  uploadedAt DateTime? @map("uploaded_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product PodListingSessionProduct @relation(fields: [sessionProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file    StorageFile?             @relation("PodListingSessionProductImageFile", fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId])
  @@index([sessionProductId, sortOrder])
  @@map("pod_listing_session_product_images")
}

// ---------------------------------------------------------------------------
// PodListingPayload — NỘI DUNG ĐÃ GIẢI của một listing: nguồn × shop × template.
//
// Đây là artifact của máy: ảnh chụp payload hệ thống ĐÃ GỬI lên sàn, giữ để đối chiếu.
//
//   pod_listing_session_products → người dùng nhập/sửa (đầu vào)
//   pod_listing_payloads         → hệ thống giải ra rồi gửi đi (đầu ra, chỉ đọc)
// ---------------------------------------------------------------------------

model PodListingPayload {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Sản phẩm đã đồng bộ dùng làm nguồn. NULL khi nguồn là Draft Product của session.
  productId        String? @map("product_id") @db.Uuid
  /// Draft Product trong Listing Session. NULL khi nguồn là sản phẩm đã đồng bộ.
  sessionProductId String? @map("session_product_id") @db.Uuid
  /// Shop đích sẽ đăng bán.
  shopId           String  @map("shop_id") @db.Uuid
  accountId        String  @map("account_id") @db.Uuid

  /// 🔴 NULL khi nguồn là Listing Session: session chọn 5 template rời chứ không bắt buộc
  /// phải có một Listing Template gộp. Không cho NULL thì mỗi lượt đăng lại phải đẻ ra một
  /// Listing Template rác chỉ để thoả khoá ngoại.
  listingTemplateId String? @map("listing_template_id") @db.Uuid
  /// Image Template ghi đè cho riêng sản phẩm này (màn hình Auto Listing cho phép).
  imageTemplateId   String? @map("image_template_id") @db.Uuid

  market PodListingMarket
  status PodListingPayloadStatus @default(DRAFT)

  /// Nội dung đã giải: title, description, category, brand, attributes, images,
  /// variants (giá đã tính theo Pricing Strategy), package, warehouse…
  payload     Json
  /// sha256 của payload — sinh lại cùng dữ liệu thì nhận diện được là không đổi.
  payloadHash String @map("payload_hash") @db.Char(64)

  /// Lỗi/cảnh báo validate: `[{ level, field, code, message }]`.
  /// Còn lỗi mức ERROR ⇒ giữ trạng thái DRAFT, Sprint 4 không được publish.
  issues     Json?
  errorCount Int   @default(0) @map("error_count")

  title        String? @db.VarChar(1024)
  variantCount Int     @default(0) @map("variant_count")

  /// `product_id` của listing phía TikTok — GIỮ NGUYÊN qua cả hai giai đoạn.
  ///
  /// 🔴 TikTok KHÔNG cấp id mới khi publish: Draft và sản phẩm đã đăng là cùng một bản ghi,
  /// chỉ đổi `save_mode`. Vì thế `tiktok_draft_id` và cột này bằng nhau sau khi publish —
  /// tách hai cột để màn hình phân biệt được "đã tạo draft" với "đã gửi duyệt", không phải
  /// vì TikTok có hai id.
  tiktokProductId   String?   @map("tiktok_product_id") @db.VarChar(64)
  /// Id nhận được ở lần tạo Draft (`save_mode = AS_DRAFT`). Có giá trị ⇒ **cấm Create lại**.
  tiktokDraftId     String?   @map("tiktok_draft_id") @db.VarChar(64)
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  publishError      String?   @map("publish_error") @db.VarChar(2000)
  /// Số lần đã thử publish (cộng dồn qua các lượt) — Publish History đọc thẳng cột này.
  publishRetryCount Int       @default(0) @map("publish_retry_count")

  /// Thân request Edit Product đã gửi khi publish — bằng chứng "đã gửi đúng cái gì".
  publishRequest  Json? @map("publish_request")
  /// Response TikTok trả về (product_id, sku_id, warnings, audit) — màn Publish History mở ra xem.
  publishResponse Json? @map("publish_response")

  /// 🔴 Trạng thái DUYỆT phía TikTok — scheduler 5 phút/lần ghi vào đây.
  reviewStatus    PodListingReviewStatus? @map("review_status")
  /// Chuỗi trạng thái GỐC của TikTok (`ACTIVATE`, `SELLER_DEACTIVATED`…) — giữ nguyên để
  /// đối chiếu khi TikTok thêm giá trị mới mà bảng ánh xạ chưa biết.
  reviewStatusRaw String?                 @map("review_status_raw") @db.VarChar(64)
  /// Lý do bị từ chối, gộp từ `audit_failed_reasons[]`.
  reviewReason    String?                 @map("review_reason") @db.VarChar(2000)
  reviewCheckedAt DateTime?               @map("review_checked_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  product         PodProduct?               @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sessionProduct  PodListingSessionProduct? @relation(fields: [sessionProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop            PodTiktokShop             @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  account         PodTiktokAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listingTemplate PodListingTemplate?       @relation(fields: [listingTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  items    PodListingPayloadItem[]
  jobItems PodListingJobItem[]

  /// Mỗi nguồn chỉ có MỘT payload đang sống trên mỗi shop — giải lại thì ghi đè.
  @@unique([shopId, productId, listingTemplateId])
  @@unique([shopId, sessionProductId])
  @@index([organizationId, status])
  @@index([shopId, status])
  @@index([listingTemplateId])
  /// Scheduler quét đúng những listing đã publish mà trạng thái duyệt còn chuyển tiếp.
  @@index([reviewStatus, reviewCheckedAt])
  @@map("pod_listing_payloads")
}

// ---------------------------------------------------------------------------
// PodListingPayloadItem — một biến thể (SKU) trong payload đã giải.
// Tách bảng để UI liệt kê nhanh mà không phải mở JSON, và để ghi `tiktok_sku_id`
// trả về sau khi tạo sản phẩm.
// ---------------------------------------------------------------------------

model PodListingPayloadItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  payloadId      String @map("payload_id") @db.Uuid

  variantName  String @map("variant_name") @db.VarChar(512)
  sellerSku    String @map("seller_sku") @db.VarChar(255)
  /// `[{ name, value }]` — trục thuộc tính bán hàng của biến thể.
  optionValues Json?

  retailPrice Decimal? @map("retail_price") @db.Decimal(18, 4)
  listPrice   Decimal? @map("list_price") @db.Decimal(18, 4)
  currency    String?  @db.VarChar(10)
  quantity    Int      @default(0)

  imageFileId String? @map("image_file_id") @db.Uuid
  sortOrder   Int     @default(0) @map("sort_order")

  /// `sku_id` do TikTok cấp — khớp theo `seller_sku` sau Create/Edit Product.
  tiktokSkuId String? @map("tiktok_sku_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payload PodListingPayload @relation(fields: [payloadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([payloadId, sellerSku])
  @@index([organizationId])
  @@map("pod_listing_payload_items")
}

// ===========================================================================
// SPRINT 4 — BULK LISTING ENGINE
//
//   Product × Shop × Listing Template
//        ↓  (Listing Job)
//   Listing Job Item  →  Draft Listing (payload đã giải)
//        ↓  (Queue: concurrency 5 · retry 3 · exponential backoff)
//   Upload Product Image  →  Create Product (save_mode = AS_DRAFT)
//        ↓
//   remote_product_id + Listing Log từng bước
//
// 🔴 Sprint này CHỈ tạo Draft Product trên TikTok. Không Activate, không Publish.
// ===========================================================================

/// Vòng đời một lượt chạy hàng loạt.
enum PodListingJobStatus {
  /// Đã tạo, chưa có worker nào nhận.
  PENDING
  /// Đang chạy — ít nhất một item đang được xử lý.
  PROCESSING
  /// Chạy xong, KHÔNG item nào lỗi.
  COMPLETED
  /// Chạy xong nhưng có item lỗi — nói rõ thay vì báo xanh giả.
  COMPLETED_WITH_ERRORS
  /// Chạy xong và KHÔNG item nào thành công.
  FAILED
  /// Người dùng huỷ giữa chừng; item chưa chạy chuyển sang CANCELLED.
  CANCELLED

  @@map("pod_listing_job_status")
}

/// Vòng đời MỘT sản phẩm × MỘT shop trong lượt chạy.
enum PodListingJobItemStatus {
  /// Đang xếp hàng.
  PENDING
  /// Worker đang chạy pipeline (merge → validate → upload ảnh → create draft).
  PROCESSING
  /// Lỗi tạm thời, đang chờ tới `next_attempt_at` để chạy lại.
  RETRYING
  /// Đã tạo được Draft Product trên TikTok, có `remote_product_id`.
  SUCCESS
  /// Hết lượt thử hoặc lỗi không thể thử lại (TikTok từ chối nội dung).
  FAILED
  /// Bị chặn ở cổng Validate — KHÔNG gửi request nào lên TikTok.
  SKIPPED
  /// Người dùng huỷ job trước khi item được chạy.
  CANCELLED

  @@map("pod_listing_job_item_status")
}

/// Mức độ của một dòng log.
enum PodListingLogLevel {
  DEBUG
  INFO
  WARN
  ERROR

  @@map("pod_listing_log_level")
}

/// Bước trong pipeline của MỘT item — log ghi theo bước để đọc được "chết ở đâu".
enum PodListingStep {
  LOAD_PRODUCT
  LOAD_TEMPLATE
  MERGE
  VALIDATE
  UPLOAD_IMAGE
  CREATE_DRAFT
  SAVE_REMOTE_ID
  /// 🔴 Sprint 5: đưa Draft đã có trên sàn vào hàng chờ duyệt (`save_mode = LISTING`).
  PUBLISH
  /// Đọc lại trạng thái duyệt của sản phẩm đã publish (scheduler 5 phút/lần).
  REVIEW_SYNC
  RETRY
  CANCEL

  @@map("pod_listing_step")
}

/// Lượt chạy này LÀM GÌ với TikTok — hai việc khác nhau, chung một cỗ máy hàng đợi.
enum PodListingJobType {
  /// Tạo Draft Product trên TikTok (`save_mode = AS_DRAFT`) — Sprint 4.
  CREATE_DRAFT
  /// Đưa Draft đã có sẵn vào hàng chờ duyệt (`save_mode = LISTING`) — Sprint 5.
  PUBLISH

  @@map("pod_listing_job_type")
}

/// Trạng thái DUYỆT của một listing phía TikTok — đọc về từ Get Product.
///
/// 🔴 Đây là trục khác với `PodListingPayloadStatus`: cột kia nói "hệ thống đã gửi tới đâu",
/// cột này nói "TikTok đã xử lý tới đâu". Gộp hai trục vào một enum là mất thông tin ngay
/// lần đầu một sản phẩm publish thành công nhưng bị từ chối duyệt.
enum PodListingReviewStatus {
  /// TikTok đang duyệt (`status = PENDING` hoặc `audit.status = AUDITING`).
  UNDER_REVIEW
  /// Qua duyệt nhưng chưa lên sàn (`PRE_APPROVED` / `SCHEDULED`).
  APPROVED
  /// Bị từ chối (`status = FAILED` hoặc `audit.status = FAILED`) — lý do ở `review_reason`.
  REJECTED
  /// Đang bán (`status = ACTIVATE`).
  ACTIVE
  /// Đã tắt: người bán tắt, sàn tắt, hoặc bị đóng băng.
  OFFLINE
  /// Đã xoá khỏi shop.
  DELETED

  @@map("pod_listing_review_status")
}

// ---------------------------------------------------------------------------
// PodListingJob — MỘT lượt bulk listing (một lần bấm "Generate Draft").
//
// Số đếm `total/success/failed` được cập nhật ngay sau mỗi item thay vì tính lại bằng
// COUNT: màn hình progress hỏi lại mỗi vài giây, và đếm lại hàng nghìn dòng mỗi lần hỏi là
// cách nhanh nhất để tự làm chậm chính mình.
// ---------------------------------------------------------------------------

model PodListingJob {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// Tên do người dùng đặt, hoặc sinh từ tên session/template nếu để trống.
  name   String              @db.VarChar(255)
  market PodListingMarket
  status PodListingJobStatus @default(PENDING)

  /// 🔴 CREATE_DRAFT hay PUBLISH. Cùng một hàng đợi, cùng retry, cùng log — chỉ khác lời gọi
  /// cuối cùng tới TikTok. Mặc định CREATE_DRAFT để mọi lượt chạy cũ giữ nguyên ý nghĩa.
  type PodListingJobType @default(CREATE_DRAFT)

  /// 🔴 Listing Session đã bấm Start Listing. NULL khi job chạy từ sản phẩm đã đồng bộ.
  sessionId String? @map("session_id") @db.Uuid

  /// Template dùng cho cả lượt (item vẫn giữ bản sao id để tra được sau này).
  /// NULL khi nguồn là Listing Session — session mang 5 template rời của nó.
  listingTemplateId String? @map("listing_template_id") @db.Uuid
  /// Image Template ghi đè cho cả lượt. NULL = dùng bộ ảnh của Listing Template.
  imageTemplateId   String? @map("image_template_id") @db.Uuid

  totalItems   Int @default(0) @map("total_items")
  successItems Int @default(0) @map("success_items")
  failedItems  Int @default(0) @map("failed_items")

  /// Tham số queue của LƯỢT NÀY — lưu lại để lượt cũ vẫn giải thích được bằng số của nó,
  /// kể cả sau khi cấu hình mặc định đổi.
  concurrency Int @default(5)
  maxRetries  Int @default(3) @map("max_retries")

  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Thời lượng chạy (ms) — Publish History hiển thị trực tiếp, không tự trừ hai mốc.
  durationMs Int?      @map("duration_ms")
  /// Lỗi làm cả lượt chết (vd template bị xoá giữa chừng).
  lastError  String?   @map("last_error") @db.VarChar(2000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  session         PodListingSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listingTemplate PodListingTemplate? @relation(fields: [listingTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  imageTemplate   PodImageTemplate?   @relation(fields: [imageTemplateId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items PodListingJobItem[]
  logs  PodListingLog[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([sessionId, createdAt])
  @@map("pod_listing_jobs")
}

// ---------------------------------------------------------------------------
// PodListingJobItem — MỘT (sản phẩm × shop) trong lượt chạy.
//
// `draft_listing_id` trỏ sang bản draft đã giải (nội dung listing), `remote_product_id` là
// id sản phẩm phía TikTok. Hai thứ khác nhau và đều cần: cái trước để xem hệ thống ĐÃ GỬI
// gì, cái sau để mở sản phẩm trên Seller Center.
// ---------------------------------------------------------------------------

model PodListingJobItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  jobId          String @map("job_id") @db.Uuid

  /// 🔴 Item có ĐÚNG MỘT nguồn: sản phẩm đã đồng bộ, hoặc Draft Product của Listing Session.
  /// Cả hai cùng NULL (hoặc cùng có) là dữ liệu hỏng — ràng buộc CHECK ở migration.
  productId         String? @map("product_id") @db.Uuid
  sessionProductId  String? @map("session_product_id") @db.Uuid
  shopId            String  @map("shop_id") @db.Uuid
  /// NULL khi nguồn là Listing Session (session không bắt buộc có Listing Template gộp).
  listingTemplateId String? @map("listing_template_id") @db.Uuid
  /// Payload đã giải (nội dung gửi lên sàn). NULL khi chết trước bước Merge.
  payloadId         String? @map("payload_id") @db.Uuid

  status PodListingJobItemStatus @default(PENDING)

  /// `product_id` do TikTok trả về cho Draft Product vừa tạo.
  remoteProductId String? @map("remote_product_id") @db.VarChar(64)
  /// Thông điệp lỗi gần nhất (đã kèm mã lỗi TikTok nếu có).
  error           String? @db.VarChar(2000)
  /// Mã lỗi TikTok của lần thất bại gần nhất — lọc/thống kê theo mã, không parse chuỗi.
  errorCode       String? @map("error_code") @db.VarChar(64)

  /// Số lần ĐÃ THỬ LẠI (không tính lần chạy đầu).
  retryCount    Int       @default(0) @map("retry_count")
  /// Mốc được phép chạy lại — exponential backoff ghi vào đây.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  job             PodListingJob             @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product         PodProduct?               @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sessionProduct  PodListingSessionProduct? @relation(fields: [sessionProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  shop            PodTiktokShop             @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  listingTemplate PodListingTemplate?       @relation(fields: [listingTemplateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payload         PodListingPayload?        @relation(fields: [payloadId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  logs PodListingLog[]

  /// Mỗi nguồn chỉ xuất hiện MỘT lần cho mỗi shop trong cùng lượt chạy.
  @@unique([jobId, productId, shopId])
  @@unique([jobId, sessionProductId, shopId])
  @@index([organizationId, status])
  @@index([jobId, status])
  @@index([status, nextAttemptAt])
  @@map("pod_listing_job_items")
}

// ---------------------------------------------------------------------------
// PodListingLog — nhật ký TỪNG BƯỚC của từng item.
//
// `payload` giữ mảnh dữ liệu gọn của bước (số ảnh đã upload, mã lỗi TikTok, request_id) —
// KHÔNG chép cả payload listing vào đây: nội dung đã gửi nằm ở `pod_draft_listings.payload`,
// nhân bản nó hàng nghìn lần chỉ làm bảng log phình ra vô ích.
// ---------------------------------------------------------------------------

model PodListingLog {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  jobId          String  @map("job_id") @db.Uuid
  /// NULL cho log mức JOB (bắt đầu lượt, huỷ lượt).
  listingItemId  String? @map("listing_item_id") @db.Uuid

  level   PodListingLogLevel @default(INFO)
  step    PodListingStep
  message String             @db.VarChar(2000)
  payload Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job  PodListingJob      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  item PodListingJobItem? @relation(fields: [listingItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId])
  @@index([jobId, createdAt])
  @@index([listingItemId, createdAt])
  @@map("pod_listing_logs")
}
