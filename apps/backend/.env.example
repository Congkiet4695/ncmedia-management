# ============================================================================
# NCMedia Management Platform — Environment (example)
# Sao chép thành `.env` và điền giá trị thật. KHÔNG commit `.env`.
# File này được dùng bởi CẢ ứng dụng (dotenv) LẪN docker-compose (interpolation).
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
# Prefix API (Mục 12 CLAUDE.md): /api/v1
API_PREFIX=api/v1
# CORS: danh sách origin cho phép, ngăn cách bởi dấu phẩy (hoặc * cho dev)
CORS_ORIGIN=*

# --- Logger ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- PostgreSQL (dùng bởi docker-compose để tạo DB) ---
POSTGRES_USER=ncmedia
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ncmedia
POSTGRES_PORT=5432

# --- DATABASE_URL (dùng bởi Prisma khi chạy app trên host) ---
# Khi chạy trong docker-compose, service `api` tự dựng URL từ POSTGRES_* ở trên.
DATABASE_URL=postgresql://ncmedia:change-me-postgres-password@localhost:5432/ncmedia?schema=public

# --- Redis (Cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth / Security (chưa implement Auth — chỉ khai báo cho hạ tầng) ---
# JWT HS256 (ADR-006/021). KHÔNG hardcode secret ở nơi khác.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Khóa HMAC-SHA256 để hash refresh token trước khi lưu DB (ADR-006 rev)
REFRESH_TOKEN_HMAC_SECRET=change-me-hmac-secret

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@ncmedia.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password
PGADMIN_PORT=5050

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Module POD — TikTok Shop (docs/pod-tiktok/**) ---
# Lấy tại: Partner Center → App & Service → (chọn app) → Basic Information
TIKTOK_APP_KEY=your-tiktok-app-key
TIKTOK_APP_SECRET=your-tiktok-app-secret
TIKTOK_SERVICE_ID=your-tiktok-service-id
# Domain chính thức — chỉ đổi khi TikTok thay đổi (Methods and endpoints)
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_AUTHORIZE_BASE_URL_US=https://services.us.tiktokshop.com
TIKTOK_AUTHORIZE_BASE_URL_ROW=https://services.tiktokshop.com
# Thị trường mặc định: US | ROW  (NCMedia = US)
TIKTOK_DEFAULT_REGION=US
# Goc URL chuyen huong sau khi TikTok goi /api/v1/tiktok/callback.
# De TRONG => chuyen huong tuong doi /tiktok/link-success (frontend va backend cung domain).
# Chi dat gia tri khi frontend nam o domain khac.
TIKTOK_CALLBACK_REDIRECT_BASE=
# Khoá AES-256-GCM RIÊNG cho token TikTok (base64 của ĐÚNG 32 byte) — key separation.
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TIKTOK_ENCRYPTION_KEY=replace-with-base64-32-bytes
TIKTOK_HTTP_TIMEOUT_MS=15000
TIKTOK_MAX_RETRY=3

# --- Dong bo don hang TikTok (Sprint 2) ---
# Bat/tat scheduler. De false o may dev de khong tu goi TikTok.
TIKTOK_SYNC_ENABLED=false
# Cron 5 truong — mac dinh moi 5 phut
TIKTOK_SYNC_CRON=*/5 * * * *
# Quet lui them de bu canh bao "update_time may exceed the selected search range"
TIKTOK_SYNC_OVERLAP_SECONDS=300
# Khong doc sat thoi diem hien tai (du lieu chua on dinh)
TIKTOK_SYNC_LAG_SECONDS=60
# page_size hop le theo tai lieu Get Order List: 1..100
TIKTOK_SYNC_PAGE_SIZE=100
TIKTOK_SYNC_MAX_PAGES_PER_RUN=50
TIKTOK_SYNC_MAX_CONCURRENCY=4
TIKTOK_SYNC_MAX_WINDOW_SECONDS=86400
# Khoang lich su keo lan dau khi shop chua tung sync (30 ngay)
# Luoi an toan cho pha INCREMENTAL khi mat watermark (30 ngay).
# KHONG phai pham vi keo lich su — lich su do pha BACKFILL dam nhiem.
TIKTOK_SYNC_INITIAL_LOOKBACK_SECONDS=2592000
# --- Pha BACKFILL: keo TOAN BO lich su don theo create_time ---
TIKTOK_SYNC_BACKFILL_ENABLED=true
# 0 = toan bo lich su shop (khuyen nghi). >0 = chi keo lui ngan nay ngay.
TIKTOK_SYNC_BACKFILL_FROM_DAYS=0
# So trang toi da moi luot backfill (100 don/trang). Luot sau tiep tuc tu cursor.
TIKTOK_SYNC_BACKFILL_MAX_PAGES=200
# Deadline mot luot cron (ms) — phai NHO HON chu ky cron
TIKTOK_SYNC_RUN_DEADLINE_MS=240000
TIKTOK_SYNC_FAILURE_THRESHOLD=5
# Refresh access token truoc khi het han (giay) — mac dinh 24h
TIKTOK_TOKEN_REFRESH_BEFORE_SECONDS=86400

# --- Dong bo Payout (Finance API) ---
TIKTOK_PAYOUT_SYNC_ENABLED=true
# So ngay quet lai moi luot (trang thai chi tra con chuyen tiep PROCESSING -> PAID)
TIKTOK_PAYOUT_WINDOW_DAYS=90
TIKTOK_PAYOUT_MAX_PAGES=100
# So statement duoc keo giao dich cap don moi luot
TIKTOK_PAYOUT_STATEMENTS_PER_RUN=50

# --- Module Fulfillment: gui don sang xuong in (MangoTeePrints) ---
# MANGO_API_KEY la nguon cau hinh CHINH cho header X-API-Key. KHONG hardcode trong source.
# Tai khoan trong DB (fulfillment_accounts.api_key_enc) chi dung khi can nhieu tai khoan
# Mango khac nhau; khai bao o do thi key cua tai khoan duoc uu tien hon bien nay.
FULFILLMENT_WEBHOOK_BASE_URL=https://api.ncmedia.vn
MANGO_API_KEY=
MANGO_API_BASE_URL=https://v3.mangoteeprints.com/api/public/v1
MANGO_HTTP_TIMEOUT_MS=30000
FULFILLMENT_SYNC_ENABLED=true
FULFILLMENT_SYNC_CRON=*/5 * * * *
FULFILLMENT_SYNC_BATCH_SIZE=100
FULFILLMENT_SYNC_DEADLINE_MS=240000
FULFILLMENT_WEBHOOK_MAX_ATTEMPTS=5
FULFILLMENT_WEBHOOK_RETRY_BATCH=50

# --- Storage Module (core) — moi file cua he thong deu di qua module nay ---
# Nha cung cap dang dung: CLOUDFLARE_R2 (production) | LOCAL_DISK (dev/test)
STORAGE_PROVIDER=CLOUDFLARE_R2
# Gioi han dung luong MOT file (byte) — 104857600 = 100MB. Phai KHOP client_max_body_size (nginx).
STORAGE_MAX_FILE_BYTES=104857600
# Timeout goi kho luu tru (ms) — 120s, du cho file 100MB tren duong truyen cham.
STORAGE_TIMEOUT_MS=120000

# Cloudflare R2 — BAT BUOC khi STORAGE_PROVIDER=CLOUDFLARE_R2.
# Lay tai Cloudflare Dashboard > R2 > Manage R2 API Tokens.
# KHONG commit gia tri that vao git.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# URL doc cong khai cua bucket (R2 Public Bucket hoac custom domain).
# De trong => bucket private, file chi tai duoc qua GET /api/v1/storage/{id}/download.
R2_PUBLIC_URL=

# Luu tru dia cuc bo — CHI dung khi STORAGE_PROVIDER=LOCAL_DISK.
# Chay Docker PHAI mount volume de khong mat file khi deploy.
UPLOAD_ROOT=./uploads
UPLOAD_URL_PREFIX=/uploads
# De trong => URL tra ve la duong dan tuong doi (FE tu ghep voi API base URL).
# Dat gia tri khi backend co domain rieng, vd https://api.ncmedia.vn
UPLOAD_PUBLIC_BASE_URL=

# Mui gio quy doi preset loc thoi gian (phut). 420 = UTC+7 (gio Viet Nam)
APP_TIMEZONE_OFFSET_MINUTES=420
