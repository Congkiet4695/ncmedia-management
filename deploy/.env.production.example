# ============================================================================
# NCMedia Management Platform — PRODUCTION env (copy → .env.production, điền secret THẬT)
# KHÔNG commit .env.production. Sinh secret bằng lệnh gợi ý bên dưới.
#
#   openssl rand -hex 32          # JWT / HMAC secret
#   openssl rand -base64 32       # ACCOUNT_ENCRYPTION_KEY / TIKTOK_ENCRYPTION_KEY (đúng 32 byte)
#   openssl rand -base64 24       # mật khẩu DB/Redis
#
# ── FILE NÀY LÀ NGUỒN DUY NHẤT ──────────────────────────────────────────────
# Toàn bộ biến ở đây được nạp thẳng vào container backend qua `env_file:`.
# Thêm biến môi trường mới ⇒ chỉ cần:
#   1. thêm một dòng vào .env.production
#   2. thêm luật vào apps/backend/src/config/env.validation.ts (nếu cần)
#   3. deploy
# KHÔNG phải sửa docker-compose.production.yml. Xem docs/deployment-env.md.
#
# Quy tắc định dạng (Docker đọc NGUYÊN VĂN, không phải shell):
#   - KHÔNG có khoảng trắng quanh dấu `=`.
#   - KHÔNG bọc nháy trừ khi ký tự nháy thuộc về chính giá trị.
#   - Giá trị chứa `#` phải bọc nháy kép, nếu không phần sau `#` bị coi là chú thích.
#   - File phải dùng xuống dòng LF. Soạn trên Windows xong chạy: sed -i 's/\r$//' .env.production
#
# Bốn biến sau CỐ TÌNH bị docker-compose ghi đè (topology mạng Docker), đặt ở đây
# KHÔNG có tác dụng: DATABASE_URL, REDIS_HOST, REDIS_PORT, NODE_ENV/PORT/API_PREFIX.
# ============================================================================

# ---- Domain (server_name / cert / Cloudflare) ----
DOMAIN=your-domain.com

# ---- PostgreSQL (compose ghép thành DATABASE_URL) ----
POSTGRES_USER=ncmedia
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ncmedia

# ---- Redis (host/port do compose đặt = redis:6379) ----
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ---- JWT / Auth secrets (BẮT BUỘC) ----
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32
REFRESH_TOKEN_HMAC_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Account secret encryption (AES-256-GCM) — base64 của ĐÚNG 32 byte (BẮT BUỘC) ----
ACCOUNT_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# ---- Backend runtime ----
CORS_ORIGIN=https://your-domain.com
LOG_LEVEL=info
# Production nên tắt Swagger. Bật = true nếu cần điều tra.
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
# Múi giờ quy đổi preset lọc thời gian (phút). 420 = UTC+7.
APP_TIMEZONE_OFFSET_MINUTES=420

# ============================================================================
# Storage Module — nơi lưu file upload (design, ảnh CCCD, QR…)
# ============================================================================
# CLOUDFLARE_R2 (khuyến nghị production) hoặc LOCAL_DISK.
STORAGE_PROVIDER=CLOUDFLARE_R2
# 104857600 = 100 * 1024 * 1024 (100MB). Phải KHỚP client_max_body_size trong nginx.conf.
STORAGE_MAX_FILE_BYTES=104857600
# 120s — đủ cho file 100MB trên đường truyền chậm.
STORAGE_TIMEOUT_MS=120000

# --- Cloudflare R2 — BẮT BUỘC khi STORAGE_PROVIDER=CLOUDFLARE_R2 ---
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_BUCKET=ncmedia
# Trống = bucket private (file tải qua API thay vì URL công khai).
R2_PUBLIC_URL=

# --- LOCAL_DISK (chỉ dùng khi STORAGE_PROVIDER=LOCAL_DISK) ---
# /app/uploads là bind mount tới ${NCMEDIA_UPLOADS} trên host, Nginx serve tại /uploads.
UPLOAD_ROOT=/app/uploads
UPLOAD_URL_PREFIX=/uploads
UPLOAD_PUBLIC_BASE_URL=

# ============================================================================
# Module POD — TikTok Shop (docs/pod-tiktok/**)
# app_key / app_secret / service_id: Partner Center → App & Service → Basic Information
# ============================================================================
TIKTOK_APP_KEY=CHANGE_ME
TIKTOK_APP_SECRET=CHANGE_ME
TIKTOK_SERVICE_ID=CHANGE_ME
# Khoá mã hoá RIÊNG cho token TikTok (AES-256-GCM). Base64 của ĐÚNG 32 byte.
# KHÔNG dùng lại ACCOUNT_ENCRYPTION_KEY — tách khoá để lộ một cái không mất cái kia.
TIKTOK_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
TIKTOK_DEFAULT_REGION=US
# Gốc URL frontend (KHÔNG kèm path) để chuyển hướng sau callback — backend tự nối
# /tiktok/link-success hoặc /tiktok/link-failed. Trống = tương đối (Nginx phục vụ FE+BE cùng domain).
TIKTOK_CALLBACK_REDIRECT_BASE=
# Hạn dùng tham số `state` của luồng uỷ quyền (giây) và thời gian giữ bản ghi để tra cứu (giờ).
TIKTOK_OAUTH_STATE_TTL_SECONDS=900
TIKTOK_OAUTH_STATE_RETENTION_HOURS=72
TIKTOK_HTTP_TIMEOUT_MS=15000
TIKTOK_MAX_RETRY=3

# --- Đồng bộ đơn hàng (scheduler) ---
TIKTOK_SYNC_ENABLED=true
TIKTOK_SYNC_CRON=*/5 * * * *
TIKTOK_SYNC_PAGE_SIZE=100
TIKTOK_SYNC_MAX_PAGES_PER_RUN=50
TIKTOK_SYNC_MAX_CONCURRENCY=4
# Pha BACKFILL — kéo lịch sử theo create_time. 0 ngày = toàn bộ lịch sử shop.
TIKTOK_SYNC_BACKFILL_ENABLED=true
TIKTOK_SYNC_BACKFILL_FROM_DAYS=0
TIKTOK_SYNC_BACKFILL_MAX_PAGES=200

# --- Đồng bộ Payout (Finance API) ---
TIKTOK_PAYOUT_SYNC_ENABLED=true
TIKTOK_PAYOUT_WINDOW_DAYS=90

# ============================================================================
# Module Fulfillment — xưởng in (MangoTeePrints)
# ============================================================================
# Base URL công khai của hệ thống, dùng dựng URL webhook cho nhà cung cấp.
FULFILLMENT_WEBHOOK_BASE_URL=https://your-domain.com
# API key MangoTeePrints (header X-API-Key) — nguồn cấu hình CHÍNH, không hardcode trong source.
# Tài khoản trong DB chỉ cần khai key riêng khi dùng nhiều tài khoản Mango khác nhau.
MANGO_API_KEY=CHANGE_ME
MANGO_API_BASE_URL=https://v3.mangoteeprints.com/api/public/v1
FULFILLMENT_SYNC_ENABLED=true
FULFILLMENT_SYNC_CRON=*/5 * * * *
FULFILLMENT_SYNC_BATCH_SIZE=100

# --- Đồng bộ danh mục nhà cung cấp (Catalogue → Product → Variant) ---
# Kéo danh mục về Database để màn hình Product Mapping KHÔNG phải gọi nhà cung cấp lúc mở.
# Thưa hơn hẳn FULFILLMENT_SYNC_CRON: danh mục xưởng in gần như tĩnh, còn một lượt đồng bộ là
# hàng nghìn lời gọi API (tự giới hạn 10 request/giây theo quy định của nhà cung cấp).
FULFILLMENT_CATALOG_SYNC_ENABLED=true
FULFILLMENT_CATALOG_SYNC_CRON=0 */6 * * *

# ============================================================================
# Frontend — inline lúc BUILD (Next.js). Same-origin qua Nginx → /api/v1 (khuyến nghị).
# Có thể đặt URL tuyệt đối: https://your-domain.com/api/v1
# ============================================================================
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=NCMedia Management Platform

# ============================================================================
# Seed — production KHÔNG tạo Demo Organization/Admin.
# ============================================================================
SEED_DEMO=false

# ============================================================================
# (Tuỳ chọn) Override host bind-mount path. Mặc định = /opt/ncmedia/... (PRODUCTION).
# Chỉ đổi khi verify ở môi trường khác (vd Windows/WSL). Bỏ trống = dùng mặc định.
# ============================================================================
# NCMEDIA_POSTGRES_DATA=/opt/ncmedia/data/postgres
# NCMEDIA_REDIS_DATA=/opt/ncmedia/data/redis
# NCMEDIA_UPLOADS=/opt/ncmedia/uploads
# NCMEDIA_LOGS=/opt/ncmedia/logs
# NCMEDIA_CERTS=/opt/ncmedia/certs
